[Icon Theme]
Name=Arcanum
Inherits=Adwaita,hicolor

Example=x-directory-normal


Directories=apps/scalable,categories/scalable,devices/scalable,places/scalable,places/symbolic,mimetypes/scalable,status/scalable


[apps/scalable]
Size=128
Context=Applications
Type=Scalable
MinSize=16
MaxSize=512

[categories/scalable]
Context=Categories
Size=16
MinSize=16
MaxSize=512
Type=Scalable

[devices/scalable]
Size=128
Context=Actions
Type=Scalable
MinSize=22
MaxSize=128

[places/scalable]
Context=Places
Size=64
MinSize=22
MaxSize=512
Type=Scalable

[places/symbolic]
Context=Places
Size=16
MinSize=16
MaxSize=512
Type=Scalable

[mimetypes/scalable]
Size=512
Context=MimeTypes
Type=Scalable
MinSize=16
MaxSize=512


[status/scalable]
Context=Status
Size=64
MinSize=8
MaxSize=512
Type=Scalable

