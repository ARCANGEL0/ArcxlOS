[Icon Theme]
Name=Commonality Sol
Comment=Remembering Solaris

Example=folder
Inherits=breeze

# KDE Specific Stuff
DisplayDepth=32
LinkOverlay=link_overlay
LockOverlay=lock_overlay
ZipOverlay=zip_overlay
DesktopDefault=48
DesktopSizes=16,22,32,48,64,72,96,128
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16
PanelDefault=22
PanelSizes=16,22,32,48,64,72,96,128

# Directory list
Directories=actions/22,actions/48,scalable/apps,scalable/devices,scalable/emblems,mimetypes/64,places/22,places/48,scalable/status,scalable/categories


[scalable/actions]
Context=Actions
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[actions/22]
Size=22
Context=Actions
Type=Fixed

[actions/48]
Size=48
Context=Actions
Type=Scalable
MinSize=48
MaxSize=256

