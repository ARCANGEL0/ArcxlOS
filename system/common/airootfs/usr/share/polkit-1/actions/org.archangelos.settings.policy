<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ArchangelOS</vendor>

  <action id="org.archangelos.ghostwired">
    <description>Turn GhostWired on or off and change its settings</description>
    <message>Authentication is required to change how this computer connects through Tor</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/archangelos/ghostwired</annotate>
  </action>

  <action id="org.archangelos.power">
    <description>Change the power mode</description>
    <message>Authentication is required to change the power mode</message>
    <icon_name>battery</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/archangelos/power-mode</annotate>
  </action>

  <action id="org.archangelos.settings.admin">
    <description>Change system settings</description>
    <message>Authentication is required to change system settings</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/archangelos/axs-admin</annotate>
  </action>
</policyconfig>
