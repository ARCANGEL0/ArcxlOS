{
    // arcfetch — ArchangelOS image logo + system info
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Real pixel logo (PNG) rendered with chafa (fallback: kitty/sixel where supported)
    "logo": {
        "type": "chafa",
        "source": "/usr/share/archangelos/logo.png",
        "width": 46,
        "padding": {
            "right": 4,
            "top": 1
        }
    },
    "display": {
        "separator": " : ",
        "color": {
            "keys": "cyan",
            "values": "white",
            "title": "red",
            "titleLength": 0
        }
    },
    "modules": [
        { "type": "title", "key": " ", "colorLength": 0 },
        { "type": "separator", "key": "─", "color": { "key": "cyan" } },
        { "type": "os", "key": "OS" },
        { "type": "host", "key": "HOST" },
        { "type": "kernel", "key": "KERNEL" },
        { "type": "uptime", "key": "UPTIME" },
        { "type": "initSystem", "key": "INIT" },
        { "type": "packages", "key": "PACKAGES" },
        { "type": "processes", "key": "PROCESSES" },
        { "type": "locale", "key": "LOCALE" },
        { "type": "display", "key": "DISPLAY", "showRefreshRate": true },
        { "type": "shell", "key": "SHELL" },
        { "type": "terminal", "key": "TERM" },
        { "type": "wm", "key": "WM" },
        { "type": "localIp", "key": "LOCAL IP" },
        { "type": "battery", "key": "BATTERY" },
        { "type": "sound", "key": "AUDIO" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "MEMORY" },
        { "type": "disk", "key": "DISK" },
        { "type": "break", "key": "", "text": "" },
        { "type": "colors", "symbol": "crosblock" }
    ]
}