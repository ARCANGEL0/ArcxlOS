#!/usr/bin/env python3
# axs-diag — the measuring half of Settings > Diagnostics. Runs as the person (no root); every
# verb prints JSON. The root-only readings (SMART, memtester, DMI tables) are axs-admin verbs.
#
#   watch [SECONDS]           one JSON line per tick: CPU, memory, disk and network I/O,
#                             temperatures, fans, GPU, battery, busiest processes
#   hw                        what this computer is made of
#   ping HOST [COUNT]         latency, jitter and loss
#   dns                       how fast each resolver answers
#   speed [MB]                download / upload throughput (speed.cloudflare.com)
#   disk DIR [MB]             sequential write/read and random 4K reads in DIR
#   cpu                       single and all-core hashing throughput
#   mem                       memory copy bandwidth
import glob
import hashlib
import json
import mmap
import os
import re
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.request


def out(o):
    sys.stdout.write(json.dumps(o, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def rd(p, default=""):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return default


def num(p, default=None):
    try:
        return float(rd(p))
    except ValueError:
        return default


def run(argv, timeout=10):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


# ---- live sampling ----------------------------------------------------------------------------

def cpu_times():
    rows = {}
    for l in rd("/proc/stat").splitlines():
        if l.startswith("cpu"):
            f = l.split()
            v = list(map(int, f[1:9]))
            idle = v[3] + v[4]
            rows[f[0]] = (sum(v), idle)
    return rows


def disk_stats():
    d = {}
    for l in rd("/proc/diskstats").splitlines():
        f = l.split()
        if len(f) < 14:
            continue
        name = f[2]
        if re.match(r"^(loop|ram|zram|sr|dm-|md)", name) or not os.path.exists("/sys/block/" + name):
            continue
        d[name] = (int(f[5]) * 512, int(f[9]) * 512, int(f[3]), int(f[7]), int(f[12]))
    return d


def net_stats():
    n = {}
    for l in rd("/proc/net/dev").splitlines()[2:]:
        name, rest = l.split(":", 1)
        name = name.strip()
        if name == "lo":
            continue
        f = rest.split()
        n[name] = (int(f[0]), int(f[8]))
    return n


def proc_times():
    t = {}
    for p in glob.glob("/proc/[0-9]*/stat"):
        try:
            with open(p) as f:
                s = f.read()
            i = s.rindex(")")
            name = s[s.index("(") + 1:i]
            f2 = s[i + 2:].split()
            t[int(p.split("/")[2])] = (name, int(f2[11]) + int(f2[12]), int(f2[21]) * os.sysconf("SC_PAGE_SIZE"))
        except (OSError, ValueError, IndexError):
            pass
    return t


def meminfo():
    m = {}
    for l in rd("/proc/meminfo").splitlines():
        k, v = l.split(":", 1)
        m[k] = int(v.split()[0]) * 1024
    used = m.get("MemTotal", 0) - m.get("MemAvailable", 0)
    return {"total": m.get("MemTotal", 0), "used": used, "avail": m.get("MemAvailable", 0),
            "cached": m.get("Cached", 0) + m.get("SReclaimable", 0), "buffers": m.get("Buffers", 0),
            "swapTotal": m.get("SwapTotal", 0), "swapUsed": m.get("SwapTotal", 0) - m.get("SwapFree", 0),
            "dirty": m.get("Dirty", 0), "shmem": m.get("Shmem", 0)}


def sensors():
    temps, fans, power = [], [], []
    for h in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        chip = rd(h + "/name") or os.path.basename(h)
        for t in sorted(glob.glob(h + "/temp*_input")):
            v = num(t)
            if v is None:
                continue
            base = t[:-6]
            temps.append({"chip": chip, "label": rd(base + "_label") or chip, "c": round(v / 1000, 1),
                          "crit": (num(base + "_crit") or num(base + "_max") or 0) / 1000})
        for f in sorted(glob.glob(h + "/fan*_input")):
            v = num(f)
            if v is None:
                continue
            base = f[:-6]
            fans.append({"chip": chip, "label": rd(base + "_label") or ("Fan " + re.sub(r"\D", "", os.path.basename(f))),
                         "rpm": int(v), "max": int(num(base + "_max") or 0)})
        for p in glob.glob(h + "/power*_average") + glob.glob(h + "/power*_input"):
            v = num(p)
            if v:
                power.append({"chip": chip, "w": round(v / 1e6, 1)})
    if not temps:
        for z in sorted(glob.glob("/sys/class/thermal/thermal_zone*")):
            v = num(z + "/temp")
            if v is not None:
                temps.append({"chip": rd(z + "/type"), "label": rd(z + "/type"), "c": round(v / 1000, 1), "crit": 0})
    return temps, fans, power


def gpus():
    g = []
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]")):
        dev = card + "/device"
        drv = os.path.basename(os.path.realpath(dev + "/driver")) if os.path.exists(dev + "/driver") else ""
        if drv == "nvidia":
            continue
        busy = num(dev + "/gpu_busy_percent")
        vu, vt = num(dev + "/mem_info_vram_used"), num(dev + "/mem_info_vram_total")
        freq = None
        for l in rd(dev + "/pp_dpm_sclk").splitlines():
            if l.endswith("*"):
                freq = l.split()[1]
        if freq is None and os.path.exists(card + "/gt_cur_freq_mhz"):
            freq = rd(card + "/gt_cur_freq_mhz") + "MHz"
        g.append({"card": os.path.basename(card), "driver": drv, "busy": busy, "vramUsed": vu, "vramTotal": vt, "freq": freq})
    if run(["sh", "-c", "command -v nvidia-smi"], 2):
        q = run(["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw,clocks.gr,fan.speed",
                 "--format=csv,noheader,nounits"], 4)
        for l in q.strip().splitlines():
            f = [x.strip() for x in l.split(",")]
            fl = lambda s: float(s) if re.match(r"^[\d.]+$", s or "") else None
            if len(f) >= 8:
                g.append({"card": f[0], "driver": "nvidia", "busy": fl(f[1]), "vramUsed": (fl(f[2]) or 0) * 1048576,
                          "vramTotal": (fl(f[3]) or 0) * 1048576, "temp": fl(f[4]), "power": fl(f[5]), "freq": f[6] + "MHz", "fan": fl(f[7])})
    return g


def battery():
    for b in glob.glob("/sys/class/power_supply/BAT*"):
        p = num(b + "/power_now")
        if p is None:
            c, v = num(b + "/current_now"), num(b + "/voltage_now")
            p = c * v / 1e6 if c and v else None
        return {"status": rd(b + "/status"), "pct": num(b + "/capacity"), "w": round(p / 1e6, 1) if p else None}
    return None


def watch(interval):
    hz = os.sysconf("SC_CLK_TCK")
    ncpu = os.cpu_count() or 1
    c0, d0, n0, p0, t0 = cpu_times(), disk_stats(), net_stats(), proc_times(), time.monotonic()
    while True:
        time.sleep(interval)
        c1, d1, n1, p1, t1 = cpu_times(), disk_stats(), net_stats(), proc_times(), time.monotonic()
        dt = max(1e-3, t1 - t0)

        def pct(k):
            if k not in c0 or k not in c1:
                return 0
            tot, idle = c1[k][0] - c0[k][0], c1[k][1] - c0[k][1]
            return round(100 * (1 - idle / tot), 1) if tot > 0 else 0

        cores = sorted([k for k in c1 if k != "cpu"], key=lambda k: int(k[3:]))
        freqs = [num("/sys/devices/system/cpu/%s/cpufreq/scaling_cur_freq" % k) for k in cores]
        disks = []
        for k, v in d1.items():
            if k in d0:
                o = d0[k]
                disks.append({"dev": k, "r": (v[0] - o[0]) / dt, "w": (v[1] - o[1]) / dt, "riops": (v[2] - o[2]) / dt,
                              "wiops": (v[3] - o[3]) / dt, "busy": min(100, round((v[4] - o[4]) / (dt * 10), 1)),
                              "readTotal": v[0], "writeTotal": v[1]})
        nets = []
        for k, v in n1.items():
            if k in n0:
                nets.append({"dev": k, "rx": (v[0] - n0[k][0]) / dt, "tx": (v[1] - n0[k][1]) / dt, "rxTotal": v[0], "txTotal": v[1],
                             "up": rd("/sys/class/net/%s/operstate" % k) == "up"})
        procs = []
        for pid, (name, ticks, rss) in p1.items():
            if pid in p0:
                procs.append({"pid": pid, "name": name, "cpu": round(100 * (ticks - p0[pid][1]) / hz / dt / ncpu, 1), "rss": rss})
        top = sorted(procs, key=lambda p: -p["cpu"])[:6]
        topMem = sorted(procs, key=lambda p: -p["rss"])[:6]
        temps, fans, power = sensors()
        la = rd("/proc/loadavg").split()
        out({"t": time.time(), "cpu": pct("cpu"), "cores": [pct(k) for k in cores],
             "freq": [round(f / 1000) if f else None for f in freqs], "load": la[:3], "procs": int(la[3].split("/")[1]) if len(la) > 3 else 0,
             "uptime": float(rd("/proc/uptime").split()[0]),
             "mem": meminfo(), "disks": disks, "net": nets, "temps": temps, "fans": fans, "power": power,
             "gpus": gpus(), "battery": battery(), "top": top, "topMem": topMem})
        c0, d0, n0, p0, t0 = c1, d1, n1, p1, t1


# ---- hardware ----------------------------------------------------------------------------------

def hw():
    info = {}
    try:
        lc = json.loads(run(["lscpu", "-J"]) or "{}").get("lscpu", [])
        cpu = {re.sub(r":$", "", e["field"]): e.get("data") for e in lc}
    except ValueError:
        cpu = {}
    flags = (cpu.get("Flags") or "").split()
    info["cpu"] = {"model": cpu.get("Model name", ""), "vendor": cpu.get("Vendor ID", ""), "arch": cpu.get("Architecture", ""),
                   "threads": os.cpu_count(), "cores": cpu.get("Core(s) per socket"), "sockets": cpu.get("Socket(s)"),
                   "maxMhz": cpu.get("CPU max MHz"), "minMhz": cpu.get("CPU min MHz"),
                   "l1d": cpu.get("L1d cache"), "l2": cpu.get("L2 cache"), "l3": cpu.get("L3 cache"),
                   "virt": cpu.get("Virtualization", ""), "governor": rd("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"),
                   "driver": rd("/sys/devices/system/cpu/cpu0/cpufreq/scaling_driver"),
                   "features": [f for f in ["avx", "avx2", "avx512f", "aes", "sha_ni", "vmx", "svm", "rdrand"] if f in flags],
                   "vulns": [{"name": os.path.basename(v), "state": rd(v)} for v in sorted(glob.glob("/sys/devices/system/cpu/vulnerabilities/*"))]}
    dmi = lambda k: rd("/sys/class/dmi/id/" + k)
    info["system"] = {"vendor": dmi("sys_vendor"), "product": dmi("product_name"), "version": dmi("product_version"),
                      "board": (dmi("board_vendor") + " " + dmi("board_name")).strip(), "bios": dmi("bios_version"),
                      "biosDate": dmi("bios_date"), "chassis": dmi("chassis_type"),
                      "firmware": "UEFI" if os.path.isdir("/sys/firmware/efi") else "BIOS",
                      "kernel": os.uname().release, "host": socket.gethostname(),
                      "os": (re.search(r'^PRETTY_NAME="?([^"\n]*)', rd("/etc/os-release"), re.M) or [None, ""])[1],
                      "virt": run(["systemd-detect-virt"]).strip()}
    m = meminfo()
    info["memory"] = {"total": m["total"], "swap": m["swapTotal"],
                      "zram": sum(int(rd(z + "/disksize") or 0) for z in glob.glob("/sys/block/zram*"))}
    vga = []
    for blk in run(["lspci", "-vmmk"]).split("\n\n"):
        d = dict(l.split(":\t", 1) for l in blk.splitlines() if ":\t" in l)
        if re.search(r"VGA|3D|Display", d.get("Class", "")):
            vga.append({"name": d.get("Vendor", "") + " " + d.get("Device", ""), "driver": d.get("Driver", ""), "slot": d.get("Slot", "")})
    info["gpus"] = vga
    try:
        bl = json.loads(run(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,MODEL,SIZE,ROTA,TRAN,TYPE,SERIAL,REV"]) or "{}").get("blockdevices", [])
    except ValueError:
        bl = []
    info["disks"] = [d for d in bl if d.get("type") == "disk" and not re.match(r"^(loop|zram|sr)", d.get("name", ""))]
    for d in info["disks"]:
        d["sched"] = (re.search(r"\[(\w[\w-]*)\]", rd("/sys/block/%s/queue/scheduler" % d["name"])) or [None, ""])[1]
    nics = []
    for n in sorted(glob.glob("/sys/class/net/*")):
        name = os.path.basename(n)
        if name == "lo" or not os.path.exists(n + "/device"):
            continue
        sp = rd(n + "/speed")
        nics.append({"dev": name, "mac": rd(n + "/address"), "driver": os.path.basename(os.path.realpath(n + "/device/driver")),
                     "speed": int(sp) if sp.lstrip("-").isdigit() and int(sp) > 0 else None, "state": rd(n + "/operstate"),
                     "wireless": os.path.isdir(n + "/wireless"), "mtu": rd(n + "/mtu")})
    info["nics"] = nics
    usb = []
    for l in run(["lsusb"]).splitlines():
        mm = re.match(r"Bus (\d+) Device (\d+): ID (\S+) (.*)", l)
        if mm and "root hub" not in mm.group(4):
            usb.append({"id": mm.group(3), "name": mm.group(4)})
    info["usb"] = usb
    bats = []
    for b in glob.glob("/sys/class/power_supply/BAT*"):
        full = num(b + "/energy_full") or num(b + "/charge_full")
        design = num(b + "/energy_full_design") or num(b + "/charge_full_design")
        bats.append({"name": os.path.basename(b), "model": rd(b + "/model_name"), "maker": rd(b + "/manufacturer"),
                     "tech": rd(b + "/technology"), "cycles": rd(b + "/cycle_count"),
                     "health": round(100 * full / design, 1) if full and design else None})
    info["batteries"] = bats
    info["displays"] = [{"name": os.path.basename(c).split("-", 1)[1], "status": rd(c + "/status")}
                        for c in sorted(glob.glob("/sys/class/drm/card*-*")) if rd(c + "/status") == "connected"]
    info["audio"] = [l.split(":", 1)[1].strip() for l in rd("/proc/asound/cards").splitlines() if "]:" in l]
    return info


# ---- network -----------------------------------------------------------------------------------

def gateway():
    for l in rd("/proc/net/route").splitlines()[1:]:
        f = l.split()
        if f[1] == "00000000" and int(f[3], 16) & 2:
            return socket.inet_ntoa(struct.pack("<L", int(f[2], 16)))
    return ""


def ping(host, count):
    if host == "gateway":
        host = gateway()
        if not host:
            return {"error": "No default gateway — not connected?"}
    try:
        p = subprocess.run(["ping", "-n", "-c", str(count), "-i", "0.2", "-W", "2", host], capture_output=True, text=True, timeout=count + 8)
        o = p.stdout
    except (OSError, subprocess.SubprocessError) as e:
        return {"host": host, "error": str(e)}
    times = [float(x) for x in re.findall(r"time=([\d.]+)", o)]
    loss = re.search(r"([\d.]+)% packet loss", o)
    if not loss:
        return {"host": host, "error": (p.stderr.strip().splitlines() or ["ping didn't run"])[-1]}
    jit = sum(abs(times[i] - times[i - 1]) for i in range(1, len(times))) / (len(times) - 1) if len(times) > 1 else 0
    return {"host": host, "sent": count, "got": len(times), "loss": float(loss.group(1)) if loss else 100.0,
            "min": min(times) if times else None, "avg": sum(times) / len(times) if times else None,
            "max": max(times) if times else None, "jitter": round(jit, 2), "times": times}


def dns_query(server, name, timeout=2.0):
    qid = int.from_bytes(os.urandom(2), "big")
    q = struct.pack(">HHHHHH", qid, 0x0100, 1, 0, 0, 0)
    q += b"".join(bytes([len(p)]) + p.encode() for p in name.split(".")) + b"\0" + struct.pack(">HH", 1, 1)
    fam = socket.AF_INET6 if ":" in server else socket.AF_INET
    s = socket.socket(fam, socket.SOCK_DGRAM)
    s.settimeout(timeout)
    try:
        t = time.perf_counter()
        s.sendto(q, (server, 53))
        while True:
            r, _ = s.recvfrom(4096)
            if len(r) >= 12 and struct.unpack(">H", r[:2])[0] == qid:
                break
        ms = (time.perf_counter() - t) * 1000
        rc = r[3] & 0xF
        return {"ms": round(ms, 1), "ok": rc == 0, "rcode": rc, "answers": struct.unpack(">H", r[6:8])[0]}
    except OSError as e:
        return {"ms": None, "ok": False, "error": str(e)}
    finally:
        s.close()


def dns():
    system = [l.split()[1] for l in rd("/etc/resolv.conf").splitlines() if l.startswith("nameserver") and len(l.split()) > 1]
    servers = [{"name": "System (" + s + ")", "ip": s} for s in system[:2]] + [
        {"name": "Cloudflare", "ip": "1.1.1.1"}, {"name": "Google", "ip": "8.8.8.8"},
        {"name": "Quad9", "ip": "9.9.9.9"}, {"name": "AdGuard", "ip": "94.140.14.14"}, {"name": "Mullvad", "ip": "194.242.2.2"}]
    names = ["archlinux.org", "wikipedia.org", "github.com", "cloudflare.com"]
    res = []
    for sv in servers:
        rs = [dns_query(sv["ip"], n) for n in names]
        ok = [r["ms"] for r in rs if r["ok"] and r["ms"] is not None]
        res.append({"name": sv["name"], "ip": sv["ip"], "avg": round(sum(ok) / len(ok), 1) if ok else None,
                    "best": min(ok) if ok else None, "failed": len(rs) - len(ok)})
    t = time.perf_counter()
    try:
        socket.getaddrinfo("archlinux.org", 443)
        lib = round((time.perf_counter() - t) * 1000, 1)
    except OSError:
        lib = None
    return {"servers": res, "resolver": lib, "system": system}


def speed(mb):
    res = {}
    host = "https://speed.cloudflare.com"
    try:
        t = time.perf_counter()
        urllib.request.urlopen(host + "/__down?bytes=0", timeout=8).read()
        res["latency"] = round((time.perf_counter() - t) * 1000, 1)
        trace = urllib.request.urlopen(host + "/cdn-cgi/trace", timeout=8).read().decode(errors="replace")
        kv = dict(l.split("=", 1) for l in trace.splitlines() if "=" in l)
        res.update({"ip": kv.get("ip", ""), "loc": kv.get("loc", ""), "colo": kv.get("colo", "")})
        size, got, t = mb * 1_000_000, 0, time.perf_counter()
        with urllib.request.urlopen(host + "/__down?bytes=%d" % size, timeout=20) as r:
            while time.perf_counter() - t < 15:
                b = r.read(262144)
                if not b:
                    break
                got += len(b)
        res["down"] = round(got * 8 / (time.perf_counter() - t) / 1e6, 1)
        up = os.urandom(min(size, 10_000_000) // 2) * 2
        t = time.perf_counter()
        urllib.request.urlopen(urllib.request.Request(host + "/__up", data=up, method="POST"), timeout=30).read()
        res["up"] = round(len(up) * 8 / (time.perf_counter() - t) / 1e6, 1)
    except Exception as e:  # noqa: BLE001 - any network failure is a result here
        res["error"] = str(e)
    return res


# ---- benchmarks --------------------------------------------------------------------------------

def disk(path, mb):
    path = os.path.expanduser(path)
    f = os.path.join(path, ".axs-diskbench.%d" % os.getpid())
    chunk = 4 << 20
    buf = mmap.mmap(-1, chunk)
    buf.write(os.urandom(chunk))
    res = {"dir": path, "mb": mb}
    try:
        st = os.statvfs(path)
        if st.f_bavail * st.f_frsize < (mb + 256) << 20:
            return {"error": "Not enough free space in " + path}
        direct = True
        try:
            fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_DIRECT, 0o600)
        except OSError:
            direct = False
            fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        t = time.perf_counter()
        for _ in range(mb * (1 << 20) // chunk):
            os.write(fd, buf)
        os.fsync(fd)
        res["write"] = round(mb / (time.perf_counter() - t), 1)
        os.close(fd)
        res["direct"] = direct
        if not direct:
            try:
                os.posix_fadvise(os.open(f, os.O_RDONLY), 0, 0, os.POSIX_FADV_DONTNEED)
            except OSError:
                pass
        fd = os.open(f, os.O_RDONLY | (os.O_DIRECT if direct else 0))
        t = time.perf_counter()
        while os.readv(fd, [buf]) > 0:
            pass
        res["read"] = round(mb / (time.perf_counter() - t), 1)
        small = mmap.mmap(-1, 4096)
        import random
        blocks, n, t = mb * 256, 0, time.perf_counter()
        while time.perf_counter() - t < 3:
            os.lseek(fd, random.randrange(blocks) * 4096, 0)
            os.readv(fd, [small])
            n += 1
        res["iops"] = round(n / (time.perf_counter() - t))
        res["lat"] = round(1000 * (time.perf_counter() - t) / max(1, n), 3)
        os.close(fd)
    except OSError as e:
        res["error"] = str(e)
    finally:
        try:
            os.unlink(f)
        except OSError:
            pass
    return res


def cpu():
    data = os.urandom(1 << 20) * 64
    def hash_for(secs, counter, i):
        n, t = 0, time.perf_counter()
        while time.perf_counter() - t < secs:
            hashlib.sha256(data).digest()
            n += len(data)
        counter[i] = n / (time.perf_counter() - t)
    one = [0]
    hash_for(3, one, 0)
    k = os.cpu_count() or 1
    many = [0] * k
    th = [threading.Thread(target=hash_for, args=(4, many, i)) for i in range(k)]
    for x in th:
        x.start()
    for x in th:
        x.join()
    s, m = one[0] / 1e6, sum(many) / 1e6
    return {"single": round(s), "multi": round(m), "threads": k, "scaling": round(m / s, 2) if s else None}


def mem():
    size = 256 << 20
    a, b = bytearray(size), bytearray(size)
    ma, mb_ = memoryview(a), memoryview(b)
    t, n = time.perf_counter(), 0
    while time.perf_counter() - t < 3:
        mb_[:] = ma
        n += 1
    # a copy reads one buffer and writes the other: bytes moved is twice the size
    return {"copy": round(n * size / (time.perf_counter() - t) / 1e9, 2), "moved": round(2 * n * size / (time.perf_counter() - t) / 1e9, 2)}


def main():
    a = sys.argv[1:] or ["hw"]
    v = a[0]
    if v == "watch":
        try:
            watch(float(a[1]) if len(a) > 1 else 1.5)
        except (BrokenPipeError, KeyboardInterrupt):
            pass
        return
    if v == "hw":
        out(hw())
    elif v == "ping":
        out(ping(a[1] if len(a) > 1 else "1.1.1.1", int(a[2]) if len(a) > 2 else 10))
    elif v == "dns":
        out(dns())
    elif v == "speed":
        out(speed(int(a[1]) if len(a) > 1 else 25))
    elif v == "disk":
        out(disk(a[1] if len(a) > 1 else "~", int(a[2]) if len(a) > 2 else 256))
    elif v == "cpu":
        out(cpu())
    elif v == "mem":
        out(mem())
    else:
        out({"error": "unknown verb " + v})
        sys.exit(2)


if __name__ == "__main__":
    main()
