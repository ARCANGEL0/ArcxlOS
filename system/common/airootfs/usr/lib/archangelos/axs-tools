#!/usr/bin/env python3
# axs-tools — lists the applications installed on this machine, grouped into categories, for
# Settings > Tool rack (Fallen). It only reads the .desktop files already on disk and prints
# them as JSON; it installs nothing and runs nothing. The grouping mirrors the desktop wheel.
import json
import os
import re
import sys

DESKTOP_DIRS = [
    "/usr/share/applications/blackarch",
    os.path.expanduser("~/.local/share/applications"),
    "/usr/share/applications",
]

# (pattern over "Categories + Name", friendly group). First match wins.
CATEGORY_RULES = [
    (r"blackarch-wireless|wireless|wifi|aircrack", "Wireless"),
    (r"blackarch-bluetooth|bluetooth", "Bluetooth & RF"),
    (r"blackarch-forensic|forensic", "Forensics"),
    (r"blackarch-defensive|defensive|antivirus|blue.?team|monitoring", "Blue Team & Defense"),
    (r"blackarch-webapp|webapp|web.?application", "Web Applications"),
    (r"blackarch-cracker|cracker|password", "Passwords"),
    (r"blackarch-recon|blackarch-fingerprint|recon|osint|fingerprint", "Information Gathering"),
    (r"blackarch-scanner|blackarch-vulnerability|scanner|vulnerability", "Vulnerability Analysis"),
    (r"blackarch-exploitation|exploit", "Exploitation"),
    (r"blackarch-sniffer|blackarch-spoof|sniff|spoof|mitm", "Sniffing & Spoofing"),
    (r"blackarch-reversing|blackarch-disassembler|blackarch-decompiler|reverse|disassembl|decompil|debugger", "Reverse Engineering"),
    (r"blackarch-proxy|blackarch-tunnel|proxy|tunnel|anon|tor\b|vpn", "Anonymity"),
    (r"blackarch-social|social.?engineer", "Social Engineering"),
    (r"blackarch-database|database|\bsql\b", "Databases"),
    (r"blackarch-malware|malware", "Malware Analysis"),
    (r"blackarch-voip|voip", "VoIP"),
    (r"blackarch-mobile|mobile|android", "Mobile"),
    (r"blackarch-nfc|blackarch-drone|blackarch-hardware|blackarch-firmware|nfc|drone|hardware|rfid|radio", "Hardware & RF"),
    (r"blackarch-crypto|crypto|cipher|stego", "Cryptography"),
    (r"blackarch-automation|blackarch-misc|blackarch-packer|blackarch-keylogger|blackarch-honeypot", "Utilities"),
]


def parse_desktop(path):
    name = exec_cmd = categories = comment = icon = ""
    terminal = False
    nodisplay = False
    try:
        with open(path, encoding="utf-8", errors="ignore") as f:
            in_main = False
            for line in f:
                line = line.strip()
                if line.startswith("[") and line.endswith("]"):
                    in_main = (line == "[Desktop Entry]")
                    continue
                if not in_main or "=" not in line or line.startswith("#"):
                    continue
                key, _, value = line.partition("=")
                if key == "Name" and not name:
                    name = value
                elif key == "Exec" and not exec_cmd:
                    exec_cmd = value
                elif key == "Categories":
                    categories = value
                elif key == "Comment" and not comment:
                    comment = value
                elif key == "Icon" and not icon:
                    icon = value
                elif key == "Terminal":
                    terminal = value.strip().lower() == "true"
                elif key == "NoDisplay":
                    nodisplay = value.strip().lower() == "true"
    except OSError:
        return None
    if not name or not exec_cmd or nodisplay:
        return None
    if os.path.basename(path).startswith("archangelos-"):
        return None
    for tok in (" %F", " %f", " %U", " %u", " %D", " %d", " %N", " %n", " %i", " %c", " %k", " %m", " %v"):
        exec_cmd = exec_cmd.replace(tok, "")
    return {"name": name, "exec": exec_cmd.strip(), "categories": categories,
            "comment": comment, "icon": icon, "terminal": terminal}


def categorize(entry):
    hay = entry["categories"] + " " + entry["name"]
    for pattern, group in CATEGORY_RULES:
        if re.search(pattern, hay, re.IGNORECASE):
            return group
    # anything that is plainly a security category but matched nothing specific
    if re.search(r"blackarch|security|pentest|exploit", hay, re.IGNORECASE):
        return "Utilities"
    return None  # ordinary desktop app — not part of the tool rack


def main():
    only_security = "--all" not in sys.argv[1:]
    catalog = {}
    seen = set()
    for d in DESKTOP_DIRS:
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".desktop"):
                continue
            entry = parse_desktop(os.path.join(d, fn))
            if entry is None:
                continue
            key = entry["name"].lower()
            if key in seen:
                continue
            group = categorize(entry)
            if group is None and only_security:
                continue
            seen.add(key)
            catalog.setdefault(group or "Utilities", []).append(
                {"name": entry["name"], "exec": entry["exec"],
                 "comment": entry["comment"], "icon": entry["icon"], "terminal": entry["terminal"]})
    order = [g for _, g in CATEGORY_RULES]
    out = []
    for group in sorted(catalog, key=lambda g: order.index(g) if g in order else 99):
        tools = sorted(catalog[group], key=lambda t: t["name"].lower())
        out.append({"group": group, "tools": tools})
    json.dump({"categories": out, "total": sum(len(c["tools"]) for c in out)},
              sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
