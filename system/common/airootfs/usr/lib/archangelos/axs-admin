#!/bin/bash
# axs-admin — the root half of ArchangelOS Settings. Each verb does one checked thing; Settings
# runs it through pkexec, so the person is asked for their password (kept for a few minutes).
#
#   user-add NAME FULLNAME ADMIN      password on stdin
#   user-passwd NAME                  password on stdin
#   user-delete NAME KEEPHOME
#   user-admin NAME 0|1
#   user-fullname NAME FULLNAME
#   user-avatar NAME FILE             picture for the login screen (AccountsService)
#   pkg-remove PKG...
#   pkg-clean-cache | pkg-orphans | journal-vacuum | clean-coredumps | clean-varlog
#   locale-set LANG [FORMATS]
#   mac-random 0|1
#   mirrors-refresh | keyring-refresh | initramfs | db-check
#   pacnew FILE keep|use               settle a .pacnew/.pacsave next to FILE
#   diag-smart                         SMART data of every disk, one JSON object per line
#   diag-smart-test DEV short|long     start a drive self-test
#   diag-memtest MB LOOPS              memtester, last lines of its report
#   diag-dmi                           memory modules, board and BIOS (dmidecode)
#   boot-get                           bootloader kind, timeout, default, kernel params
#   boot-timeout SECS                  menu wait (GRUB or systemd-boot)
#   boot-default ENTRY                 default entry (GRUB saved, or sd-boot id)
#   boot-quiet 0|1                     quiet+splash on the kernel command line
#   kernel-install PKG | kernel-remove PKG   linux / linux-lts / linux-zen / linux-hardened
#   splash-get | splash-set THEME      Plymouth boot theme
#   login-get | login-autologin USER|"" | login-numlock 0|1   SDDM
#   gpu-mode integrated|hybrid|nvidia  switchable graphics (envycontrol)
#   shell-set USER SHELL
#   svc NAME 0|1 (libvirtd/docker/…) | group-add USER GROUP | vm NAME start|shutdown|stop
#   printer-scan | printer-add NAME URI PPD | printer-remove NAME | printer-default NAME | printer-enable NAME 0|1
set -u
SELF=/usr/lib/archangelos/axs-admin

die() { echo "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || exec pkexec "$SELF" "$@"

# Who asked: pkexec sets PKEXEC_UID.
caller="$(getent passwd "${PKEXEC_UID:-0}" | cut -d: -f1)"

user_ok()  { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "That isn't a valid user name."; }
human()    { local u; u="$(getent passwd "$1")" || die "No such user: $1"
             local uid; uid="$(echo "$u" | cut -d: -f3)"
             [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || die "$1 is a system account."; }
full_ok()  { [[ "$1" != *[:,=$'\n']* ]] && [ "${#1}" -le 64 ] || die "Names can't contain : , or =."; }
read_pw()  { IFS= read -r pw || true; [ "${#pw}" -ge 1 ] || die "The password is empty."; }
admins()   { getent group wheel | cut -d: -f4 | tr ',' '\n' | grep -c .; }

verb="${1:-}"; shift || true
case "$verb" in
    user-add)
        [ $# -eq 3 ] || die "usage: user-add NAME FULLNAME ADMIN"
        user_ok "$1"; full_ok "$2"
        getent passwd "$1" >/dev/null && die "There is already a user called $1."
        read_pw
        groups="audio,video,input,storage,network"
        [ "$3" = 1 ] && groups="$groups,wheel"
        # Only groups that exist; useradd refuses the whole call otherwise.
        groups="$(echo "$groups" | tr ',' '\n' | while read -r g; do getent group "$g" >/dev/null && echo "$g"; done | paste -sd,)"
        useradd -m -c "$2" -G "$groups" -s "$(getent passwd "$caller" | cut -d: -f7 | grep . || echo /bin/bash)" "$1" \
            || die "Couldn't create $1."
        printf '%s:%s\n' "$1" "$pw" | chpasswd || { userdel -r "$1" 2>/dev/null; die "Couldn't set the password."; }
        echo ok ;;
    user-passwd)
        [ $# -eq 1 ] || die "usage: user-passwd NAME"
        user_ok "$1"; human "$1"; read_pw
        printf '%s:%s\n' "$1" "$pw" | chpasswd || die "Couldn't change the password."
        echo ok ;;
    user-delete)
        [ $# -eq 2 ] || die "usage: user-delete NAME KEEPHOME"
        user_ok "$1"; human "$1"
        [ "$1" = "$caller" ] && die "You can't remove the account you're signed in with."
        loginctl list-users --no-legend 2>/dev/null | awk '{print $2}' | grep -qx "$1" && die "$1 is signed in right now."
        if getent group wheel | cut -d: -f4 | tr ',' '\n' | grep -qx "$1" && [ "$(admins)" -le 1 ]; then
            die "$1 is the only administrator."
        fi
        if [ "$2" = 1 ]; then userdel "$1"; else userdel -r "$1" 2>/dev/null || userdel "$1"; fi || die "Couldn't remove $1."
        rm -f "/var/lib/AccountsService/icons/$1" "/var/lib/AccountsService/users/$1"
        echo ok ;;
    user-admin)
        [ $# -eq 2 ] || die "usage: user-admin NAME 0|1"
        user_ok "$1"; human "$1"
        if [ "$2" = 1 ]; then gpasswd -a "$1" wheel >/dev/null || die "Couldn't make $1 an administrator."
        else
            [ "$1" = "$caller" ] && die "You can't remove your own administrator rights here."
            [ "$(admins)" -le 1 ] && die "There has to be at least one administrator."
            gpasswd -d "$1" wheel >/dev/null || die "Couldn't change $1."
        fi
        echo ok ;;
    user-fullname)
        [ $# -eq 2 ] || die "usage: user-fullname NAME FULLNAME"
        user_ok "$1"; human "$1"; full_ok "$2"
        usermod -c "$2" "$1" || die "Couldn't rename $1."
        echo ok ;;
    user-avatar)
        [ $# -eq 2 ] || die "usage: user-avatar NAME FILE"
        user_ok "$1"; human "$1"
        [ -f "$2" ] && [ "$(stat -c %s "$2")" -le 10485760 ] || die "Pick an image under 10 MB."
        file -b --mime-type "$2" | grep -q '^image/' || die "That file isn't an image."
        install -d -m 755 /var/lib/AccountsService/icons /var/lib/AccountsService/users
        install -m 644 "$2" "/var/lib/AccountsService/icons/$1"
        f="/var/lib/AccountsService/users/$1"
        [ -f "$f" ] || printf '[User]\n' > "$f"
        if grep -q '^Icon=' "$f"; then sed -i "s|^Icon=.*|Icon=/var/lib/AccountsService/icons/$1|" "$f"
        else echo "Icon=/var/lib/AccountsService/icons/$1" >> "$f"; fi
        echo ok ;;
    pkg-remove)
        [ $# -ge 1 ] || die "usage: pkg-remove PKG..."
        for p in "$@"; do
            [[ "$p" =~ ^[a-z0-9@._+-]+$ ]] || die "Bad package name: $p"
            case "$p" in
                base|linux|linux-lts|linux-zen|linux-firmware|systemd|pacman|glibc|bash|sudo|hyprland|quickshell|networkmanager|archangelos-*)
                    die "$p is part of ArchangelOS itself and can't be removed here." ;;
            esac
        done
        pacman -Rns --noconfirm "$@" 2>&1 | tail -n 20
        exit "${PIPESTATUS[0]}" ;;
    pkg-clean-cache)
        if command -v paccache >/dev/null; then paccache -rk1 && paccache -ruk0
        else yes | pacman -Sc >/dev/null; fi
        echo ok ;;
    pkg-orphans)
        o="$(pacman -Qdtq 2>/dev/null)"
        [ -z "$o" ] && { echo none; exit 0; }
        # shellcheck disable=SC2086
        pacman -Rns --noconfirm $o 2>&1 | tail -n 5
        exit "${PIPESTATUS[0]}" ;;
    clean-coredumps)
        # crash memory snapshots kept by systemd-coredump; safe to drop
        n=0
        if [ -d /var/lib/systemd/coredump ]; then
            n=$(find /var/lib/systemd/coredump -type f 2>/dev/null | wc -l)
            find /var/lib/systemd/coredump -type f -delete 2>/dev/null || true
        fi
        command -v journalctl >/dev/null && journalctl --rotate >/dev/null 2>&1
        echo "ok $n" ;;
    clean-varlog)
        # rotated / compressed logs only — never the live ones
        find /var/log -type f \( -name "*.gz" -o -name "*.xz" -o -name "*.old" -o -name "*.[0-9]" -o -name "*.[0-9].log" \) -delete 2>/dev/null || true
        journalctl --vacuum-size=64M >/dev/null 2>&1 || true
        echo ok ;;
    journal-vacuum)
        journalctl --vacuum-size=64M >/dev/null 2>&1 && echo ok ;;
    locale-set)
        [ $# -ge 1 ] || die "usage: locale-set LANG [FORMATS]"
        main="$1"; fmt="${2:-$1}"
        for l in "$main" "$fmt"; do
            [[ "$l" =~ ^[A-Za-z_]+(\.UTF-8)?(@[a-z]+)?$ ]] || die "Bad locale: $l"
            grep -q "^$l UTF-8" /usr/share/i18n/SUPPORTED || die "$l isn't a supported locale."
            # Uncomment (or add) it in locale.gen.
            if grep -q "^#\s*$l UTF-8" /etc/locale.gen; then sed -i "s|^#\s*\($l UTF-8\)|\1|" /etc/locale.gen
            elif ! grep -q "^$l UTF-8" /etc/locale.gen; then echo "$l UTF-8" >> /etc/locale.gen; fi
        done
        locale-gen >/dev/null || die "locale-gen failed."
        if [ "$fmt" = "$main" ]; then localectl set-locale "LANG=$main"
        else
            localectl set-locale "LANG=$main" "LC_TIME=$fmt" "LC_NUMERIC=$fmt" "LC_MONETARY=$fmt" \
                "LC_MEASUREMENT=$fmt" "LC_PAPER=$fmt"
        fi || die "Couldn't set the locale."
        echo ok ;;
    mac-random)
        f=/etc/NetworkManager/conf.d/90-archangelos-mac.conf
        if [ "${1:-}" = 1 ]; then
            install -d /etc/NetworkManager/conf.d
            printf '%s\n' "# Written by ArchangelOS Settings > GhostWired." \
                "[device]" "wifi.scan-rand-mac-address=yes" "" \
                "[connection]" "wifi.cloned-mac-address=random" "ethernet.cloned-mac-address=random" > "$f"
        else
            rm -f "$f"
        fi
        systemctl reload NetworkManager 2>/dev/null || nmcli general reload 2>/dev/null
        echo ok ;;
    mirrors-refresh)
        command -v reflector >/dev/null || die "reflector isn't installed."
        cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
        reflector --latest 20 --protocol https --sort rate --age 24 --save /etc/pacman.d/mirrorlist 2>&1 | tail -n 3
        [ "${PIPESTATUS[0]}" -eq 0 ] || { cp -f /etc/pacman.d/mirrorlist.bak /etc/pacman.d/mirrorlist; die "reflector failed; kept the old list."; }
        echo "ok $(grep -c '^Server' /etc/pacman.d/mirrorlist)" ;;
    keyring-refresh)
        pacman-key --init >/dev/null 2>&1
        pacman-key --populate archlinux >/dev/null 2>&1 || die "Couldn't load the Arch keyring."
        echo ok ;;
    initramfs)
        command -v mkinitcpio >/dev/null || die "mkinitcpio isn't installed."
        mkinitcpio -P 2>&1 | grep -E "==> (ERROR|WARNING|Image generation successful)" | tail -n 8
        exit "${PIPESTATUS[0]}" ;;
    db-check)
        pacman -Dk 2>&1 | tail -n 20 ;;
    pacnew)
        f="${1:-}"; how="${2:-}"
        [[ "$f" == /etc/* && "$f" != *..* ]] || die "Only files under /etc."
        new=""; for x in "$f.pacnew" "$f.pacsave"; do [ -e "$x" ] && new="$x"; done
        [ -n "$new" ] || die "Nothing to settle for $f."
        case "$how" in
            keep) rm -f -- "$new" ;;
            use)  cp -a -- "$f" "$f.axs-old" 2>/dev/null; mv -f -- "$new" "$f" ;;
            *) die "keep or use" ;;
        esac
        echo ok ;;
    diag-smart)
        command -v smartctl >/dev/null || { echo '{"missing":true}'; exit 0; }
        smartctl --scan-open -j 2>/dev/null | python3 -c '
import json, subprocess, sys
for d in json.load(sys.stdin).get("devices", []):
    o = subprocess.run(["smartctl", "-a", "-j", "-d", d.get("type", "auto"), d["name"]], capture_output=True, text=True).stdout
    try: print(json.dumps(json.loads(o), separators=(",", ":")))
    except ValueError: pass' ;;
    diag-smart-test)
        dev="${1:-}"; kind="${2:-short}"
        [[ "$dev" =~ ^/dev/(sd[a-z]+|nvme[0-9]+(n[0-9]+)?|hd[a-z]+|vd[a-z]+)$ ]] || die "Bad device: $dev"
        [[ "$kind" =~ ^(short|long)$ ]] || die "short or long"
        smartctl -t "$kind" "$dev" 2>&1 | grep -iE "test will complete|please wait|testing has begun|not supported|error" | head -n 3 ;;
    diag-memtest)
        command -v memtester >/dev/null || die "memtester isn't installed."
        mb="${1:-256}"; loops="${2:-1}"
        [[ "$mb" =~ ^[0-9]+$ && "$mb" -ge 16 && "$mb" -le 65536 ]] || die "Bad size."
        [[ "$loops" =~ ^[1-9]$ ]] || die "Bad loop count."
        avail=$(( $(awk '/MemAvailable/ {print $2}' /proc/meminfo) / 1024 ))
        [ "$mb" -lt $(( avail - 512 )) ] || die "Only ${avail} MB free — close some apps or test less."
        memtester "${mb}M" "$loops" 2>&1 | tr '\r\b' '\n\n' | grep -E ":|Loop|Done|FAILURE|ok" | grep -v '^\s*$' | sed 's/  */ /g' | tail -n 40
        exit "${PIPESTATUS[0]}" ;;
    diag-dmi)
        command -v dmidecode >/dev/null || die "dmidecode isn't installed."
        dmidecode -t 16,17 2>/dev/null | awk -F': ' '
            /^Memory Device/ { if (n) print row; row=""; n=1 }
            /^\t(Size|Type|Speed|Configured Memory Speed|Manufacturer|Part Number|Locator|Form Factor|Rank):/ { gsub(/^\t/, "", $1); row = row $1 "=" $2 "|" }
            /^\tMaximum Capacity:/ { print "max=" $2 } /^\tNumber Of Devices:/ { print "slots=" $2 }
            END { if (n) print row }' | sed 's/^/dimm=/; s/^dimm=max=/max=/; s/^dimm=slots=/slots=/' ;;
    # ---- boot ------------------------------------------------------------------------------
    boot-get)
        if [ -d /sys/firmware/efi ] && [ -f /boot/loader/loader.conf ] && command -v bootctl >/dev/null; then
            echo "kind=systemd-boot"
            echo "timeout=$(sed -n 's/^timeout\s*\([0-9]*\).*/\1/p' /boot/loader/loader.conf | head -n1)"
            echo "default=$(sed -n 's/^default\s*\(.*\)/\1/p' /boot/loader/loader.conf | head -n1)"
            for e in /boot/loader/entries/*.conf; do [ -e "$e" ] || continue
                echo "entry=$(basename "$e" .conf)|$(sed -n 's/^title\s*\(.*\)/\1/p' "$e" | head -n1)"; done
        elif [ -f /etc/default/grub ]; then
            echo "kind=grub"
            echo "timeout=$(sed -n 's/^GRUB_TIMEOUT=\([0-9]*\).*/\1/p' /etc/default/grub | head -n1)"
            echo "default=$(sed -n 's/^GRUB_DEFAULT=\(.*\)/\1/p' /etc/default/grub | tr -d '"' | head -n1)"
            if [ -f /boot/grub/grub.cfg ]; then
                grep -E "^\s*menuentry " /boot/grub/grub.cfg | sed -E "s/^\s*menuentry ['\"]([^'\"]*)['\"].*/entry=\1/" | head -n 20
            fi
        else echo "kind=unknown"; fi
        echo "cmdline=$(cat /proc/cmdline)"
        echo "running=$(uname -r)"
        for k in linux linux-lts linux-zen linux-hardened; do
            pacman -Q "$k" >/dev/null 2>&1 && echo "kernel=$k|$(pacman -Q "$k" | awk '{print $2}')|installed" || echo "kernel=$k||available"
        done ;;
    boot-timeout)
        [[ "${1:-}" =~ ^[0-9]{1,3}$ ]] || die "Give a number of seconds."
        if [ -f /boot/loader/loader.conf ] && command -v bootctl >/dev/null && [ -d /sys/firmware/efi ] && grep -q timeout /boot/loader/loader.conf 2>/dev/null; then
            sed -i "/^timeout/d" /boot/loader/loader.conf; echo "timeout $1" >> /boot/loader/loader.conf
        elif [ -f /etc/default/grub ]; then
            sed -i "s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=$1/" /etc/default/grub
            command -v grub-mkconfig >/dev/null && grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
        else die "No bootloader configuration found."; fi
        echo ok ;;
    boot-default)
        [ $# -ge 1 ] || die "usage: boot-default ENTRY"
        if [ -f /boot/loader/loader.conf ] && [ -d /sys/firmware/efi ]; then
            [[ "$1" =~ ^[A-Za-z0-9._@+-]+$ ]] || die "Bad entry id."
            sed -i "/^default/d" /boot/loader/loader.conf; echo "default $1" >> /boot/loader/loader.conf
        elif [ -f /etc/default/grub ]; then
            sed -i "s/^GRUB_DEFAULT=.*/GRUB_DEFAULT=\"$(printf '%s' "$1" | sed 's/[\/&\"]/\\&/g')\"/" /etc/default/grub
            grep -q "^GRUB_SAVEDEFAULT" /etc/default/grub || echo "GRUB_SAVEDEFAULT=false" >> /etc/default/grub
            command -v grub-mkconfig >/dev/null && grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
        else die "No bootloader configuration found."; fi
        echo ok ;;
    boot-quiet)
        want="${1:-1}"
        if [ -f /etc/default/grub ]; then
            cur="$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/\1/p' /etc/default/grub | head -n1)"
            cur="$(echo "$cur" | sed -E 's/\b(quiet|splash|loglevel=[0-9]+)\b//g; s/  */ /g; s/^ //; s/ $//')"
            [ "$want" = 1 ] && cur="loglevel=3 quiet splash${cur:+ $cur}"
            sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT=\"$(printf '%s' "$cur" | sed 's/[\/&]/\\&/g')\"/" /etc/default/grub
            command -v grub-mkconfig >/dev/null && grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
        elif ls /boot/loader/entries/*.conf >/dev/null 2>&1; then
            for e in /boot/loader/entries/*.conf; do
                opts="$(sed -n 's/^options\s*\(.*\)/\1/p' "$e" | sed -E 's/\b(quiet|splash|loglevel=[0-9]+)\b//g; s/  */ /g; s/ $//')"
                [ "$want" = 1 ] && opts="$opts loglevel=3 quiet splash"
                sed -i "/^options/d" "$e"; echo "options $(echo "$opts" | sed 's/  */ /g; s/^ //')" >> "$e"
            done
        else die "No bootloader configuration found."; fi
        echo ok ;;
    kernel-install|kernel-remove)
        k="${1:-}"
        case "$k" in linux|linux-lts|linux-zen|linux-hardened) ;; *) die "Only the standard kernels." ;; esac
        hdr="$k-headers"
        if [ "$verb" = kernel-install ]; then
            pacman -S --noconfirm --needed "$k" "$hdr" 2>&1 | tail -n 5
        else
            [ "$(pacman -Q linux linux-lts linux-zen linux-hardened 2>/dev/null | wc -l)" -ge 2 ] || die "This is the only kernel left — can't remove it."
            [ "$k" = "linux-$(uname -r | grep -oE 'lts|zen|hardened' || echo none)" ] 2>/dev/null
            pacman -Rns --noconfirm "$k" "$hdr" 2>&1 | tail -n 5
        fi
        rc="${PIPESTATUS[0]}"
        command -v grub-mkconfig >/dev/null && [ -f /boot/grub/grub.cfg ] && grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
        exit "$rc" ;;
    # ---- splash ----------------------------------------------------------------------------
    splash-get)
        command -v plymouth-set-default-theme >/dev/null || { echo "installed=0"; exit 0; }
        echo "installed=1"; echo "current=$(plymouth-set-default-theme 2>/dev/null)"
        plymouth-set-default-theme -l 2>/dev/null | sed 's/^/theme=/' ;;
    splash-set)
        command -v plymouth-set-default-theme >/dev/null || die "Plymouth isn't installed."
        [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || die "Bad theme name."
        plymouth-set-default-theme -R "$1" 2>&1 | tail -n 3 || die "Couldn't set that theme."
        echo ok ;;
    # ---- login (SDDM) ----------------------------------------------------------------------
    login-get)
        d=/etc/sddm.conf.d/10-archangelos.conf
        echo "autologin=$(sed -n 's/^User=\(.*\)/\1/p' "$d" 2>/dev/null | head -n1)"
        echo "session=$(sed -n 's/^Session=\(.*\)/\1/p' "$d" 2>/dev/null | head -n1)"
        echo "numlock=$(sed -n 's/^Numlock=\(.*\)/\1/p' /etc/sddm.conf.d/*.conf 2>/dev/null | head -n1)" ;;
    login-autologin)
        d=/etc/sddm.conf.d/10-archangelos.conf; mkdir -p /etc/sddm.conf.d
        [ -f "$d" ] || printf '[Theme]\nCurrent=archangelos\n' > "$d"
        sed -i '/^\[Autologin\]/,/^\[/{/^User=/d; /^Session=/d}' "$d"
        sed -i '/^\[Autologin\]$/d' "$d"
        if [ -n "${1:-}" ]; then
            user_ok "$1"; human "$1"
            sess="$(ls /usr/share/wayland-sessions/*.desktop 2>/dev/null | grep -iE 'hypr|archangel' | head -n1)"
            sess="$(basename "${sess:-hyprland.desktop}")"
            printf '\n[Autologin]\nUser=%s\nSession=%s\n' "$1" "$sess" >> "$d"
        fi
        echo ok ;;
    login-numlock)
        d=/etc/sddm.conf.d/20-numlock.conf
        if [ "${1:-0}" = 1 ]; then printf '[General]\nNumlock=on\n' > "$d"; else rm -f "$d"; fi
        echo ok ;;
    # ---- switchable graphics ---------------------------------------------------------------
    gpu-mode)
        command -v envycontrol >/dev/null || die "envycontrol isn't installed."
        case "${1:-}" in integrated|hybrid|nvidia) ;; *) die "integrated, hybrid or nvidia." ;; esac
        envycontrol -s "$1" --no-confirm 2>&1 | tail -n 4 || die "envycontrol failed."
        echo ok ;;
    # ---- printers (CUPS) -------------------------------------------------------------------
    printer-add)
        command -v lpadmin >/dev/null || die "CUPS isn't installed."
        [ $# -ge 2 ] || die "usage: printer-add NAME URI [PPD]"
        [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "Printer names: letters, numbers, _ and - only."
        systemctl is-active cups >/dev/null 2>&1 || systemctl start cups 2>/dev/null
        if [ -n "${3:-}" ] && [ "$3" != "-" ]; then lpadmin -p "$1" -E -v "$2" -m "$3"
        else lpadmin -p "$1" -E -v "$2" -m everywhere; fi
        [ $? -eq 0 ] || die "Couldn't add the printer."
        cupsenable "$1" 2>/dev/null; cupsaccept "$1" 2>/dev/null
        echo ok ;;
    shell-set)
        user_ok "${1:-}"; human "$1"
        sh="${2:-}"; grep -qxF "$sh" /etc/shells || die "That shell isn't in /etc/shells."
        [ -x "$sh" ] || die "That shell isn't installed."
        chsh -s "$sh" "$1" && echo ok || die "Couldn't change the shell." ;;
    svc)
        name="${1:-}"; on="${2:-}"
        case "$name" in libvirtd|docker|docker.socket|containerd|podman.socket) ;; *) die "That service can't be toggled here." ;; esac
        if [ "$on" = 1 ]; then systemctl enable --now "$name" 2>&1 | tail -n 2; else systemctl disable --now "$name" 2>&1 | tail -n 2; fi
        echo ok ;;
    group-add)
        user_ok "${1:-}"; human "$1"
        case "${2:-}" in libvirt|docker|kvm|lp|scanner|video|input|wheel|sys) ;; *) die "That group isn't managed here." ;; esac
        getent group "$2" >/dev/null || die "No such group: $2"
        gpasswd -a "$1" "$2" >/dev/null && echo "ok (log out and back in to take effect)" || die "Couldn't add to the group." ;;
    vm)
        command -v virsh >/dev/null || die "libvirt isn't installed."
        [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || die "Bad VM name."
        case "${2:-}" in
            start) virsh -c qemu:///system start "$1" 2>&1 | tail -n 2 ;;
            shutdown) virsh -c qemu:///system shutdown "$1" 2>&1 | tail -n 2 ;;
            stop) virsh -c qemu:///system destroy "$1" 2>&1 | tail -n 2 ;;
            *) die "start, shutdown or stop" ;;
        esac
        echo ok ;;
    cups-on)
        command -v cupsd >/dev/null || die "CUPS isn't installed."
        systemctl enable --now cups.socket cups.service 2>/dev/null || systemctl enable --now cups 2>/dev/null || die "Couldn't start CUPS."
        echo ok ;;
    printer-scan)
        command -v lpinfo >/dev/null || die "CUPS isn't installed."
        systemctl is-active cups >/dev/null 2>&1 || systemctl start cups 2>/dev/null
        lpinfo -v 2>/dev/null | grep -vE "^(file|https?) " ;;
    printer-remove)
        command -v lpadmin >/dev/null || die "CUPS isn't installed."
        [[ "${1:-}" =~ ^[A-Za-z0-9_-]+$ ]] || die "Bad printer name."
        lpadmin -x "$1" && echo ok || die "Couldn't remove it." ;;
    printer-default)
        [[ "${1:-}" =~ ^[A-Za-z0-9_-]+$ ]] || die "Bad printer name."
        lpadmin -d "$1" && echo ok || die "Couldn't set the default." ;;
    printer-enable)
        [[ "${1:-}" =~ ^[A-Za-z0-9_-]+$ ]] || die "Bad printer name."
        if [ "${2:-1}" = 1 ]; then cupsenable "$1" && cupsaccept "$1"; else cupsdisable "$1"; fi
        echo ok ;;
    *) die "unknown: $verb" ;;
esac
