#!/usr/bin/env python3
# axs-clean — the measuring and sweeping half of Settings > Cleaning. Runs as the person (no
# root). It only ever looks at, and removes, well-known throwaway locations — caches, trashes,
# thumbnails, crash dumps, build caches — never documents. System-owned junk (the package cache,
# orphan packages, the journal, core dumps, rotated logs) is handled by axs-admin instead.
#
#   scan                 one JSON object: every category with its size, on disk right now
#   biggest files|dirs   the heaviest files, or folders, under the home directory (JSON)
#   clean KEY...         delete the throwaway paths for these user categories (JSON result)
import json
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")


def du(path):
    """Bytes used by a file or directory tree; 0 if missing or unreadable."""
    total = 0
    if not os.path.exists(path):
        return 0
    if os.path.isfile(path):
        try:
            return os.path.getsize(path)
        except OSError:
            return 0
    for root, dirs, files in os.walk(path, onerror=lambda e: None):
        for f in files:
            fp = os.path.join(root, f)
            try:
                if not os.path.islink(fp):
                    total += os.path.getsize(fp)
            except OSError:
                pass
    return total


def globs(*patterns):
    import glob
    out = []
    for p in patterns:
        out.extend(glob.glob(os.path.expanduser(p)))
    return out


# Each category: key, label, icon, a note, and the concrete paths it owns.
def browser_caches():
    out = []
    out += globs(HOME + "/.cache/mozilla/*/*/cache2", HOME + "/.mozilla/firefox/*/cache2",
                 HOME + "/.librewolf/*/cache2", HOME + "/.cache/librewolf/*/*/cache2")
    out += globs(HOME + "/.config/*/Default/Cache", HOME + "/.config/*/Default/Code Cache",
                 HOME + "/.config/*/*/Cache", HOME + "/.cache/google-chrome/*/Cache",
                 HOME + "/.cache/chromium/*/Cache", HOME + "/.cache/BraveSoftware/*/*/Cache")
    return out


def dev_caches():
    return globs(HOME + "/.cache/pip", HOME + "/.cache/go-build", HOME + "/.npm/_cacache",
                 HOME + "/.cargo/registry/cache", HOME + "/.gradle/caches", HOME + "/.m2/repository",
                 HOME + "/.cache/yarn", HOME + "/.dotnet", HOME + "/.nuget/packages")


def app_cache_paths():
    # Everything under ~/.cache except the ones broken out into their own rows.
    keep = {os.path.realpath(HOME + "/.cache/thumbnails")}
    out = []
    base = HOME + "/.cache"
    if os.path.isdir(base):
        for name in os.listdir(base):
            p = os.path.join(base, name)
            if os.path.realpath(p) in keep:
                continue
            if name in ("pip", "go-build", "yarn", "mozilla", "librewolf", "google-chrome", "chromium", "BraveSoftware"):
                continue  # counted under browser / dev caches
            out.append(p)
    return out


CATEGORIES = [
    {"key": "appcache", "label": "Application caches", "icon": "cached",
     "note": "Rebuilt by apps as needed", "paths": app_cache_paths},
    {"key": "thumbs", "label": "Thumbnails", "icon": "photo_library",
     "note": "Previews, regenerated on demand", "paths": lambda: [HOME + "/.cache/thumbnails"]},
    {"key": "trash", "label": "Trash", "icon": "delete",
     "note": "Files you sent to the trash", "paths": lambda: globs(HOME + "/.local/share/Trash")},
    {"key": "browser", "label": "Browser caches", "icon": "public",
     "note": "Cached web pages and images", "paths": browser_caches},
    {"key": "dev", "label": "Developer caches", "icon": "code",
     "note": "pip, npm, cargo, go, gradle…", "paths": dev_caches},
    {"key": "crash", "label": "Crash reports", "icon": "bug_report",
     "note": "Saved crash traces", "paths": lambda: globs(HOME + "/.cache/*/crash", HOME + "/.local/share/apport")},
]


def scan():
    cats = []
    for c in CATEGORIES:
        paths = [p for p in c["paths"]() if os.path.exists(p)]
        size = sum(du(p) for p in paths)
        cats.append({"key": c["key"], "label": c["label"], "icon": c["icon"], "note": c["note"],
                     "scope": "user", "bytes": size, "count": len(paths)})

    # Read-only sizing of the system-owned categories (cleaned via axs-admin, not here).
    def run(argv):
        try:
            return subprocess.run(argv, capture_output=True, text=True, timeout=20).stdout
        except (OSError, subprocess.SubprocessError):
            return ""

    pkgcache = du("/var/cache/pacman/pkg")
    orphans = [x for x in run(["pacman", "-Qdtq"]).split("\n") if x.strip()]
    jdu = run(["journalctl", "--disk-usage"])
    import re
    jm = re.search(r"([\d.]+)([KMGT])", jdu)
    unit = {"K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}
    journal = int(float(jm.group(1)) * unit[jm.group(2)]) if jm else 0
    coredumps = du("/var/lib/systemd/coredump")
    sys_cats = [
        {"key": "pkgcache", "label": "Package cache", "icon": "inventory_2", "note": "Old downloaded packages (keeps the newest)", "scope": "system", "verb": "pkg-clean-cache", "bytes": pkgcache, "count": 0},
        {"key": "orphans", "label": "Orphan packages", "icon": "link_off", "note": "Installed as dependencies, now unused", "scope": "system", "verb": "pkg-orphans", "bytes": 0, "count": len(orphans)},
        {"key": "journal", "label": "System journal", "icon": "receipt_long", "note": "Trims to the most recent 64 MB", "scope": "system", "verb": "journal-vacuum", "bytes": max(0, journal - 64 * 1024**2), "count": 0, "total": journal},
        {"key": "coredumps", "label": "Core dumps", "icon": "memory", "note": "Memory snapshots from crashed programs", "scope": "system", "verb": "clean-coredumps", "bytes": coredumps, "count": 0},
    ]
    for c in sys_cats:
        cats.append(c)

    total_user = sum(c["bytes"] for c in cats if c["scope"] == "user")
    total = sum(c["bytes"] for c in cats)
    return {"categories": cats, "totalUser": total_user, "total": total}


def biggest(kind):
    n = 15
    results = []
    skip = (HOME + "/.cache", HOME + "/.local/share/Trash")
    if kind == "dirs":
        base = HOME
        for name in os.listdir(base):
            p = os.path.join(base, name)
            if name.startswith(".") and name not in (".cache", ".local", ".config", ".mozilla", ".librewolf"):
                # include the big hidden ones, skip the rest for speed
                if du(p) < 50 * 1024**2:
                    continue
            if os.path.isdir(p) and not os.path.islink(p):
                results.append({"path": p, "name": name, "bytes": du(p)})
        results.sort(key=lambda x: -x["bytes"])
        return {"items": results[:n]}
    # files
    found = []
    for root, dirs, files in os.walk(HOME, onerror=lambda e: None):
        # don't descend into throwaway trees — they're handled by the cleaner
        dirs[:] = [d for d in dirs if os.path.join(root, d) not in skip]
        for f in files:
            fp = os.path.join(root, f)
            try:
                if os.path.islink(fp):
                    continue
                sz = os.path.getsize(fp)
            except OSError:
                continue
            if sz > 20 * 1024 * 1024:  # only consider files over 20 MB
                found.append({"path": fp, "name": f, "bytes": sz})
    found.sort(key=lambda x: -x["bytes"])
    return {"items": found[:n]}


def clean(keys):
    by_key = {c["key"]: c for c in CATEGORIES}
    freed = 0
    removed = 0
    errors = []
    for k in keys:
        c = by_key.get(k)
        if not c:
            errors.append("unknown: " + k)
            continue
        for p in c["paths"]():
            if not os.path.exists(p):
                continue
            # final safety: never touch anything outside the home directory
            rp = os.path.realpath(p)
            if not (rp == os.path.realpath(HOME) or rp.startswith(os.path.realpath(HOME) + os.sep)):
                errors.append("refused (outside home): " + p)
                continue
            if rp == os.path.realpath(HOME):
                errors.append("refused (home itself): " + p)
                continue
            sz = du(p)
            try:
                if k == "trash":
                    # empty the trash's contents, keep the folder structure
                    for sub in ("files", "info", "expunged"):
                        t = os.path.join(p, sub)
                        if os.path.isdir(t):
                            for name in os.listdir(t):
                                fp = os.path.join(t, name)
                                shutil.rmtree(fp, ignore_errors=True) if os.path.isdir(fp) and not os.path.islink(fp) else os.remove(fp)
                elif os.path.isdir(p) and not os.path.islink(p):
                    shutil.rmtree(p, ignore_errors=True)
                else:
                    os.remove(p)
                freed += sz
                removed += 1
            except OSError as e:
                errors.append(str(e))
    return {"freed": freed, "removed": removed, "errors": errors}


def main():
    a = sys.argv[1:]
    if not a:
        print(json.dumps({"error": "usage: scan | biggest files|dirs | clean KEY..."}))
        return
    if a[0] == "scan":
        out = scan()
    elif a[0] == "biggest":
        out = biggest(a[1] if len(a) > 1 else "files")
    elif a[0] == "clean":
        out = clean(a[1:])
    else:
        out = {"error": "unknown verb " + a[0]}
    json.dump(out, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
