#!/usr/bin/env python3
"""Derive the ArchangelOS shell palette from a wallpaper.

Colours come from matugen. Near-monochrome wallpapers (most of the
ArchangelOS set) yield a muddy tint, so below a chroma threshold the
shell keeps its ink surfaces and falls back to the brand red accent.

usage: archangelos-shell-theme [WALLPAPER]
"""
import json
import os
import subprocess
import sys

BRAND = "#C24A52"
DEFAULT_WALL = "/usr/share/backgrounds/archangelos/wallpapers/default.png"
# Chroma (max - min channel) below this reads as grey/black: no usable hue.
MONO_CHROMA = 0.22

MONO = {
    "accent": BRAND,
    "ink": "#0C0C0B",
    "surface": "#161615",
    "fg": "#ECEBE8",
    "dim": "#9A9895",
    "faint": "#5E5D5A",
}


def chroma(hexcolor):
    channels = [int(hexcolor[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    return max(channels) - min(channels)


def dark(colors, name):
    entry = colors[name]
    return (entry.get("dark") or entry.get("default") or entry)["color"]


def palette_for(wall):
    try:
        out = subprocess.run(
            ["matugen", "image", wall, "--json", "hex", "--dry-run",
             "-m", "dark", "--source-color-index", "0"],
            check=True, capture_output=True, text=True).stdout
        colors = json.loads(out)["colors"]
    except (OSError, subprocess.CalledProcessError, ValueError, KeyError) as exc:
        print(f"matugen failed ({exc}); using the mono palette", file=sys.stderr)
        return dict(MONO, mono=True, source=BRAND)

    source = dark(colors, "source_color")
    if chroma(source) < MONO_CHROMA:
        return dict(MONO, mono=True, source=source)
    return {
        "mono": False,
        "source": source,
        "accent": dark(colors, "primary"),
        "ink": dark(colors, "surface_container_lowest"),
        "surface": dark(colors, "surface_container"),
        "fg": dark(colors, "on_surface"),
        "dim": dark(colors, "on_surface_variant"),
        "faint": dark(colors, "outline"),
    }


def main():
    wall = os.path.realpath(sys.argv[1] if len(sys.argv) > 1 else DEFAULT_WALL)
    pal = palette_for(wall)
    pal["wallpaper"] = wall
    state = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                         "archangelos")
    os.makedirs(state, exist_ok=True)
    target = os.path.join(state, "shell-palette.json")
    tmp = target + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(pal, fh, indent=1)
    os.replace(tmp, target)
    print(json.dumps(pal))


if __name__ == "__main__":
    main()
