#!/usr/bin/env python3
import os
import sys
import json
import shutil
import subprocess

CATALOG = "/usr/share/archangelos/launcher/catalog.json"
EDITION_DEFAULT = "ArchangelOS"

APP_ORDER = ["Internet", "Development", "Media", "Music", "Graphics", "Games",
             "Office", "Education", "Security", "System", "Utilities"]

WHEEL_ORDER = ["Information Gathering", "Vulnerability Analysis", "Web Application",
               "Database Assessment", "Password Attacks", "Wireless Attacks",
               "Bluetooth & RF", "Exploitation", "Sniffing & Spoofing",
               "Reverse Engineering", "Malware Analysis", "Forensics",
               "Anonymity & Tunneling", "Defense & Hardening", "Fuzzing",
               "Code & Supply Chain", "Automation & Utilities"]

CAT_MAP = [
    ("Internet", ("Network", "WebBrowser", "Email", "InstantMessaging", "Chat",
                  "FileTransfer", "P2P", "News", "RemoteAccess", "Telephony")),
    ("Development", ("Development", "IDE", "TextEditor", "Debugger", "GUIDesigner",
                     "Building", "Profiling", "RevisionControl", "WebDevelopment")),
    ("Media", ("AudioVideo", "Video", "Player", "TV", "Recorder", "DVD")),
    ("Music", ("Audio", "Music", "Midi", "Mixer", "Sequencer", "Tuner")),
    ("Graphics", ("Graphics", "Photography", "2DGraphics", "3DGraphics",
                  "RasterGraphics", "VectorGraphics", "Viewer", "Scanning")),
    ("Office", ("Office", "WordProcessor", "Spreadsheet", "Presentation",
                "Calendar", "ContactManagement", "Finance", "Dictionary", "Publishing")),
    ("Education", ("Education", "Science", "Math", "Astronomy", "Biology",
                   "Chemistry", "Geology", "Physics", "Languages")),
    ("Games", ("Game", "ActionGame", "ArcadeGame", "BoardGame", "StrategyGame",
               "KidsGame", "LogicGame", "Emulator", "Simulation")),
    ("System", ("System", "Settings", "Monitor", "HardwareSettings",
                "PackageManager", "TerminalEmulator", "Filesystem")),
    ("Utilities", ("Utility", "Accessories", "Archiving", "Compression",
                   "FileTools", "FileManager", "Calculator", "Clock")),
]

SECURITY_CATS = ("Security", "Forensics", "Pentesting")


def app_dirs():
    dirs = []
    home = os.path.expanduser("~")
    dataHome = os.environ.get("XDG_DATA_HOME") or os.path.join(home, ".local/share")
    dataDirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    seen = set()
    for base in [dataHome] + dataDirs.split(":"):
        base = base.strip()
        if not base:
            continue
        d = os.path.join(base, "applications")
        if d not in seen and os.path.isdir(d):
            seen.add(d)
            dirs.append(d)
    for d in ("/usr/share/applications", os.path.join(home, ".local/share/applications")):
        if d not in seen and os.path.isdir(d):
            seen.add(d)
            dirs.append(d)
    return dirs


def stripCodes(exe):
    out = []
    i = 0
    while i < len(exe):
        ch = exe[i]
        if ch == "%" and i + 1 < len(exe):
            if exe[i + 1] == "%":
                out.append("%")
            i += 2
            continue
        out.append(ch)
        i += 1
    return " ".join("".join(out).split())


_pathBins = None


def pathBins():
    global _pathBins
    if _pathBins is None:
        _pathBins = set()
        for d in (os.environ.get("PATH") or "/usr/bin").split(":"):
            if not d:
                continue
            try:
                _pathBins.update(os.listdir(d))
            except OSError:
                pass
    return _pathBins


def binAvail(cmd):
    if not cmd:
        return False
    if os.path.isabs(cmd):
        return os.path.isfile(cmd) and os.access(cmd, os.X_OK)
    return cmd in pathBins()


def parseDesktop(path):
    entry = {}
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            inGroup = False
            for raw in fh:
                s = raw.strip()
                if s.startswith("[") and s.endswith("]"):
                    inGroup = (s == "[Desktop Entry]")
                    continue
                if not inGroup or not s or s.startswith("#") or "=" not in s:
                    continue
                key, val = s.split("=", 1)
                key = key.strip()
                if key not in entry:
                    entry[key] = val.strip()
    except OSError:
        return None
    if entry.get("Type", "Application") != "Application":
        return None
    if entry.get("NoDisplay", "").lower() == "true":
        return None
    if entry.get("Hidden", "").lower() == "true":
        return None
    name = entry.get("Name", "").strip()
    execRaw = entry.get("Exec", "").strip()
    if not name or not execRaw:
        return None
    execClean = stripCodes(execRaw)
    if not execClean:
        return None
    probe = entry.get("TryExec", "").strip() or execClean.split()[0]
    probe = probe.strip('"')
    if not binAvail(probe):
        return None
    return {
        "name": name,
        "exec": execClean,
        "icon": entry.get("Icon", "").strip(),
        "terminal": entry.get("Terminal", "").lower() == "true",
        "categories": [c for c in entry.get("Categories", "").split(";") if c],
    }


def classify(categories):
    cats = set(categories)
    for disp, keys in CAT_MAP:
        if cats.intersection(keys):
            if disp == "Games" and ("System" in cats or "Settings" in cats):
                return "System"
            return disp
    return "Utilities"


def isSecurity(categories):
    return bool(set(categories).intersection(SECURITY_CATS))


def scanDesktops():
    apps = {}
    for d in app_dirs():
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for fn in names:
            if not fn.endswith(".desktop"):
                continue
            if fn.startswith("archangelos-"):
                continue
            item = parseDesktop(os.path.join(d, fn))
            if item is None:
                continue
            apps.setdefault(fn, item)
    return list(apps.values())


def loadCatalog():
    try:
        with open(CATALOG, "r", encoding="utf-8") as fh:
            return json.load(fh).get("entries", [])
    except (OSError, ValueError):
        return []


def installedPkgs():
    try:
        out = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True, timeout=20).stdout
        return set(out.split())
    except Exception:
        return None


def editionName():
    env = os.environ.get("ARCHANGELOS_EDITION")
    if env:
        return env
    for path in ("/etc/arch-release", "/etc/archangelos/edition"):
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                val = fh.read().strip()
                if val:
                    return val
        except OSError:
            pass
    return EDITION_DEFAULT


def emit(categories):
    doc = {"edition": editionName(), "categories": categories}
    json.dump(doc, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def catalogItems(redteam):
    entries = loadCatalog()
    pkgs = installedPkgs()
    out = []
    for e in entries:
        pkg = e.get("pkg")
        if pkgs is not None and pkg and pkg not in pkgs:
            continue
        exe = e.get("exec", "")
        bin0 = exe.split(" ")[0]
        if not e.get("gui") and not binAvail(bin0):
            continue
        if redteam and "wheel" not in e:
            continue
        out.append(e)
    return out


def buildRedteam():
    items = catalogItems(True)
    buckets = {}
    for e in items:
        buckets.setdefault(e["wheel"], []).append({
            "name": e["name"], "exec": e["exec"],
            "terminal": e.get("terminal", not e.get("gui", False)),
            "icon": e.get("icon", ""), "pkg": e.get("pkg", ""),
        })
    cats = []
    for name in WHEEL_ORDER:
        b = buckets.get(name)
        if b:
            b.sort(key=lambda it: it["name"].lower())
            cats.append({"name": name, "items": b})
    for name in sorted(buckets):
        if name not in WHEEL_ORDER:
            b = buckets[name]
            b.sort(key=lambda it: it["name"].lower())
            cats.append({"name": name, "items": b})
    emit(cats)


def buildLauncher():
    desktops = scanDesktops()
    items = catalogItems(False)
    allItems = []
    seenExec = set()
    buckets = {}

    def add(name, item):
        key = item["exec"].split(" ")[0] + "|" + item["name"].lower()
        if key in seenExec:
            return
        seenExec.add(key)
        buckets.setdefault(name, []).append(item)
        allItems.append(item)

    for it in desktops:
        cat = "Security" if isSecurity(it["categories"]) else classify(it["categories"])
        add(cat, {"name": it["name"], "exec": it["exec"],
                  "icon": it["icon"], "terminal": it["terminal"]})
    for e in items:
        add(e["app"], {"name": e["name"], "exec": e["exec"],
                       "icon": e.get("icon", ""),
                       "terminal": e.get("terminal", not e.get("gui", False)),
                       "pkg": e.get("pkg", "")})

    allItems.sort(key=lambda it: it["name"].lower())
    cats = [{"name": "Apps", "items": allItems}]
    for name in APP_ORDER:
        b = buckets.get(name)
        if b:
            b.sort(key=lambda it: it["name"].lower())
            cats.append({"name": name, "items": b})
    emit(cats)


def main():
    if "--redteam" in sys.argv[1:]:
        buildRedteam()
    else:
        buildLauncher()


if __name__ == "__main__":
    main()
