#!/bin/bash
# archangelos-engine-init — materialize a fully-installed ArcShell desktop at BUILD time.
#
# ArcShell's own installer (./install.sh -> `arcshell bootstrap`) refuses to leave a
# working install inside a headless mkarchiso chroot: its health gate waits for a
# live `systemctl --user` session AND a running Hyprland/quickshell instance, and
# when they're absent it UNINSTALLS the release it just published and errors out.
# The startup adapter (startupctl.sh) is likewise hard-gated on `systemctl --user
# show-environment`. Result: nothing survives the chroot, so the ISO boots to a bare
# default Hyprland (no bars, no keybinds).
#
# This script reproduces exactly what a successful managed-mode `arcshell bootstrap`
# leaves on disk, using only build artifacts (no systemd, no live session):
#   - release trees under ~/.local/share/arcshell/{releases,manager/releases}/<id>
#   - current symlinks + ~/.local/bin/arcshell launcher
#   - host config (kitty/starship/fastfetch/hypridle) via the release's own script
#   - the startup layer: hyprland.lua + split config/*.lua (launcher path substituted)
#     + arcshell.lua integration + ~/.config/systemd/user/arcshell.service + enable link
# It operates on $HOME, so run it once per target user (e.g. `su - liveuser -c ...`).
set -euo pipefail

log() { printf '  [arcshell-bake] %s\n' "$*"; }

SRC="${ARCSHELL_SRC:-/opt/arcshell}"
[ -d "$SRC" ] || { log "no $SRC; nothing to bake"; exit 0; }
command -v jq >/dev/null 2>&1      || { log "jq unavailable; skipping"; exit 0; }
command -v python3 >/dev/null 2>&1 || { log "python3 unavailable; skipping"; exit 0; }

HOME_DIR="${HOME:?HOME is required}"
config_root="${XDG_CONFIG_HOME:-$HOME_DIR/.config}"
data_root="${XDG_DATA_HOME:-$HOME_DIR/.local/share}"
bin_home="${XDG_BIN_HOME:-$HOME_DIR/.local/bin}"
odyroot="$data_root/arcshell"
shell_releases="$odyroot/releases"
manager_releases="$odyroot/manager/releases"
shell_current="$odyroot/current"
manager_current="$odyroot/manager/current"
launcher="$bin_home/arcshell"
hypr_dir="$config_root/hypr"
split_dir="$hypr_dir/config"
unit_dir="$config_root/systemd/user"
unit_file="$unit_dir/arcshell.service"
split_files=(animations.lua appearance.lua environment.lua input.lua keybinds.lua \
             layouts.lua monitors.lua startup.lua window-rules.lua)

if [ -e "$shell_current/shell.qml" ] && [ -f "$hypr_dir/hyprland.lua" ] && [ -f "$unit_file" ]; then
  log "already baked in $HOME_DIR; skipping"; exit 0
fi

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

# 0) Keybinds: ArcShell's keybinds.lua is replaced outright by ArchangelOS's own
# (/usr/share/archangelos/hypr/keybinds.lua) in step 4 below — Hyprland stacks duplicate
# binds, so the desktop's key map has to come from one file, not a patch over another.

# 0b) ArchangelOS AMOLED surfaces — force the dark palette's *background* layers to
# near-black so the desktop reads true-black, while leaving the wallpaper-derived
# accent hues (primary/secondary/tertiary/onSurface/outline) exactly as matugen
# picks them. Patched into $SRC before the artifact is built, at all three sources
# that can supply a palette:
#   - scripts/generate-palette.sh : the runtime matugen generator (what actually
#     colours the live desktop from the user's wallpaper) — clamp dark surfaces
#     after matugen validates, before the atomic publish.
#   - generated/palette.json      : the packaged fallback palette.
#   - core/Theme.qml fallbackDark : the last-resort hard-coded dark palette.
# Every step is value-idempotent and non-fatal (a miss must never abort the bake).
gp="$SRC/scripts/generate-palette.sh"
if [ -f "$gp" ] && ! grep -q 'AX AMOLED' "$gp"; then
  ax_snip="$tmp/ax_amoled.sh"
  cat > "$ax_snip" <<'AXEOF'
# AX AMOLED override: clamp dark surfaces to near-black (accents untouched).
if command -v jq >/dev/null 2>&1; then
    jq '.dark.surface="#000000"|.dark.surfaceContainerLow="#0a0a0a"|.dark.surfaceContainer="#121212"|.dark.surfaceContainerHigh="#1c1c1c"' \
        "$temp_palette" > "$temp_palette.ax" 2>/dev/null \
        && mv -f "$temp_palette.ax" "$temp_palette"
    rm -f "$temp_palette.ax"
fi
AXEOF
  if awk -v snip="$ax_snip" '
      /^chmod 0600 "\$temp_palette"/ {
        while ((getline line < snip) > 0) print line
        close(snip)
      }
      { print }
    ' "$gp" > "$gp.axtmp" && mv -f "$gp.axtmp" "$gp"; then
    chmod +x "$gp"
    log "generate-palette.sh: AMOLED dark surfaces baked"
  else
    rm -f "$gp.axtmp"; log "generate-palette.sh AMOLED patch skipped"
  fi
fi

gpj="$SRC/generated/palette.json"
if [ -f "$gpj" ]; then
  jq '.dark.surface="#000000"|.dark.surfaceContainerLow="#0a0a0a"|.dark.surfaceContainer="#121212"|.dark.surfaceContainerHigh="#1c1c1c"' \
    "$gpj" > "$gpj.axtmp" 2>/dev/null && mv -f "$gpj.axtmp" "$gpj" \
    || { rm -f "$gpj.axtmp"; log "generated/palette.json AMOLED patch skipped"; }
  log "generated/palette.json: AMOLED dark surfaces"
fi

tq="$SRC/core/Theme.qml"
if [ -f "$tq" ]; then
  sed -i \
    -e 's/surface: "#121217"/surface: "#000000"/' \
    -e 's/surfaceContainerLow: "#1a1a21"/surfaceContainerLow: "#0a0a0a"/' \
    -e 's/surfaceContainer: "#202027"/surfaceContainer: "#121212"/' \
    -e 's/surfaceContainerHigh: "#2a2931"/surfaceContainerHigh: "#1c1c1c"/' \
    "$tq" && log "Theme.qml fallbackDark: AMOLED dark surfaces" \
    || log "Theme.qml AMOLED patch skipped"
fi

# 0c) ArchangelOS video-wallpaper — teach ArcShell's wallpaper picker to smart-route
# by file type: a chosen image keeps the awww still pipeline (matugen palette and
# all), a chosen video is displayed live via mpvpaper (archangelos-wallpaper) with no
# palette. Patched into $SRC before the artifact is built so it ships in the release
# on both the live ISO and every disk re-bake. Strictly non-fatal and idempotent (the
# patcher guards each file with its own marker and always exits 0), so a stale anchor
# after an ArcShell update logs and is skipped rather than aborting the desktop bake.
vp="/usr/share/archangelos/arcshell/ax-wallpaper-video-patch.py"
[ -f "$vp" ] && python3 "$vp" "$SRC" || log "video-wallpaper patcher absent; skipping"

# 0d) ArchangelOS lock everywhere — route every ArcShell lock path to
# /usr/bin/archangelos-lock (hyprlock themed to match the SDDM login). ArcShell
# otherwise locks with its OWN hyprlock: on idle via the hypridle.conf that
# idlectl.sh generates, and via the Control-Center Lock button / `arcshell ipc
# session lock` through sessionctl.sh — the lockscreen that hangs on
# "authenticating". Patched into $SRC before the artifact build. Non-fatal.
idl="$SRC/scripts/idlectl.sh"
if [ -f "$idl" ]; then
  sed -i \
    -e 's@lock_cmd = pidof hyprlock || hyprlock@lock_cmd = /usr/bin/archangelos-lock@' \
    -e 's@before_sleep_cmd = loginctl lock-session@before_sleep_cmd = /usr/bin/archangelos-lock@' \
    -e 's@on-timeout = loginctl lock-session@on-timeout = /usr/bin/archangelos-lock@' \
    "$idl" && log "idlectl.sh: idle lock -> archangelos-lock" || log "idlectl.sh lock patch skipped"
fi
ssl="$SRC/scripts/sessionctl.sh"
if [ -f "$ssl" ]; then
  sed -i 's@exec hyprlock --config "$lock_config"@exec /usr/bin/archangelos-lock@' \
    "$ssl" && log "sessionctl.sh: manual lock -> archangelos-lock" || log "sessionctl.sh lock patch skipped"
fi

# 0e) ArchangelOS relabel — ArcShell's avatar picker reuses the Wallpaper grid and
# titles itself "Personal image", so it reads like a second, redundant wallpaper
# tab. Rename its heading + subtitle to name the profile-image picker it actually
# is. Patched into $SRC before the artifact build. Idempotent + non-fatal.
wpp="$SRC/panels/WallpaperPage.qml"
if [ -f "$wpp" ]; then
  sed -i \
    -e 's@"Personal image"@"Profile avatar"@' \
    -e 's@"Choose from your wallpaper library"@"Choose an image for your profile"@' \
    "$wpp" && log "WallpaperPage.qml: Personal image -> Profile avatar" || log "WallpaperPage relabel skipped"
fi

# 1) Build + independently verify the local release artifact (works headless).
VERSION="$(tr -d '[:space:]' < "$SRC/VERSION")"
art="$tmp/arcshell.ody"
log "building release artifact v$VERSION"
"$SRC/arcshell" artifact build --version "$VERSION" --output "$art" >/dev/null
DIGEST="$("$SRC/arcshell" artifact verify "$art" --json | jq -r '.artifactSha256')"
[ "${#DIGEST}" -eq 64 ] || { log "artifact verify produced no digest"; exit 1; }
RELEASE_ID="$VERSION-$DIGEST"
log "release id $RELEASE_ID"

# 2) Extract payload (shell/ + manager/) into the two release trees.
tar -xf "$art" -C "$tmp"                       # -> release.json + payload.tar
mkdir -p "$tmp/pp"
tar -xf "$tmp/payload.tar" -C "$tmp/pp"        # -> shell/ manager/
[ -f "$tmp/pp/shell/shell.qml" ] && [ -f "$tmp/pp/manager/scripts/startupctl.sh" ] \
  || { log "payload missing required members"; exit 1; }

shell_rel="$shell_releases/$RELEASE_ID"
mgr_rel="$manager_releases/$RELEASE_ID"
mkdir -p "$shell_releases" "$manager_releases"
rm -rf "$shell_rel" "$mgr_rel"
cp -a "$tmp/pp/shell" "$shell_rel"
cp -a "$tmp/pp/manager" "$mgr_rel"
cp -f "$tmp/release.json" "$shell_rel/release.json"     # what install.py stamps into the shell tree
chmod +x "$shell_rel"/scripts/*.sh "$shell_rel"/scripts/*.py 2>/dev/null || true
chmod +x "$mgr_rel"/scripts/*.sh "$mgr_rel/arcshell" 2>/dev/null || true

# 3) current symlinks + stable launcher (relative targets, matching the installer).
ln -sfn "releases/$RELEASE_ID" "$shell_current"
ln -sfn "releases/$RELEASE_ID" "$manager_current"
mkdir -p "$bin_home"
ln -sfn "$manager_current/arcshell" "$launcher"

# 4) Startup layer — exactly what startupctl.sh apply (managed mode) would deploy.
mkdir -p "$hypr_dir" "$split_dir" "$unit_dir"
cp -f "$shell_rel/config/hypr/hyprland.lua" "$hypr_dir/hyprland.lua"
grep -Fxq 'require("arcshell")' "$hypr_dir/hyprland.lua" \
  || printf 'require("arcshell")\n' >> "$hypr_dir/hyprland.lua"

# ArchangelOS overlay (SUPER+TAB launcher, SUPER+L lock, SUPER+T rio, screenshot).
# On the live build, customize_airootfs runs archangelos-wallpaper-setup AFTER this
# bake to layer the overlay on. But the on-disk installers re-run ONLY the bake for
# the new user, and the bake rewrites hyprland.lua above (dropping any prior overlay
# require), so wire it here too — layered after require("arcshell"), idempotent, so it
# is correct on both the live ISO and every disk install without touching installers.
overlay_src="/usr/share/archangelos/hypr/archangelos.lua"
if [ -f "$overlay_src" ]; then
  mkdir -p "$split_dir"
  cp -f "$overlay_src" "$split_dir/archangelos.lua"
  grep -Fxq 'require("config.archangelos")' "$hypr_dir/hyprland.lua" \
    || printf 'require("config.archangelos")\n' >> "$hypr_dir/hyprland.lua"
fi

# keybinds.lua carries a __ARCSHELL_LAUNCHER__ token; substitute the @sh-quoted,
# JSON-encoded launcher path the same way copy_split_files() does.
launcher_literal="$(jq -Rn --arg p "$(jq -rn --arg path "$launcher" '$path|@sh')" '$p')"
for f in "${split_files[@]}"; do
  src="$shell_rel/config/hypr/$f"
  [ -f "$src" ] || continue
  if [ "$f" = keybinds.lua ]; then
    awk -v repl="local arcshellLauncher = $launcher_literal" \
      '$0=="local arcshellLauncher = \"__ARCSHELL_LAUNCHER__\""{print repl; next} {print}' \
      "$src" > "$split_dir/$f"
    grep -Fq "local arcshellLauncher = $launcher_literal" "$split_dir/$f" \
      || { log "keybinds launcher substitution failed"; exit 1; }
    # ArchangelOS owns the key map: install ours over ArcShell's (see step 0).
    ax_keys="/usr/share/archangelos/hypr/keybinds.lua"
    [ -f "$ax_keys" ] && cp -f "$ax_keys" "$split_dir/$f" && log "keybinds.lua: ArchangelOS key map"
  else
    cp -f "$src" "$split_dir/$f"
  fi
done

# ArchangelOS distro override: Rio is the default terminal. ArcShell ships kitty in
# both the SUPER+Return keybind (handled by the keybinds.lua sed above) and the
# TERMINAL env in environment.lua (what apps / "open a terminal" actions resolve).
if [ -f "$split_dir/environment.lua" ]; then
  sed -i 's/hl.env("TERMINAL", "kitty")/hl.env("TERMINAL", "rio")/' "$split_dir/environment.lua" \
    && log "environment.lua: TERMINAL -> rio" || true
fi

# arcshell.lua host integration (render_integration, lua branch).
cat > "$hypr_dir/arcshell.lua" <<'LUAEOF'
-- Managed by ArcShell host integration v3
hl.layer_rule({
    name = "arcshell-liquid-glass",
    match = { namespace = "^arcshell:(island|notes):glass$" },
    blur = true,
    ignore_alpha = 0.02,
})
-- ArchangelOS: the desktop shell is /usr/share/archangelos/shell (started by
-- config/archangelos.lua), so ArcShell's own Quickshell session is not started here.
hl.on("hyprland.start", function()
    hl.exec_cmd("bash -c \"pgrep -u $USER -x wl-paste >/dev/null || wl-paste --watch cliphist store &\"")
end)
LUAEOF

# arcshell.service user unit (render_unit). Quoted heredoc keeps the systemd '$$'
# escapes literal so ExecStart resolves $HOME/$current at runtime, not build time.
cat > "$unit_file" <<'UNITEOF'
# Managed by ArcShell host integration v3
[Unit]
Description=ArcShell Quickshell session
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/bin/sh -c 'current="$${XDG_DATA_HOME:-$${HOME}/.local/share}/arcshell/current"; release="$$(readlink -f "$$current")"; exec "$$release/scripts/arcshell-session.sh" --root "$$release"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
UNITEOF

# Enable user units by hand (no `systemctl --user` in the chroot): create the
# WantedBy .wants symlink that `systemctl --user enable` would.
enable_user_unit() {
  local unit="$1" wb t
  [ -f "$unit_dir/$unit" ] || return 0
  wb="$(grep -m1 '^WantedBy=' "$unit_dir/$unit" | cut -d= -f2- || true)"
  [ -n "$wb" ] || return 0
  for t in $wb; do
    mkdir -p "$unit_dir/$t.wants"
    ln -sfn "../$unit" "$unit_dir/$t.wants/$unit"
  done
}
# ArchangelOS: arcshell.service stays written but NOT enabled — its Quickshell would run
# a second desktop on top of the ArchangelOS shell. Drop a link left by an older bake.
rm -f "$unit_dir/graphical-session.target.wants/arcshell.service"

# 5) Host config (kitty/starship/fastfetch/hypridle). The script writes its config
# files before it touches systemd, so the tail `systemctl --user` failure in the
# chroot is expected and harmless — the files are already in place.
if [ -x "$shell_rel/scripts/host-configctl.sh" ]; then
  "$shell_rel/scripts/host-configctl.sh" apply false \
    || log "host-configctl reported non-zero (expected: no user systemd in chroot)"
  enable_user_unit hypridle.service
fi

# (No ArcShell managed-shortcut block: it binds SUPER+V / SUPER+SPACE / SUPER+A to
# ArcShell's IPC, which would stack on top of the ArchangelOS key map.)

# ArchangelOS default appearance — ship the desktop "glassy" out of the box:
# glass material + the lowest surfaceOpacity the shell allows (0.72 => maximum
# translucency; see core/SurfaceMaterial.qml's glassOpacity mapping). Combined
# with the AMOLED surfaces patched above this gives dark, glassy panels on first
# boot. Seeded only when the user has no settings yet, so a returning user's own
# choices are never clobbered. Runs per-user (liveuser on the ISO, each new user
# on disk installs re-run this bake), matching how the rest of the desktop is baked.
state_root="${XDG_STATE_HOME:-$HOME_DIR/.local/state}"
ody_state="$state_root/arcshell"
if [ ! -f "$ody_state/settings.json" ]; then
  mkdir -p "$ody_state"
  cat > "$ody_state/settings.json" <<'JSONEOF'
{
  "version": 1,
  "settings": {
    "appearance": {
      "material": "glass",
      "surfaceOpacity": 0.72
    },
    "idle": {
      "managed": false
    }
  }
}
JSONEOF
  log "seeded default appearance (glass + amoled)"
fi

# Alternate desktop shells (Settings > Desktop & Shell). Each ships read-only under
# /usr/share/archangelos/themes/<name>; copy it into the user's theme dir (writable, since the
# shells generate CSS and link node_modules at runtime) so the picker can switch to it. Copied
# only when absent, so a user's edits survive a re-bake. ArcShell stays the default (no .active).
themes_src="/usr/share/archangelos/themes"
if [ -d "$themes_src" ]; then
  themes_dir="$hypr_dir/themes"
  mkdir -p "$themes_dir"
  for t in "$themes_src"/*/; do
    [ -d "$t" ] || continue
    name="$(basename "$t")"
    if [ ! -e "$themes_dir/$name" ]; then
      cp -a "$t" "$themes_dir/$name" && log "seeded desktop shell: $name"
    fi
  done
fi

log "desktop baked into $HOME_DIR (release $RELEASE_ID)"
