#!/usr/bin/env python3
import json
import os
import shlex
import shutil
import sys

from PyQt6.QtCore import Qt, QProcess, QSize
from PyQt6.QtGui import QFont, QFontDatabase, QCursor
from PyQt6.QtWidgets import (
    QApplication, QWidget, QHBoxLayout, QVBoxLayout, QLabel, QLineEdit,
    QListWidget, QListWidgetItem, QScrollArea, QPushButton, QGridLayout,
    QFrame,
)

MENU_JSON = "/usr/share/archangelos/launcher/menu.json"
FONT_DIR = "/usr/share/fonts/archangelos"

C_BG = "#0C0C0B"
C_SIDEBAR = "#0A0A09"
C_SURFACE = "#111110"
C_SURFACE2 = "#16120F"
C_TEXT = "#ECEBE8"
C_DIM = "#9A9895"
C_FAINT = "#5E5D5A"
C_ACCENT = "#C24A52"
C_INK = "#0E0E0D"
C_LINE = "#22FFFFFF"

TERMINALS = ["rio", "konsole", "alacritty", "foot", "kitty", "wezterm", "xterm"]


def load_fonts():
    if os.path.isdir(FONT_DIR):
        for fn in os.listdir(FONT_DIR):
            if fn.lower().endswith((".ttf", ".otf")):
                QFontDatabase.addApplicationFont(os.path.join(FONT_DIR, fn))


def find_terminal():
    for t in TERMINALS:
        if shutil.which(t):
            return t
    return None


class AppCard(QPushButton):
    def __init__(self, item):
        super().__init__()
        self.item = item
        self.setObjectName("AppCard")
        self.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        self.setText(item["name"])
        self.setFixedHeight(46)
        installed = shutil.which(item["exec"].split()[0]) is not None
        self.setToolTip(item["exec"] + ("" if installed else "  (installs on click)"))
        if not installed:
            self.setProperty("missing", True)


class Launcher(QWidget):
    def __init__(self, data):
        super().__init__()
        self.data = data
        self.setWindowTitle("archangelos-launcher")
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint)
        self.resize(1120, 720)
        self.term = find_terminal()
        self._build()
        self._style()
        self._select_row(0)

    def _build(self):
        root = QHBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)

        # sidebar
        side = QFrame()
        side.setObjectName("Sidebar")
        side.setFixedWidth(300)
        sl = QVBoxLayout(side)
        sl.setContentsMargins(22, 22, 16, 18)
        sl.setSpacing(12)

        title = QLabel(self.data.get("edition", "ArchangelOS"))
        title.setObjectName("Brand")
        title.setFont(QFont("Shippori Mincho", 15, QFont.Weight.Bold))
        sl.addWidget(title)

        self.catlist = QListWidget()
        self.catlist.setObjectName("CatList")
        self.catlist.setFrameShape(QFrame.Shape.NoFrame)
        self.catlist.setVerticalScrollMode(QListWidget.ScrollMode.ScrollPerPixel)
        self._fill_cats()
        self.catlist.currentRowChanged.connect(self._select_row)
        sl.addWidget(self.catlist, 1)
        root.addWidget(side)

        # content
        content = QFrame()
        content.setObjectName("Content")
        cl = QVBoxLayout(content)
        cl.setContentsMargins(28, 24, 28, 24)
        cl.setSpacing(16)

        head = QHBoxLayout()
        self.head_lbl = QLabel("")
        self.head_lbl.setObjectName("Head")
        self.head_lbl.setFont(QFont("Shippori Mincho", 22, QFont.Weight.Bold))
        head.addWidget(self.head_lbl)
        head.addStretch()
        close = QPushButton("✕")
        close.setObjectName("Close")
        close.setFixedSize(34, 34)
        close.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        close.clicked.connect(self.close)
        head.addWidget(close)
        cl.addLayout(head)

        self.search = QLineEdit()
        self.search.setObjectName("Search")
        self.search.setPlaceholderText("Search applications...")
        self.search.textChanged.connect(self._filter)
        cl.addWidget(self.search)

        self.scroll = QScrollArea()
        self.scroll.setObjectName("Scroll")
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.Shape.NoFrame)
        self.grid_host = QWidget()
        self.grid = QGridLayout(self.grid_host)
        self.grid.setContentsMargins(0, 0, 0, 0)
        self.grid.setSpacing(10)
        self.grid.setAlignment(Qt.AlignmentFlag.AlignTop)
        self.scroll.setWidget(self.grid_host)
        cl.addWidget(self.scroll, 1)
        root.addWidget(content, 1)

    def _fill_cats(self):
        self._rows = []   # (kind, cat_index, sub_index)
        for ci, cat in enumerate(self.data["categories"]):
            it = QListWidgetItem(f"{cat.get('icon','')}  {cat['name']}".strip())
            it.setData(Qt.ItemDataRole.UserRole, ("cat", ci, -1))
            self.catlist.addItem(it)
            self._rows.append(("cat", ci, -1))
            for si, sub in enumerate(cat.get("subcats", [])):
                sit = QListWidgetItem(f"      {sub['name']}")
                sit.setForeground(Qt.GlobalColor.gray)
                sit.setData(Qt.ItemDataRole.UserRole, ("sub", ci, si))
                self.catlist.addItem(sit)
                self._rows.append(("sub", ci, si))

    def _items_for(self, kind, ci, si):
        cat = self.data["categories"][ci]
        if kind == "sub":
            return cat["subcats"][si]["items"], f"{cat['name']} · {cat['subcats'][si]['name']}"
        items = list(cat.get("items", []))
        for s in cat.get("subcats", []):
            items += s["items"]
        return items, cat["name"]

    def _select_row(self, row):
        if row < 0 or row >= len(self._rows):
            return
        kind, ci, si = self._rows[row]
        self._cur_items, head = self._items_for(kind, ci, si)
        self.head_lbl.setText(head)
        self.search.clear()
        self._populate(self._cur_items)

    def _filter(self, text):
        text = text.strip().lower()
        if not text:
            self._populate(self._cur_items)
            return
        allitems = []
        for cat in self.data["categories"]:
            allitems += cat.get("items", [])
            for s in cat.get("subcats", []):
                allitems += s["items"]
        seen = set()
        res = []
        for it in allitems:
            if text in it["name"].lower() and it["name"] not in seen:
                seen.add(it["name"]); res.append(it)
        self.head_lbl.setText(f"Search: {text}")
        self._populate(res)

    def _populate(self, items):
        while self.grid.count():
            w = self.grid.takeAt(0).widget()
            if w:
                w.deleteLater()
        cols = 3
        for i, it in enumerate(items):
            card = AppCard(it)
            card.clicked.connect(lambda _=False, x=it: self._launch(x))
            self.grid.addWidget(card, i // cols, i % cols)

    def _launch(self, item):
        exe = item["exec"]
        binname = exe.split()[0]
        pkg = item.get("pkg", binname)
        if shutil.which(binname) is None:
            self._install_then_launch(item, binname, pkg, exe)
            self.close()
            return
        if item.get("terminal") and self.term:
            QProcess.startDetached(self.term, ["-e", exe])
        else:
            QProcess.startDetached(exe, [])
        self.close()

    def _install_then_launch(self, item, binname, pkg, exe):
        install = "archangelos-install-tool " + shlex.quote(pkg)
        if item.get("terminal"):
            after = exe
        else:
            after = "setsid " + exe + " >/dev/null 2>&1 &"
        script = (
            install
            + "; if command -v " + shlex.quote(binname) + " >/dev/null 2>&1; then "
            + after
            + "; else echo; read -rp 'Install failed. Press Enter to close...'; fi"
        )
        if self.term:
            QProcess.startDetached(self.term, ["-e", "bash", "-lc", script])

    def keyPressEvent(self, e):
        if e.key() == Qt.Key.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(e)

    def _style(self):
        self.setStyleSheet(f"""
            QWidget {{ background-color: {C_BG}; color: {C_TEXT}; font-family: 'Quantico'; }}
            QFrame#Sidebar {{ background-color: {C_SIDEBAR}; border-right: 1px solid {C_LINE}; }}
            QLabel#Brand {{ color: {C_TEXT}; }}
            QLabel#Head {{ color: {C_TEXT}; }}
            QListWidget#CatList {{ background: transparent; border: none; font-size: 13px; outline: none; }}
            QListWidget#CatList::item {{ padding: 9px 10px; border-radius: 6px; color: {C_DIM}; }}
            QListWidget#CatList::item:hover {{ background-color: {C_SURFACE}; color: {C_TEXT}; }}
            QListWidget#CatList::item:selected {{ background-color: {C_SURFACE2}; color: {C_TEXT};
                border-left: 3px solid {C_ACCENT}; font-weight: bold; }}
            QLineEdit#Search {{ background-color: {C_SURFACE}; border: 1px solid {C_LINE};
                border-radius: 8px; padding: 10px 12px; font-size: 14px; color: {C_TEXT}; }}
            QLineEdit#Search:focus {{ border-color: {C_ACCENT}; }}
            QPushButton#AppCard {{ background-color: {C_SURFACE}; border: 1px solid {C_LINE};
                border-radius: 8px; padding: 0 14px; text-align: left; font-size: 13px; color: {C_TEXT}; }}
            QPushButton#AppCard:hover {{ border-color: {C_ACCENT}; background-color: {C_SURFACE2}; }}
            QPushButton#AppCard[missing="true"] {{ color: {C_FAINT}; }}
            QPushButton#Close {{ background: transparent; border: 1px solid {C_LINE};
                border-radius: 17px; color: {C_DIM}; font-size: 14px; }}
            QPushButton#Close:hover {{ border-color: {C_ACCENT}; color: {C_ACCENT}; }}
            QScrollArea#Scroll {{ background: transparent; border: none; }}
        """)


def main():
    app = QApplication(sys.argv)
    load_fonts()
    path = MENU_JSON
    if len(sys.argv) > 1 and os.path.isfile(sys.argv[1]):
        path = sys.argv[1]
    if not os.path.isfile(path):
        print(f"menu data not found: {path}", file=sys.stderr)
        return 1
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    win = Launcher(data)
    win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
