[Desktop Entry]
Type=Application
Name=Chromium
Exec=chromium %U
# ArchangelOS Fallen: installed only as the engine for the web-screenshot tools
# (aquatone, gowitness, eyewitness), so it stays out of the menus. Overrides
# /usr/share/applications/chromium.desktop via XDG_DATA_DIRS precedence.
NoDisplay=true
