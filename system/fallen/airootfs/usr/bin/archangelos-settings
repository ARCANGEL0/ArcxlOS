    ("Watch", "watch"),
    ("Tool Rack", "tools"),
    ("Spoof & Trace", "spoof"),
])

NAV_CARE = ("CARE", [
    ("Maintenance", "maintenance"),
    ("Diagnostics", "diagnostics"),
    ("Logs", "logs"),
])


def build_nav():
    nav = list(NAV_BASE)
    ed = edition_slug()
    if ed == "gaming" or shutil.which("steam") or shutil.which("lutris"):
        nav.append(NAV_GAMING)
    if ed == "fallen" or shutil.which("tor"):
        nav.append(NAV_SHADOW)
    nav.append(NAV_CARE)
    return nav


