    st = run(["systemctl", "is-active", "libvirtd"], 0.8).strip() or "missing"
    rows = [("switch", "LIBVIRTD", st.upper(),
             ACCENT if st == "active" else QColor(30, 29, 27),
             "start/stop libvirtd — phase 3"),
            ("meter", "NETWORKS", 5 if nets else 1, str(nets) + " defined"),
            ("kv", "QEMU", ", ".join([b for b in ("qemu-system-x86_64", "qemu-system-aarch64")
                                      if shutil.which(b)]) or "—")]
    if vms:
        rows.append(("grid", "VIRTUAL MACHINES",
                     [(vm[0], vm[1], NEON_HI if vm[1].lower() == "running" else QColor(160, 100, 255))
                      for vm in vms[:9]]))
    else:
        rows.append(("note", "no VMs found — create one in virt-manager", False))
    return rows


def wifi_page():
    ssid, dev = wifi_active()
    rows = []
    if ssid:
        rows.append(("switch", "LINK", ssid + " · " + dev, ACCENT,
                     "connected via " + dev))
    else:
        rows.append(("switch", "LINK", "disconnected", QColor(30, 29, 27),
                     "no active wireless connection"))
    rows.append(("switch", "WIFI", rfkill_state("wifi").upper(),
                 ACCENT if rfkill_state("wifi") == "unblocked" else QColor(30, 29, 27),
                 "airplane / rfkill — phase 2"))
    scan = wifi_scan()
    if scan:
        rows.append(("grid", "NETWORKS",
                     [(("%s %s" % ("●" if inuse else "", s)), "%d%%" % sig,
                       NEON_HI if inuse else ACCENT) for inuse, s, sig, sec in scan[:9]]))
    rows.append(("note", "connect · forget — phase 2", True))
    return rows


