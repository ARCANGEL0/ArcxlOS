             NEON_HI if mic else QColor(30, 29, 27), "pactl source outputs"),
            ("switch", "CAMERA", "%d nodes" % cam if cam else "none",
             ACCENT if cam else QColor(30, 29, 27), "/dev/video*"),
            ("kv", "ESTABLISHED", str(established_count())),
            ("grid", "LISTENERS",
             [(p, "%s · %s" % (a[:22], proc[:18]), ACCENT) for p, a, proc in lst[:9]])]
    return rows


