def datetime_page():
    d = timedate_fields()
    rows = [("clock",)]
    rows.append(("switch", "NTP", "enabled" if d.get("NTP", "no") == "yes" else "disabled",
                 ACCENT if d.get("NTP") == "yes" else QColor(30, 29, 27),
                 "timedatectl set-ntp — phase 2"))
    rows.append(("kv", "TIMEZONE", d.get("Timezone", "—")))
    rows.append(("kv", "RTC LOCALTIME", d.get("LocalRTC", "—")))
    sync = d.get("NTPSynchronized", "no")
    rows.append(("meter", "SYNC", 5 if sync == "yes" else 1, sync))
    return rows


def notify_page():
    daemons, dnd, hist = notify_state()
    return [("switch", "DO NOT DISTURB", "on" if dnd else "off",
             NEON_HI if dnd else QColor(30, 29, 27),
             "per-app rules + history viewer — phase 2"),
