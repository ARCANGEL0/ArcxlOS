def wallpaper_page():
    out = run(["hyprctl", "hyprpaper", "listactive"], 0.8)
    m = re.search(r"(/\S+)", out)
    cur = m.group(1) if m else "—"
    rows = [("switch", "CURRENT", cur[-44:] if len(cur) > 44 else cur,
             ACCENT if cur != "—" else QColor(30, 29, 27), "hyprpaper/swww active")]
    wp = os.path.expanduser("~/Pictures/Wallpapers")
    n = 0
    try:
        for root, _, files in os.walk(wp):
            n += len(files)
            if n > 999:
                break
    except Exception:
        pass
    rows.append(("meter", "GALLERY", 5 if n else 1, "%d files" % n if n else "empty"))
    rows.append(("note", "gallery grid + slideshow — phase 2", False))
    return rows


def fonts_page():
    fams = cached("fonts", 600, fonts_list)
    rows = [("meter", "FAMILIES", 0, str(len(fams)) if fams else "—",
             "installed font families")]
    picked = [f for f in ("JetFramesMono Nerd Font", "JetFrames Mono",
                          "Orbitron", "Rajdhani", "Chakra Petch",
                          "DepartureMono", "Noto Sans Mono") if f in fams]
    for f in (picked[:2] + fams[:6])[:8]:
        rows.append(("spec", f, "† AaBbGg 0123 {socket}"))
    return rows


def compositor_page():
    rows = [("switch", "ANIMATIONS", hypr_opt("animations:enabled").upper(),
             ACCENT, "hyprland animations"),
            ("switch", "BLUR", hypr_opt("decoration:blur:enabled").upper(),
             ACCENT, "window blur"),
            ("switch", "VRR", hypr_opt("decoration:monitor:vrr").upper(),
             ACCENT, "variable refresh rate"),
            ("kv", "ROUNDING", hypr_opt("decoration:rounding")),
            ("kv", "BORDER SIZE", hypr_opt("decoration:border_size")),
            ("kv", "ACTIVE BORDER", hypr_opt("decoration:col.active_border")[:44]),
            ("note", "window style editor writes cyberarch user_config.lua — phase 2", True)]
    return rows


def disks_page():
    mounts = disk_mounts()[:3]
    rows = []
    if mounts:
        mp, fr, us, to = mounts[0]
        rows.append(("donut", "ROOT " + mp, fr, "%d%%" % (fr * 100),
                     "%s / %s" % (fmt_size(us), fmt_size(to))))
        if len(mounts) > 1:
            mp, fr, us, to = mounts[1]
            rows.append(("donut", mp, fr, "%d%%" % (fr * 100),
                         "%s / %s" % (fmt_size(us), fmt_size(to))))
    rows.append(("spark", "DISK IO", "io", fmt_rate(0)))
    try:
        out = run(["lsblk", "-o", "NAME,SIZE,TYPE", "-l", "-n"], 1.5)
        for l in out.splitlines()[:4]:
            f = l.split()
            if len(f) >= 3 and f[2] == "disk":
                rows.append(("kv", f[0].upper(), f[1]))
    except Exception:
        pass
    return rows or [("kv", "STORAGE", "—")]


def apps_page():
    ent = cached("pkgsizes", 600, pacman_sizes)
    if not ent:
        return [("note", "reading package database…", False)]
    total = sum(s for _, s in ent)
    rows = [("meter", "PACKAGES", 0, str(len(ent)), "installed · " + fmt_size(total)),
            ("grid", "LARGEST",
             [(n.upper()[:20], fmt_size(s), NEON_HI if s > ent[0][1] * 0.3 else ACCENT)
              for n, s in ent[:9]])]
    return rows


def apps_home():
    hogs = cached("hogs", 300, home_hogs)
    rows = []
    if hogs:
        rows.append(("grid", "HOME CONSUMERS",
                     [(n.upper()[:18], fmt_size(s), ACCENT) for n, s in hogs[:9]]))
    else:
        rows.append(("note", "measuring home folders…", False))
    return rows


def caches_page():
    cache, trash = cached("caches", 300, cache_sizes)
    rows = []
    if cache is not None:
        rows.append(("bar", "~/.CACHE", min(1.0, cache / (8 * 1024 ** 3)), fmt_size(cache)))
    if trash is not None:
        rows.append(("bar", "TRASH", min(1.0, trash / (2 * 1024 ** 3)), fmt_size(trash)))
    pkg_out = run(["du", "-sh", "/var/cache/pacman/pkg"], 2.0)
    rows.append(("kv", "PKG CACHE", pkg_out.split()[0] if pkg_out.strip() else "—"))
    orph = run(["pacman", "-Qdtq"], 5)
    rows.append(("kv", "ORPHANS", str(len(orph.splitlines())) if orph.strip() else "0"))
    rows.append(("note", "clean actions — phase 3", False))
    return rows


def autostart_page():
    user, system, units = autostart_lists()
    rows = [("meter", "USER UNITS", 5 if units else 1, str(units) + " enabled")]
    if user:
        rows.append(("grid", "XDG AUTOSTART", [(u, "enabled", ACCENT) for u in user[:9]]))
    if system:
        rows.append(("grid", "SYSTEM AUTOSTART", [(u, "enabled", ACCENT) for u in system[:9]]))
    rows.append(("note", "per-entry enable/disable — phase 2", False))
    return rows


def default_apps_page():
    def q(mime):
        return run(["xdg-mime", "query", "default", mime], 0.8).strip() or "—"
    browser = run(["xdg-settings", "get", "default-web-browser"], 0.8).strip() or "—"
    return [("switch", "BROWSER", browser, ACCENT, "xdg-settings default-web-browser"),
            ("switch", "FILES", q("inode/directory"), ACCENT, "mime inode/directory"),
            ("switch", "TEXT", q("text/plain"), ACCENT, "mime text/plain"),
            ("switch", "IMAGES", q("image/png"), ACCENT, "mime image/png"),
            ("switch", "VIDEO", q("video/mp4"), ACCENT, "mime video/mp4"),
            ("switch", "MUSIC", q("audio/mpeg"), ACCENT, "mime audio/mpeg")]


def firewall_page():
    backend, n, tor = fw_rules()
    rows = [("switch", "BACKEND", backend.upper() if backend != "—" else "none",
             ACCENT if backend != "—" else QColor(30, 29, 27), "nftables / iptables"),
            ("kv", "RULES", str(n)),
            ("switch", "ONION REDIRECT", "active" if tor else "off",
             ACCENT if tor else QColor(30, 29, 27),
             "%d rules touch 9040" % tor if tor else "no transparent tor rules")]
    return rows


def lock_page():
    rows = [("switch", "SDDM", unit_state("sddm").upper(),
             ACCENT, "display manager"),
            ("kv", "SDDM THEME", sddm_theme()),
            ("switch", "HYPRLock", "installed" if shutil.which("hyprlock") else "missing",
             ACCENT if shutil.which("hyprlock") else QColor(30, 29, 27), "screen locker")]
    idle = os.path.expanduser("~/.config/hypr/hypridle.conf")
    n = 0
    try:
        n = sum(1 for l in open(idle, encoding="utf-8", errors="ignore")
                if l.strip().startswith("timeout"))
    except Exception:
        pass
    rows.append(("kv", "IDLE TIMERS", str(n) if n else "—"))
    ll = last_logins()
    if ll:
        rows.append(("grid", "LAST LOGINS",
                     [(u, "%s · %s" % (frm, when[:10]), ACCENT) for u, frm, when in ll[:6]]))
    return rows


def services_page():
    out = run(["systemctl", "list-units", "--type=service", "--state=running",
               "--no-legend"], 1.5)
    units = [tuple(l.split()[:2]) for l in out.splitlines() if l.strip()]
    failed = run(["systemctl", "--failed", "--no-legend"], 1.5).splitlines()
    rows = [("meter", "RUNNING", 5 if units else 1, str(len(units)) + " active services")]
    if failed:
        rows.append(("switch", "FAILED", ", ".join(f.split()[0] for f in failed[:3]),
                     NEON_HI, "systemd units in failure state"))
    rows.append(("grid", "UNITS",
                 [(u, d[:24], ACCENT) for u, d in units[:12]]))
    return rows


def ports_page():
    lst = cached("listeners", 5, listeners)
    est = established_count()
    rows = [("meter", "LISTENING", 5 if lst else 1,
             str(len(lst)) + " sockets · %d established" % est)]
    if lst:
        rows.append(("grid", "PORTS",
                     [(p, "%s · %s" % (a[:22], proc[:18]), ACCENT) for p, a, proc in lst[:9]]))
    return rows


def gperf_page():
    rows = [("switch", "GAMEMODE", "present" if shutil.which("gamemoded") else "missing",
             ACCENT if shutil.which("gamemoded") else QColor(30, 29, 27), "gamemode daemon"),
            ("switch", "PROFILE", power_profile().upper(),
             NEON_HI if power_profile() == "performance" else ACCENT,
             "powerprofilesctl")]
    rows.append(("spark", "CPU", "cpu", "%.0f%%" % 0))
    rows.append(("spark", "NET", "net", fmt_rate(0)))
    try:
        gov = open("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor",
                   encoding="utf-8").read().strip()
        rows.append(("kv", "CPU GOVERNOR", gov))
    except Exception:
        pass
    return rows


