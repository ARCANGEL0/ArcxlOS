def grunners_page():
    rows = []
    for b in ("steam", "lutris", "bottles", "heroic"):
        w = shutil.which(b)
        rows.append(("switch", b.upper(), "installed" if w else "not found",
                     ACCENT if w else QColor(30, 29, 27), "game runner"))
    wv = run(["wine", "--version"], 1.0).splitlines()
    rows.append(("kv", "WINE", wv[0] if wv else "—"))
    ctd = os.path.expanduser("~/.steam/steam/compatibilitytools.d")
    try:
        n = len(os.listdir(ctd))
    except Exception:
        n = 0
    rows.append(("kv", "PROTON-GE", "%d builds" % n if n else "—"))
    return rows


def gpads_page():
    pads = gamepads()
    rows = [("meter", "PADS", 0, str(len(pads)) + " joystick devices")]
    for p in pads[:6]:
        rows.append(("switch", "DEVICE", p[:40], ACCENT, "gamepad detected"))
    rows.append(("note", "calibration links — phase 2", False))
    return rows


def glib_page():
    libs = cached("steaml", 600, steam_libs)
    if not libs:
        return [("note", "steam libraries not found", False)]
    sizes = CACHE.get("steamdu", (0, {}))[1]
    rows = [("meter", "LIBRARIES", 0, str(len(libs)), "steam libraries")]
    for p in libs[:9]:
        s = sizes.get(p)
        rows.append(("cardlist", p.replace(os.path.expanduser("~"), "~")[-34:],
                     [("size", fmt_size(s) if s else "—")]))
    return rows


def glib_measure():
    libs = steam_libs()
    sizes = {}
    tot = 0
    for p in libs:
        s = lib_du(p)
        if s:
            sizes[p] = s
            tot += s
    CACHE["steamdu"] = (time.time(), sizes)
    CACHE["steamtot"] = (time.time(), tot)
    return glib_page()


