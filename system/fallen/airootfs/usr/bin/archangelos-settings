def audio_page():
    info = run(["pactl", "info"], 1.0)
    sink = re.search(r"Default Sink: (.+)", info)
    src = re.search(r"Default Source: (.+)", info)
    rows = [("switch", "DEFAULT SINK", sink.group(1).strip() if sink else "—",
             ACCENT if sink else QColor(30, 29, 27), "pactl default sink"),
            ("switch", "DEFAULT SOURCE", src.group(1).strip() if src else "—",
             ACCENT if src else QColor(30, 29, 27), "pactl default source")]
    vol = run(["pactl", "get-sink-volume", "@DEFAULT_SINK@"], 0.8)
    m = re.search(r"(\d+)%", vol)
    if m:
        rows.append(("bar", "VOLUME", int(m.group(1)) / 100.0, m.group(1) + "%"))
    mute = run(["pactl", "get-sink-mute", "@DEFAULT_SINK@"], 0.6)
    rows.append(("switch", "MUTE", "on" if "yes" in mute else "off",
                 NEON_HI if "yes" in mute else ACCENT, "sink mute state"))
    out = run(["pactl", "list", "short", "sinks"], 1.0)
    rows.append(("kv", "SINKS", str(len(out.splitlines()))))
    return rows


def power_page():
    cap, st, ac = battery_info()
    rows = []
    if cap is not None:
        rows.append(("donut", "BATTERY", cap / 100.0, "%d%%" % cap, st or "—"))
    rows.append(("switch", "AC", "connected" if ac else ("offline" if ac is False else "—"),
                 ACCENT if ac else QColor(30, 29, 27), "power supply"))
    prof = power_profile()
    rows.append(("switch", "PROFILE", prof.upper(),
                 NEON_HI if prof == "performance" else ACCENT,
                 "powerprofilesctl — phase 2"))
    name, frac = brightness_info()
    if frac is not None:
        rows.append(("bar", "BRIGHTNESS", frac, "%d%%" % (frac * 100)))
    try:
        gov = open("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor",
                   encoding="utf-8").read().strip()
        rows.append(("kv", "CPU GOVERNOR", gov))
    except Exception:
        pass
    return rows


