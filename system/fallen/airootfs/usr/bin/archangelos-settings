def displays_page():
    rows = []
    for s in QApplication.screens():
        g = s.geometry()
        rows.append(("cardlist", s.name(),
                     [("mode", "%dx%d" % (g.width(), g.height())),
                      ("refresh", "%.0f Hz" % s.refreshRate())]))
    name, frac = brightness_info()
    if frac is not None:
        rows.append(("bar", "BRIGHTNESS " + (name or ""), frac, "%d%%" % (frac * 100)))
    return rows or [("kv", "SCREEN", "—")]


