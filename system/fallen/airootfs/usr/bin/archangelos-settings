def spoof_page():
    rows = []
    for dev, mac, perm in mac_info()[:5]:
        rows.append(("switch", dev.upper(), mac + (" · SPOOFED" if perm else ""),
                     ACCENT, "mac address"))
    try:
        mid = open("/etc/machine-id", encoding="utf-8").read().strip()
        rows.append(("kv", "MACHINE-ID", mid[:16] + "…"))
    except Exception:
        pass
    rows.append(("note", "spoof actions + log hygiene — phase 3", False))
    return rows


def maintenance_page():
    pkg_out = run(["du", "-sh", "/var/cache/pacman/pkg"], 2.0)
    orph = run(["pacman", "-Qdtq"], 5)
    j = run(["journalctl", "--disk-usage"], 2.0)
    m = re.search(r"take up (.+)", j)
    rows = [("switch", "PKG CACHE", pkg_out.split()[0] if pkg_out else "—", ACCENT),
            ("switch", "ORPHANS", str(len(orph.splitlines())) if orph.strip() else "0", ACCENT),
            ("switch", "JOURNAL", m.group(1) if m else (j[:30] if j else "—"), ACCENT)]
    rows.append(("note", "clean actions — phase 3", False))
    return rows


def diagnostics_page():
    out = run(["systemctl", "--failed", "--no-legend"], 1.5).splitlines()
    rows = [("meter", "FAILED UNITS", 0, str(len(out)), "systemd failures")]
    for l in out[:6]:
        rows.append(("switch", "FAILED", l.split()[0][:34], NEON_HI, "failed unit"))
    err = run(["journalctl", "-p", "3", "-n", "5", "--no-pager", "-o", "short"], 2.0)
    for l in [x for x in err.splitlines() if x.strip()][-4:]:
        rows.append(("note", l[5:76], True))
    return rows


def logs_page():
    out = run(["journalctl", "-n", "8", "--no-pager", "-o", "short"], 2.0)
    lines = [l for l in out.splitlines() if l.strip()]
    rows = [("meter", "ENTRIES", 0, str(len(lines)), "journal tail")]
    for l in lines[-6:]:
        rows.append(("note", l[5:80], " E " in l[:20]))
    return rows or [("note", "journal unavailable", False)]


