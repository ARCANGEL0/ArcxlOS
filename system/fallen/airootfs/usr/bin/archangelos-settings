            ("kv", "HISTORY", str(hist))]


def keybinds_page():
    binds = cached("binds", 30, hypr_binds)
    rows = []
    cats = {"exec": [], "workspace": [], "window": [], "float": [], "misc": []}
    for mods, key, action in binds:
        a = action.lower()
        if "exec" in a or "spawn" in a:
            cats["exec"].append((mods, key, action))
        elif "workspace" in a:
            cats["workspace"].append((mods, key, action))
        elif any(w in a for w in ("focus", "move", "resize", "center", "toggle")):
            cats["window"].append((mods, key, action))
        elif any(w in a for w in ("float", "pseudo", "tile")):
            cats["float"].append((mods, key, action))
        else:
            cats["misc"].append((mods, key, action))
    for cat_name in ("exec", "workspace", "window", "float", "misc"):
        items = cats[cat_name]
        if not items:
            continue
        rows.append(("grid", cat_name.upper(),
                     [("bind", "%s+%s" % (m, k), QColor(60, 180, 255))
                      for m, k, a in items[:6]]))
    rows.append(("note", "edit / delete / create binds — phase 2", True))
    return rows


def users_page():
