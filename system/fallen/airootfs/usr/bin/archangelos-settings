class MainWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Archangel Settings")
        self.mono = mono_family()
        self.display = display_family()
        self.NAV = build_nav()
        self.active = "overview"
        self.hover_key = None
        self.dossier = Dossier(self)
        self.dossier.on_chip = lambda: self.select("updates", "Updates")
        self.search = QLineEdit(self.dossier)
        self.search.setPlaceholderText("search settings…")
        self.search.setFixedWidth(190)
        self.search.textChanged.connect(self._on_search)
        self.search.returnPressed.connect(self._on_search_go)
        self.search.setStyleSheet(
            "QLineEdit { background: #0d0d0c; color: #ECEAE4; border: 1px solid #262523;"
            " padding: 6px 10px; font: 9pt;} QLineEdit:focus { border-color: #f01010; }")
        self.nav_rects = []
        self.nav_items = []
        self.nav_scroll = 0
        self.nav_h = 0
        self.setMouseTracking(True)
        self.resize(1500, 940)
        self.setMinimumSize(1180, 780)
        self._place()

    def _place(self):
        self.dossier.setGeometry(SIDE_W, 0, self.width() - SIDE_W, self.height())
        self.search.move(self.dossier.width() - 226, 14)

    def _on_search(self, text):
        self.dossier.search = text.strip().lower()
        self.nav_scroll = 0
        self.dossier.update()
        self.update()

    def _on_search_go(self):
        t = self.dossier.search
        for _, items in self.NAV:
            for label, key in items:
                if t in label.lower():
                    self.select(key, label)
                    return

    def select(self, key, label):
        self.active = key
        self.dossier.set_page(key, label)
        for cy, k in self.nav_items:
            if k == key:
                win = self.height() - 210
                if cy - self.nav_scroll < 130 or cy - self.nav_scroll > win:
                    self.nav_scroll = _clamp(cy - 160, 0,
                                             max(0, self.nav_h - (self.height() - 200)))
                break
        self.dossier.update()
        self.update()

    def resizeEvent(self, event):
        self._place()

    def wheelEvent(self, event):
        if event.position().x() < SIDE_W:
            d = event.angleDelta().y() / 120.0 * 48
            self.nav_scroll = _clamp(self.nav_scroll - d, 0,
                                     max(0, self.nav_h - (self.height() - 200)))
            self.update()
        else:
            event.ignore()

    def mouseMoveEvent(self, event):
        pos = event.position()
        hk = None
        for rect, key, _ in self.nav_rects:
            if rect.contains(pos):
                hk = key
                break
        if hk != self.hover_key:
            self.hover_key = hk
            self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        W, H = self.width(), self.height()
        p.fillRect(self.rect(), BG)

        # left sidebar — full-height frosted surface with subtle gradient
        side = QRectF(0, 0, SIDE_W, H)
        grad = QLinearGradient(side.topLeft(), side.topRight())
        grad.setColorAt(0, QColor(8, 8, 8, 230))
        grad.setColorAt(1, QColor(12, 12, 11, 230))
        p.setBrush(QBrush(grad))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawRoundedRect(side, 0, 0)
        p.setPen(QPen(QColor(40, 39, 37, 160), 1.0))
        p.drawLine(QPointF(SIDE_W, 0), QPointF(SIDE_W, H))

        y = 28
        f_logo = QFont(self.display, 17, QFont.Weight.Bold)
        f_logo.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 1.8)
        p.setFont(f_logo)
        p.setPen(QPen(TEXT, 1.0))
        p.drawText(QPointF(30, y + 16), "ARCHANGEL")
        p.setPen(QPen(ACCENT, 1.0))
        p.setFont(f_logo)
        p.drawText(QPointF(212, y + 16), "†")
        p.setFont(QFont(self.mono, 7))
        p.setPen(QPen(FAINT, 1.0))
        p.drawText(QPointF(30, y + 36), "// settings · control center")
        p.setPen(QPen(ACCENT, 1.0))
        p.drawLine(QPointF(30, y + 56), QPointF(56, y + 56))

        content_y = y + 82
        self.nav_rects = []
        self.nav_items = []
        vis = self.dossier.search
        nav_bottom = H - 108
        for group, items in self.NAV:
            if vis and not any(vis in lab.lower() for lab, _ in items):
                continue
            gy = content_y - self.nav_scroll
            if -24 < gy < nav_bottom:
                p.setFont(QFont(self.mono, 6, QFont.Weight.Bold))
                p.setPen(QPen(QColor(110, 108, 104, 150), 1.0))
                p.drawText(QPointF(30, gy + 10), group)
                p.setPen(QPen(QColor(30, 29, 27), 1.0))
                p.drawLine(QPointF(30, gy + 18), QPointF(SIDE_W - 30, gy + 18))
            content_y += 34
            for label, key in items:
                if vis and vis not in label.lower():
                    continue
                iy = content_y - self.nav_scroll
                self.nav_items.append((content_y, key))
                if -34 < iy < nav_bottom:
                    sel = key == self.active
                    hov = key == self.hover_key and not sel
                    pill = QRectF(22, iy + 2, SIDE_W - 44, 28)
                    if sel:
                        g2 = QLinearGradient(pill.topLeft(), pill.bottomLeft())
                        g2.setColorAt(0, QColor(240, 16, 16, 95))
                        g2.setColorAt(1, QColor(240, 16, 16, 35))
                        p.setBrush(QBrush(g2))
                        p.setPen(Qt.PenStyle.NoPen)
                        p.drawRoundedRect(pill, 9, 9)
                    elif hov:
                        p.setBrush(QBrush(QColor(22, 22, 21, 170)))
                        p.setPen(Qt.PenStyle.NoPen)
                        p.drawRoundedRect(pill, 9, 9)
                    p.setFont(QFont(self.mono, 9, QFont.Weight.Bold))
                    p.setPen(QPen(TEXT if sel else (QColor(190, 188, 183) if hov
                                                    else QColor(150, 148, 144)), 1.0))
                    p.drawText(QPointF(36, iy + 22), label)
                    self.nav_rects.append((QRectF(22, iy + 2, SIDE_W - 44, 28), key, label))
                content_y += 30
            content_y += 10
        self.nav_h = content_y + 10

        # bottom strip — edition + kernel
        p.setPen(QPen(QColor(34, 33, 31), 1.0))
        p.drawLine(QPointF(30, H - 104), QPointF(SIDE_W - 30, H - 104))
        fm = QFontMetrics(p.font())
        p.setFont(QFont(self.mono, 7))
        p.setPen(QPen(QColor(110, 108, 104), 1.0))
        p.drawText(QPointF(30, H - 84), edition_name().upper())
        w = fm.horizontalAdvance(edition_name().upper() + "  ")
        p.setPen(QPen(ACCENT, 1.0))
        p.drawText(QPointF(30 + w, H - 84), "KERNEL " + os.uname().release)

        p.save()
        p.translate(16, H - 44)
        p.rotate(-90)
        p.setFont(QFont(self.mono, 6))
        p.setPen(QPen(QColor(60, 59, 57, 95), 1.0))
        p.drawText(0, 0, "ARCHANGEL SETTINGS · PHASE 1 · READ-ONLY")
        p.restore()

    def mousePressEvent(self, event):
        pos = event.position()
        for rect, key, label in self.nav_rects:
            if rect.contains(pos):
                self.select(key, label)
                return


def main():
    sys.excepthook = lambda t, v, tb: traceback.print_exception(t, v, tb)
    app = QApplication(sys.argv)
    app.setApplicationName("Archangel Settings")
    win = MainWindow()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
