#!/bin/sh
cfg=/usr/share/archangelos/wheel/qml/shell.qml
run="${XDG_RUNTIME_DIR:-/tmp}"
pid=$(cat "$run/archangelos-wheel.pid" 2>/dev/null)
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    qs -p "$cfg" ipc call wheel toggle >/dev/null 2>&1 && exit 0
fi
pgrep -u "$(id -u)" -f "^qs -p $cfg" >/dev/null 2>&1 && {
    qs -p "$cfg" ipc call wheel toggle >/dev/null 2>&1 && exit 0
}
ARCHANGELOS_WHEEL_SHOW=1 setsid -f qs -p "$cfg" >/dev/null 2>&1
