COLOR_SLICE_BASE = "#141a26"
COLOR_SLICE_HOVER = "#241f33"
COLOR_ACCENT = "#f85149"
COLOR_ACCENT2 = "#00f3ff"
COLOR_TEXT = "#f0f6fc"
COLOR_MUTED = "#8b949e"
COLOR_BORDER = "#2b3548"

LOGO_PATH = "/usr/share/sddm/themes/archangelos/assets/logo.png"

