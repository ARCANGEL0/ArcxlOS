    QPixmap, QImage, QFont, QFontDatabase, QColor, QPainter, QPen, QBrush,
    QGuiApplication, QKeySequence, QShortcut, QPainterPath, QRadialGradient,
    QLinearGradient, QFontMetrics, QCursor
)
from PyQt6.QtWidgets import QApplication, QWidget

try:
    from PyQt6.QtSvg import QSvgRenderer
except Exception:  # pragma: no cover
    QSvgRenderer = None

# --- Palette (matches the desktop shell: src/PrefsService overrides) ----------
BG          = QColor(8, 8, 8)            # #080808 matte near-black
SURFACE     = QColor(16, 16, 16)         # #101010
SURFACE_HI  = QColor(26, 26, 25)         # #1a1a19
OUTLINE     = QColor(46, 45, 43)         # #2e2d2b hairline
ACCENT      = QColor(194, 74, 82)        # #C24A52 crimson
ACCENT_DIM  = QColor(194, 74, 82, 70)
TEXT        = QColor(236, 234, 228)      # #ECEAE4
SUBTEXT     = QColor(138, 136, 132)      # #8a8884
STEEL       = QColor(185, 182, 174)      # #B9B6AE
BLADE       = QColor(120, 128, 140)      # cold steel for the katana stroke

SWORD_SVG = "/usr/share/archangelos/wheel/sword.svg"   # the archangel sword, centre of the wheel
# where the art sits inside that file's 590 x 590 canvas: x, y, width, height
SWORD_BOX = (114, 0, 359, 587)


def _emblem_svg():
    """Michael's sword: an upright steel blade with spread archangel wings.
    Built symmetrically — the right wing is drawn, then mirrored to the left."""
    cx = 120.0
    # right-wing feathers: (tip_x, tip_y, belly_dx, belly_dy) long → short, high → low
    feathers = [
        (214, 84, -8, 20),
        (198, 96, -8, 20),
        (182, 108, -7, 19),
        (165, 118, -7, 18),
        (149, 126, -6, 16),
    ]
    root = (131, 126)
    # one wing as an SVG path, mirrored about cx when sgn = -1
    def wing(sgn):
        mx = lambda x: cx + sgn * (x - cx)
        tx, ty = feathers[0][0], feathers[0][1]
        d = [f"M {mx(root[0]):.1f} {root[1]:.1f}"]
        # upper edge: smooth sweep from the root out to the top feather tip
        d.append(f"C {mx(150):.1f} 96 {mx(188):.1f} 82 {mx(tx):.1f} {ty:.1f}")
        # lower edge: a rounded belly per feather, stepping back toward the root
        for (fx, fy, bdx, bdy) in feathers[1:]:
            d.append(f"Q {mx(fx + bdx):.1f} {fy + bdy:.1f} {mx(fx):.1f} {fy:.1f}")
        d.append(f"L {mx(root[0]):.1f} {root[1]:.1f} Z")
        return " ".join(d)
    # feather separator lines, one wing
    def quills(sgn):
        mx = lambda x: cx + sgn * (x - cx)
        out = []
        for (fx, fy, _, _) in feathers[1:4]:
            out.append(f'<path d="M {mx(root[0]):.1f} {root[1]:.1f} '
                       f'L {mx(fx):.1f} {fy:.1f}" stroke="#4a1418" '
                       f'stroke-width="1.4" fill="none" opacity="0.5"/>')
        return "".join(out)
    return f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 220">
  <defs>
    <linearGradient id="steel" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#969EAA"/><stop offset="0.5" stop-color="#F2F4F7"/>
      <stop offset="1" stop-color="#788090"/>
    </linearGradient>
    <linearGradient id="wing" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D8626C"/><stop offset="1" stop-color="#7A2228"/>
    </linearGradient>
  </defs>
  <g fill="url(#wing)" stroke="#EC9A9C" stroke-width="1.2" stroke-linejoin="round">
    <path d="{wing(1)}"/><path d="{wing(-1)}"/>
  </g>
  {quills(1)}{quills(-1)}
  <!-- blade -->
  <path d="M 120 20 L 128 78 L 123.5 150 L 116.5 150 L 112 78 Z"
        fill="url(#steel)" stroke="#C24A52" stroke-width="1.4" stroke-linejoin="round"/>
  <line x1="120" y1="30" x2="120" y2="148" stroke="#FFFFFF" stroke-width="1.1" opacity="0.8"/>
  <!-- crossguard -->
  <path d="M 90 150 Q 85 141 99 146 L 141 146 Q 155 141 150 150 Q 120 160 90 150 Z"
        fill="url(#steel)" stroke="#C24A52" stroke-width="1.2" stroke-linejoin="round"/>
  <!-- grip + pommel -->
  <rect x="115.5" y="150" width="9" height="26" rx="3" fill="#8A9099" stroke="#C24A52" stroke-width="1"/>
  <path d="M 120 178 L 127 186 L 120 194 L 113 186 Z" fill="#C24A52" stroke="#ECEAE4" stroke-width="1.2"/>
</svg>'''


EMBLEM_SVG = _emblem_svg()

