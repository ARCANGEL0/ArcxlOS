def cursor_position(argv):
    """Global cursor position: `--at=X,Y`, else hyprctl, else Qt's (stale on Wayland)."""
    for a in argv[1:]:
        if a.startswith("--at="):
            try:
                x, y = a[5:].split(",")
                return QPointF(float(x), float(y))
            except ValueError:
                pass
    try:
        out = subprocess.run(["hyprctl", "cursorpos", "-j"], capture_output=True,
                             text=True, timeout=0.6).stdout
        j = json.loads(out)
        return QPointF(float(j["x"]), float(j["y"]))
    except Exception:
        pass
    return QPointF(QCursor.pos())


def mono_family():
    """Prefer JetFrames Mono (the shell's font); fall back to any monospace."""
    for fam in ("JetFramesMono Nerd Font", "JetFramesMonoNL Nerd Font",
                "JetFrames Mono", "DepartureMono", "Noto Sans Mono"):
        if fam in QFontDatabase.families():
            return fam
    return "monospace"


def parse_desktop_file(path):
    """Parse a .desktop file and return (name, exec, categories, icon) or None."""
    try:
        name = exec_cmd = categories = icon = ""
        with open(path, encoding="utf-8", errors="ignore") as f:
            in_main = True
            for line in f:
                line = line.strip()
                if line.startswith("[") and line.endswith("]"):
                    in_main = (line == "[Desktop Entry]")
                    continue
                if not in_main or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                if key == "Name":
                    name = value
                elif key == "Exec":
                    exec_cmd = value
                elif key == "Categories":
                    categories = value
                elif key == "Icon":
                    icon = value
        if not name or not exec_cmd:
            return None
        if os.path.basename(path).startswith("archangelos-"):
            return None
        return (name, exec_cmd, categories, icon)
    except Exception:
        return None


def build_tool_catalog():
    """Build category -> [(name, exec, icon)] from installed .desktop files."""
    catalog = {}
    seen = set()
    for d in DESKTOP_DIRS:
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".desktop"):
                continue
            path = os.path.join(d, fn)
            parsed = parse_desktop_file(path)
            if parsed is None:
                continue
            name, exec_cmd, categories, icon = parsed
            key = name.lower()
            if key in seen:
                continue
            seen.add(key)
            haystack = f"{categories} {name}"
            category = None
            for pattern, friendly in CATEGORY_RULES:
                if re.search(pattern, haystack, re.IGNORECASE):
                    category = friendly
                    break
            if category is None:
                category = "Utility & Misc"
            catalog.setdefault(category, []).append((name, exec_cmd, icon))
    for category, tools in FALLBACK_TOOLS.items():
        if category not in catalog or not catalog[category]:
            catalog[category] = [(n, e, "") for (n, e) in tools]
    return catalog


def launch_tool(exec_cmd):
    """Launch a tool's Exec command detached from this process."""
    cmd = exec_cmd
    for tok in (" %F", " %f", " %U", " %u", " %D", " %d",
                " %N", " %n", " %i", " %c", " %k", " %m"):
        cmd = cmd.replace(tok, "")
    try:
        subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def _lerp(a, b, t):
    return a + (b - a) * t


def _lerp_pt(a, b, t):
    return QPointF(a.x() + (b.x() - a.x()) * t, a.y() + (b.y() - a.y()) * t)


def _ease_out(t):
    return 1.0 - (1.0 - t) ** 3


def _clamp01(t):
    return 0.0 if t < 0 else (1.0 if t > 1 else t)


class WheelView(QWidget):
    """Radial donut of security-tool categories; clicking one expands it into an
    arsenal of app nodes wired to the category by PCB-style traces."""

    def __init__(self, categories, mono, parent=None):
        super().__init__(parent)
        self.categories = sorted(categories.keys())
        self.catalog = categories
        self.counts = {c: len(categories[c]) for c in self.categories}
        self.parent_window = parent
        self.mono = mono
        self.hover_index = 0
        self.setMouseTracking(True)
        self.phase = 0.0
        # Mini wheel, fixed pixel size, drawn around a cursor-anchored centre.
        self.outer = 136
        self.inner = 78
        self.center = None            # QPointF in widget coords; set on open
        self._emblem = None
        self._emblem_px = 0
        # --- expansion state ---
        self.expanding = False        # True while a category is (or is becoming) open
        self.anim = 0.0               # 0 = wheel, 1 = fully expanded
        self.sel = 0                  # expanded category index
        self.app_sel = 0             # highlighted app node
        self.layout = None            # geometry of the expanded arsenal
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._tick)
        self._timer.start(16)
        self._last = None

    def _tick(self):
        now = time.monotonic()
        dt = 0.016 if self._last is None else min(0.05, now - self._last)
        self._last = now
        target = 1.0 if self.expanding else 0.0
        if self.anim != target:
            step = dt / 0.42            # ~0.42 s to open/close
            if self.anim < target:
                self.anim = min(target, self.anim + step)
            else:
                self.anim = max(target, self.anim - step)
            if self.anim == 0.0 and not self.expanding:
                self.layout = None
        self.phase += 0.04
        self.update()

    def set_center(self, pt):
        self.center = pt
        self.update()

    # --- geometry ----------------------------------------------------------
    def _metrics(self):
        if self.center is not None:
            cx, cy = self.center.x(), self.center.y()
        else:
            cx, cy = self.width() / 2, self.height() / 2
        return cx, cy, self.outer, self.inner

    def slice_at(self, pos):
        cx, cy, outer, inner = self._metrics()
        dx, dy = pos.x() - cx, pos.y() - cy
        dist = math.hypot(dx, dy)
        if dist < inner * 0.82 or dist > outer * 1.08:
            return -1
        angle = math.degrees(math.atan2(dy, dx)) + 90.0  # 0 at top
        angle %= 360
        n = len(self.categories)
        span = 360.0 / n
        idx = int((angle + span / 2) % 360 / span)
        return idx if 0 <= idx < n else -1

    # --- wheel-mode navigation ---------------------------------------------
    def move_selection(self, step):
        if self.expanding:
            return
        n = len(self.categories)
        if n:
            self.hover_index = (self.hover_index + step) % n
            self.update()

    def current_category(self):
        if 0 <= self.hover_index < len(self.categories):
            return self.categories[self.hover_index]
        return None

    # --- expansion ---------------------------------------------------------
    def open_category(self, index):
        self.sel = index
        self.hover_index = index
        self.app_sel = 0
        self.layout = self._compute_layout(index)
        self.expanding = True
        self.update()

    def collapse(self):
        self.expanding = False
        self.update()

    def move_app(self, step):
        if not self.expanding or not self.layout:
            return
        n = len(self.layout["chips"])
        if n:
            self.app_sel = max(0, min(n - 1, self.app_sel + step))
            self.update()

    def activate(self):
        """Launch the highlighted app (expanded) or open the category (wheel)."""
        if self.expanding and self.layout:
            chips = self.layout["chips"]
            if 0 <= self.app_sel < len(chips):
                self._launch(chips[self.app_sel]["exec"])
        else:
            self.open_category(self.hover_index)

    def _launch(self, exec_cmd):
        if exec_cmd:
            launch_tool(exec_cmd)
            if self.parent_window is not None:
                self.parent_window.close()

    def _compute_layout(self, index):
        O = QPointF(self.center) if self.center is not None \
            else QPointF(self.width() / 2, self.height() / 2)
        R, r = self.outer, self.inner
        n = len(self.categories)
        span = 360.0 / n
        mid = math.radians(index * span - 90)
        dx, dy = math.cos(mid), math.sin(mid)
        label_r = (R + r) / 2.0
        back, pop = 54, 30

        btn_from = QPointF(O.x() + dx * label_r, O.y() + dy * label_r)
        wheel_to = QPointF(O.x() - dx * back, O.y() - dy * back)
        btn_to = QPointF(wheel_to.x() + dx * (R + pop), wheel_to.y() + dy * (R + pop))

        apps = self.catalog[self.categories[index]]
        CW, CH, GAP = 198, 34, 9
        N = len(apps)
        col_h = N * CH + (N - 1) * GAP
        apps_c = QPointF(wheel_to.x() + dx * (R + 190), wheel_to.y() + dy * (R + 190))
        chips = []
        for j, (name, exe, icon) in enumerate(apps):
            cyj = apps_c.y() - col_h / 2 + CH / 2 + j * (CH + GAP)
            chips.append({"rect": QRectF(apps_c.x() - CW / 2, cyj - CH / 2, CW, CH),
                          "name": name, "exec": exe})

        # fit the whole composition on screen
        xs = [wheel_to.x() - R, wheel_to.x() + R, btn_to.x() - 60, btn_to.x() + 60]
        ys = [wheel_to.y() - R, wheel_to.y() + R, btn_to.y() - 30, btn_to.y() + 30]
        for c in chips:
            xs += [c["rect"].left(), c["rect"].right()]
            ys += [c["rect"].top(), c["rect"].bottom()]
        m = 26
        W, H = self.width(), self.height()
        tx = ty = 0.0
        if min(xs) < m:
            tx = m - min(xs)
        if max(xs) + tx > W - m:
            tx -= (max(xs) + tx) - (W - m)
        if min(ys) < m:
            ty = m - min(ys)
        if max(ys) + ty > H - m:
            ty -= (max(ys) + ty) - (H - m)

        wheel_to = QPointF(wheel_to.x() + tx, wheel_to.y() + ty)
        btn_to = QPointF(btn_to.x() + tx, btn_to.y() + ty)
        for c in chips:
            c["rect"] = c["rect"].translated(tx, ty)
            cen = c["rect"].center()
            if cen.x() >= btn_to.x():
                c["node"] = QPointF(c["rect"].left(), cen.y())
            else:
                c["node"] = QPointF(c["rect"].right(), cen.y())
        return {"index": index, "d": (dx, dy), "btn_from": btn_from,
                "btn_to": btn_to, "wheel_to": wheel_to, "chips": chips}

    # --- input -------------------------------------------------------------
    def enterEvent(self, event):
        if self.parent_window is not None:
            self.parent_window.on_pointer_enter(event.position())
        super().enterEvent(event)

    def mouseMoveEvent(self, event):
        if self.expanding and self.layout and self.anim > 0.5:
            for j, c in enumerate(self.layout["chips"]):
                if c["rect"].contains(event.position()):
                    if self.app_sel != j:
                        self.app_sel = j
                        self.update()
                    break
            return
        idx = self.slice_at(event.position())
        if idx >= 0 and idx != self.hover_index:
            self.hover_index = idx
            self.update()

    def mousePressEvent(self, event):
        if self.parent_window is None:
            return
        pos = event.position()
        if self.expanding and self.layout:
            if self.anim > 0.5:
                for c in self.layout["chips"]:
                    if c["rect"].contains(pos):
                        self._launch(c["exec"])
                        return
            self.collapse()
            return
        idx = self.slice_at(pos)
        if idx >= 0:
            self.open_category(idx)
        else:
            cx, cy, outer, _ = self._metrics()
            if math.hypot(pos.x() - cx, pos.y() - cy) > outer * 1.08:
                self.parent_window.close()

    # --- painting ----------------------------------------------------------
    def _segment_path(self, cx, cy, outer, inner, a0, a1):
        path = QPainterPath()
        orect = QRectF(cx - outer, cy - outer, outer * 2, outer * 2)
        irect = QRectF(cx - inner, cy - inner, inner * 2, inner * 2)
        qa0 = 90 - a0
        span = -(a1 - a0)
        path.arcMoveTo(orect, qa0)
        path.arcTo(orect, qa0, span)
        path.arcTo(irect, qa0 + span, -span)
        path.closeSubpath()
        return path

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        cx, cy, outer, inner = self._metrics()

        if self.layout and self.anim > 0.001:
            self._paint_expanded(p, outer, inner)
        else:
            wc = QPointF(cx, cy)
            self._draw_wheel(p, wc, 1.0, 1.0, skip=None)
            self._draw_caption(p, wc, outer, self.current_category())
        p.end()

    def _draw_wheel(self, p, wc, scale, alpha, skip):
        cx, cy = wc.x(), wc.y()
        outer = self.outer * scale
        inner = self.inner * scale
        n = max(len(self.categories), 1)
        span = 360.0 / n
        gap = min(2.6, span * 0.10)
        glyph_font = QFont(self.mono, int(13 * scale))
        label_r = inner + (outer - inner) * 0.56

        for i, category in enumerate(self.categories):
            if skip is not None and i == skip:
                continue
            c0 = i * span - span / 2 + gap / 2
            c1 = i * span + span / 2 - gap / 2
            hovered = (skip is None and i == self.hover_index)
            seg = self._segment_path(cx, cy, outer, inner, c0, c1)
            if hovered:
                grad = QRadialGradient(cx, cy, outer)
                grad.setColorAt(inner / outer, self._a(QColor(74, 27, 30), alpha))
                grad.setColorAt(1.0, self._a(QColor(126, 40, 45), alpha))
                p.setBrush(QBrush(grad))
                p.setPen(QPen(self._a(ACCENT, alpha), 1.4))
            else:
                grad = QRadialGradient(cx, cy, outer)
                grad.setColorAt(inner / outer, self._a(QColor(22, 22, 22), alpha))
                grad.setColorAt(1.0, self._a(QColor(32, 32, 31), alpha))
                p.setBrush(QBrush(grad))
                p.setPen(QPen(self._a(OUTLINE, alpha), 1.0))
            p.drawPath(seg)
            # thin accent tick on the outer edge of the hovered spoke
            if hovered:
                mid = math.radians(i * span - 90)
                p.setPen(QPen(self._a(ACCENT, alpha), 2.0))
                p.drawArc(QRectF(cx - outer + 1, cy - outer + 1,
                                 (outer - 1) * 2, (outer - 1) * 2),
                          int((90 - c1) * 16), int((c1 - c0) * 16))

            mid = math.radians(i * span - 90)
            lx = cx + label_r * math.cos(mid)
            ly = cy + label_r * math.sin(mid)
            p.setFont(glyph_font)
            p.setPen(self._a(TEXT if hovered else STEEL, alpha))
            p.drawText(QRectF(lx - 18, ly - 13, 36, 26),
                       Qt.AlignmentFlag.AlignCenter,
                       CATEGORY_GLYPH.get(category, DEFAULT_GLYPH))

        self._draw_hub(p, cx, cy, inner, alpha)

    def _draw_hub(self, p, cx, cy, inner, alpha):
        hub = inner * 0.82
        p.setBrush(Qt.BrushStyle.NoBrush)
        ring = QPen(self._a(ACCENT_DIM, alpha), 1.0)
        ring.setStyle(Qt.PenStyle.DashLine)
        p.setPen(ring)
        p.drawEllipse(QPointF(cx, cy), hub * 1.02, hub * 1.02)
        p.setPen(QPen(self._a(ACCENT, alpha), 1.2))
        for a in (0, 90, 180, 270):
            rr = math.radians(a + self.phase * 18)
            p.drawLine(QPointF(cx + hub * 0.92 * math.cos(rr), cy + hub * 0.92 * math.sin(rr)),
                       QPointF(cx + hub * 1.10 * math.cos(rr), cy + hub * 1.10 * math.sin(rr)))
        self._draw_sword(p, cx, cy, inner, alpha)

    def _draw_caption(self, p, wc, outer, cat):
        if not cat:
            return
        cx, cy = wc.x(), wc.y()
        p.setFont(QFont(self.mono, 9, QFont.Weight.Bold))
        p.setPen(TEXT)
        p.drawText(QRectF(cx - 160, cy + outer + 8, 320, 16),
                   Qt.AlignmentFlag.AlignCenter, cat.upper())
        p.setFont(QFont(self.mono, 7))
        p.setPen(ACCENT)
        p.drawText(QRectF(cx - 160, cy + outer + 24, 320, 14),
                   Qt.AlignmentFlag.AlignCenter, f"{self.counts[cat]:02d} tools")

    # --- expanded view -----------------------------------------------------
    def _paint_expanded(self, p, outer, inner):
        lay = self.layout
        e = _ease_out(self.anim)
        O = QPointF(self.center)
        wc = _lerp_pt(O, lay["wheel_to"], e)
        scale = _lerp(1.0, 0.90, e)
        alpha = _lerp(1.0, 0.42, e)
        # the retreated wheel, dimmed, selected spoke removed
        self._draw_wheel(p, wc, scale, alpha, skip=lay["index"])

        reveal = _clamp01((self.anim - 0.28) / 0.55)
        dx, dy = lay["d"]
        pop = e * 30.0                       # how far the wedge slides out of the ring
        outer_s = self.outer * scale
        # traces leave from the outer edge of the popped wedge
        btn = QPointF(wc.x() + dx * (outer_s + pop), wc.y() + dy * (outer_s + pop))

        # traces first, so the nodes sit on top
        for j, c in enumerate(lay["chips"]):
            ca = _clamp01((self.anim - (0.40 + j * 0.05)) / 0.25)
            self._draw_trace(p, btn, c["node"], min(reveal, 0.4 + ca * 0.6))

        # app nodes
        for j, c in enumerate(lay["chips"]):
            ca = _clamp01((self.anim - (0.42 + j * 0.05)) / 0.22)
            if ca <= 0:
                continue
            self._draw_chip(p, c, ca, j == self.app_sel)

        # the selected spoke itself, kept in its wheel-wedge shape, slid out and lit
        self._draw_popped_segment(p, wc, scale, lay["index"], dx, dy, pop)

    def _draw_popped_segment(self, p, wc, scale, index, dx, dy, pop):
        """Draw the selected category as its own wheel wedge, slid out by `pop`
        along the click direction and lit — same shape it had in the ring."""
        cx, cy = wc.x(), wc.y()
        outer = self.outer * scale
        inner = self.inner * scale
        n = max(len(self.categories), 1)
        span = 360.0 / n
        gap = min(2.6, span * 0.10)
        c0 = index * span - span / 2 + gap / 2
        c1 = index * span + span / 2 - gap / 2
        seg = self._segment_path(cx, cy, outer, inner, c0, c1)
        p.save()
        p.translate(dx * pop, dy * pop)
        grad = QRadialGradient(cx, cy, outer)
        grad.setColorAt(inner / outer, QColor(96, 32, 36))
        grad.setColorAt(1.0, QColor(150, 46, 52))
        p.setBrush(QBrush(grad))
        p.setPen(QPen(ACCENT, 1.8))
        p.drawPath(seg)
        mid = math.radians(index * span - 90)
        label_r = inner + (outer - inner) * 0.56
        lx = cx + label_r * math.cos(mid)
        ly = cy + label_r * math.sin(mid)
        p.setFont(QFont(self.mono, int(13 * scale)))
        p.setPen(TEXT)
        p.drawText(QRectF(lx - 18, ly - 13, 36, 26),
                   Qt.AlignmentFlag.AlignCenter,
                   CATEGORY_GLYPH.get(self.categories[index], DEFAULT_GLYPH))
        p.restore()

    def _draw_chip(self, p, c, a, selected):
        rect = c["rect"]
        grad = QLinearGradient(rect.topLeft(), rect.bottomLeft())
        if selected:
            grad.setColorAt(0.0, self._a(QColor(58, 24, 27), a))
            grad.setColorAt(1.0, self._a(QColor(40, 18, 20), a))
            pen = QPen(self._a(ACCENT, a), 1.5)
        else:
            grad.setColorAt(0.0, self._a(QColor(26, 26, 25), a))
            grad.setColorAt(1.0, self._a(QColor(17, 17, 17), a))
            pen = QPen(self._a(OUTLINE, a), 1.0)
        p.setBrush(QBrush(grad))
        p.setPen(pen)
        p.drawRoundedRect(rect, 8, 8)
        # a small node square where the trace lands
        node = c["node"]
        p.setBrush(QBrush(self._a(ACCENT, a)))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawRect(QRectF(node.x() - 3, node.y() - 3, 6, 6))
        # name
        p.setPen(self._a(TEXT if selected else STEEL, a))
        p.setFont(QFont(self.mono, 10))
        left = rect.left() + 16 if node.x() <= rect.center().x() else rect.left() + 12
        p.drawText(QRectF(left, rect.top(), rect.width() - 24, rect.height()),
                   Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft,
                   "▸ " + c["name"])

    def _draw_trace(self, p, a, b, frac):
        if frac <= 0:
            return
        # orthogonal PCB route with a 45° chamfer at the elbow
        corner = QPointF(b.x(), a.y())
        ch = min(9.0, abs(b.x() - a.x()) / 2 or 9.0, abs(b.y() - a.y()) / 2 or 9.0)
        sx = 1 if corner.x() >= a.x() else -1
        sy = 1 if b.y() >= corner.y() else -1
        p1 = QPointF(corner.x() - sx * ch, corner.y())
        p2 = QPointF(corner.x(), corner.y() + sy * ch)
        poly = [a, p1, p2, b]
        total = sum(math.hypot(poly[i + 1].x() - poly[i].x(),
                               poly[i + 1].y() - poly[i].y()) for i in range(len(poly) - 1))
        want = total * frac
        path = QPainterPath(poly[0])
        acc = 0.0
        for i in range(len(poly) - 1):
            seg = math.hypot(poly[i + 1].x() - poly[i].x(), poly[i + 1].y() - poly[i].y())
            if acc + seg <= want or seg == 0:
                path.lineTo(poly[i + 1])
                acc += seg
            else:
                t = (want - acc) / seg
                path.lineTo(QPointF(poly[i].x() + (poly[i + 1].x() - poly[i].x()) * t,
                                    poly[i].y() + (poly[i + 1].y() - poly[i].y()) * t))
                break
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.setPen(QPen(QColor(196, 74, 82), 1.8))
        p.drawPath(path)
        # vias at both ends
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QBrush(ACCENT))
        p.drawEllipse(a, 2.4, 2.4)
        if frac >= 0.999:
            p.drawEllipse(b, 2.4, 2.4)

    # --- sword emblem ------------------------------------------------------
    def _draw_sword(self, p, cx, cy, inner, alpha):
        if QSvgRenderer is None:
            return
        size = int(inner)             # logical px
        if self._emblem is None or self._emblem_px != size:
            self._emblem = self._build_emblem(size)
            self._emblem_px = size
        pm = self._emblem
        logical = pm.width() / pm.devicePixelRatio()
        if alpha < 0.999:
            p.save()
            p.setOpacity(alpha)
            p.drawPixmap(QRectF(cx - logical / 2, cy - logical / 2, logical, logical), pm,
                         QRectF(0, 0, pm.width(), pm.height()))
            p.restore()
        else:
            p.drawPixmap(QRectF(cx - logical / 2, cy - logical / 2, logical, logical), pm,
                         QRectF(0, 0, pm.width(), pm.height()))

    def _build_emblem(self, size):
        """Render the sword art into a size x size square, supersampled, over a
        faint crimson glow. The art is 359 x 587 (tall); it is cropped to its own
        bounds and squashed to a square so it sits compactly in the hub."""
        SS = 3                        # supersample for a crisp downscale
        user_art = os.path.exists(SWORD_SVG)
        r = QSvgRenderer(SWORD_SVG) if user_art else None
        if r is None or not r.isValid() or r.viewBoxF().width() <= 0:
            r = QSvgRenderer(QByteArray(EMBLEM_SVG.encode("utf-8")))
            user_art = False
        vb = r.viewBoxF()
        bx, by, bw, bh = SWORD_BOX if user_art else (vb.x(), vb.y(), vb.width(), vb.height())

        px = size * SS
        pad = max(4, px // 6)
        full = px + 2 * pad
        fmt = QImage.Format.Format_ARGB32_Premultiplied
        art = QImage(full, full, fmt)
        art.fill(Qt.GlobalColor.transparent)
        q = QPainter(art)
        q.setRenderHint(QPainter.RenderHint.Antialiasing)
        q.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        q.translate(pad, pad)
        q.scale(px / bw, px / bh)
        q.translate(-bx, -by)
        r.render(q, vb)
        q.end()

        small = max(6, full // 6)
        glow = art.scaled(small, small, Qt.AspectRatioMode.IgnoreAspectRatio,
                          Qt.TransformationMode.SmoothTransformation)
        glow = glow.scaled(full, full, Qt.AspectRatioMode.IgnoreAspectRatio,
                           Qt.TransformationMode.SmoothTransformation)
        g = QPainter(glow)
        g.setCompositionMode(QPainter.CompositionMode.CompositionMode_SourceIn)
        g.fillRect(glow.rect(), ACCENT)
        g.end()

        out = QImage(full, full, fmt)
        out.fill(Qt.GlobalColor.transparent)
        o = QPainter(out)
        o.setOpacity(0.5)
        o.drawImage(0, 0, glow)
        o.setOpacity(1.0)
        o.drawImage(0, 0, art)
        o.end()

        pm = QPixmap.fromImage(out)
        pm.setDevicePixelRatio(SS)     # drawn at 1/SS logical px → crisp
        return pm

    @staticmethod
    def _a(color, alpha):
        if alpha >= 0.999:
            return color
        c = QColor(color)
        c.setAlpha(int(c.alpha() * alpha))
        return c


class WheelWindow(QWidget):
    """Fullscreen overlay hosting the radial wheel."""

    def __init__(self, screen, gpos):
        super().__init__()
        self.gpos = gpos
        self.screen_origin = screen.geometry().topLeft()
        self.mono = mono_family()
        self.catalog = build_tool_catalog()
        self.setWindowTitle("ArchangelOS Fallen - CyberSuite Radial Wheel")
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint |
                            Qt.WindowType.WindowStaysOnTopHint |
                            Qt.WindowType.Tool)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
        self.setGeometry(screen.geometry())
        self.setStyleSheet(f'QWidget {{ color: {TEXT.name()}; font-family: "{self.mono}"; }}')

        self.wheel_view = WheelView(self.catalog, self.mono, parent=self)

        QShortcut(QKeySequence("Esc"), self, activated=self.on_escape)
        QShortcut(QKeySequence("Return"), self, activated=self.wheel_view.activate)
        QShortcut(QKeySequence("Enter"), self, activated=self.wheel_view.activate)
        QShortcut(QKeySequence("Left"), self, activated=lambda: self.wheel_view.move_selection(-1))
        QShortcut(QKeySequence("Right"), self, activated=lambda: self.wheel_view.move_selection(1))
        QShortcut(QKeySequence("Up"), self, activated=lambda: self.wheel_view.move_app(-1))
        QShortcut(QKeySequence("Down"), self, activated=lambda: self.wheel_view.move_app(1))

        self.origin = None
        self._entered = False

    # --- placement ---------------------------------------------------------
    def _compute_origin(self, local=None):
        if local is None:
            local = QPointF(self.gpos.x() - self.screen_origin.x(),
                            self.gpos.y() - self.screen_origin.y())
        x, y = float(local.x()), float(local.y())
        r = self.wheel_view.outer
        padx, padtop, padbot = r + 24, r + 24, r + 64
        x = max(padx, min(self.width() - padx, x))
        y = max(padtop, min(self.height() - padbot, y))
        return QPointF(x, y)

    def _apply_origin(self):
        if self.origin is None:
            self.origin = self._compute_origin()
        self.wheel_view.set_center(self.origin)

    def showEvent(self, event):
        self.origin = self._compute_origin()
        self._apply_origin()
        super().showEvent(event)

    def on_pointer_enter(self, pos):
        if self._entered:
            return
        self._entered = True
        self.origin = self._compute_origin(pos)
        self._apply_origin()

    def resizeEvent(self, event):
        if not hasattr(self, "wheel_view"):
            return
        self.wheel_view.setGeometry(0, 0, self.width(), self.height())
        self._apply_origin()

    def on_escape(self):
        if self.wheel_view.expanding:
            self.wheel_view.collapse()
        else:
            self.close()


def main():
    app = QApplication(sys.argv)
    QGuiApplication.setDesktopFileName("archangelos-wheel")
    gpos = cursor_position(sys.argv)
    screen = QGuiApplication.screenAt(gpos.toPoint()) or QGuiApplication.primaryScreen()
    window = WheelWindow(screen, gpos)
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
