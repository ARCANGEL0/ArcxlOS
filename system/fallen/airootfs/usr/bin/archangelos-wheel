CATEGORY_RULES = [
    (r"blackarch-wireless|wireless|wifi|aircrack", "Wireless Attacks"),
    (r"blackarch-bluetooth|bluetooth", "Bluetooth & RF"),
    (r"blackarch-forensic|forensic", "Forensics"),
