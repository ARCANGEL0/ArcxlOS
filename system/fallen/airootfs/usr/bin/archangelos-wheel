DESKTOP_DIRS = [
    "/usr/share/applications/blackarch",
    "/usr/share/applications",
]


def mono_family():
    """Prefer JetFrames Mono (the shell's font); fall back to any monospace."""
    for fam in ("JetFramesMono Nerd Font", "JetFramesMonoNL Nerd Font",
                "JetFrames Mono", "DepartureMono", "Noto Sans Mono"):
        if fam in QFontDatabase.families():
            return fam
    return "monospace"


def parse_desktop_file(path):
    """Parse a .desktop file and return (name, exec, categories, icon) or None."""
    try:
        name = exec_cmd = categories = icon = ""
        with open(path, encoding="utf-8", errors="ignore") as f:
            in_main = True
            for line in f:
                line = line.strip()
                if line.startswith("[") and line.endswith("]"):
                    in_main = (line == "[Desktop Entry]")
                    continue
                if not in_main or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                if key == "Name":
                    name = value
                elif key == "Exec":
                    exec_cmd = value
                elif key == "Categories":
                    categories = value
                elif key == "Icon":
                    icon = value
        if not name or not exec_cmd:
            return None
        if os.path.basename(path).startswith("archangelos-"):
            return None
        return (name, exec_cmd, categories, icon)
    except Exception:
        return None


def build_tool_catalog():
    """Build category -> [(name, exec, icon)] from installed .desktop files."""
    catalog = {}
    seen = set()
    for d in DESKTOP_DIRS:
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".desktop"):
                continue
            path = os.path.join(d, fn)
            parsed = parse_desktop_file(path)
            if parsed is None:
                continue
            name, exec_cmd, categories, icon = parsed
            key = name.lower()
            if key in seen:
                continue
            seen.add(key)
            haystack = f"{categories} {name}"
            category = None
            for pattern, friendly in CATEGORY_RULES:
                if re.search(pattern, haystack, re.IGNORECASE):
                    category = friendly
                    break
            if category is None:
                category = "Utility & Misc"
            catalog.setdefault(category, []).append((name, exec_cmd, icon))
    for category, tools in FALLBACK_TOOLS.items():
        if category not in catalog or not catalog[category]:
            catalog[category] = [(n, e, "") for (n, e) in tools]
    return catalog


def launch_tool(exec_cmd):
    """Launch a tool's Exec command detached from this process."""
    cmd = exec_cmd
    for tok in (" %F", " %f", " %U", " %u", " %D", " %d",
                " %N", " %n", " %i", " %c", " %k", " %m"):
        cmd = cmd.replace(tok, "")
    try:
        subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def load_logo(size):
    """Render the ArchangelOS mark to a pixmap at the given size, or None."""
    if QSvgRenderer is not None and os.path.exists(LOGO_SVG):
        r = QSvgRenderer(LOGO_SVG)
        if r.isValid():
            img = QImage(size, size, QImage.Format.Format_ARGB32)
            img.fill(Qt.GlobalColor.transparent)
            p = QPainter(img)
            vb = r.viewBoxF()
            if vb.width() > 0 and vb.height() > 0:
                scale = min(size / vb.width(), size / vb.height()) * 0.92
                w, h = vb.width() * scale, vb.height() * scale
                r.render(p, QRectF((size - w) / 2, (size - h) / 2, w, h))
            else:
                r.render(p)
            p.end()
            return QPixmap.fromImage(img)
    if os.path.exists(LOGO_PNG):
        return QPixmap(LOGO_PNG).scaled(
            size, size, Qt.AspectRatioMode.KeepAspectRatio,
            Qt.TransformationMode.SmoothTransformation)
    return None


class WheelView(QWidget):
    """Radial donut of security-tool categories, cyber-samurai HUD."""

    def __init__(self, categories, mono, parent=None):
        super().__init__(parent)
        self.categories = sorted(categories.keys())
        self.counts = {c: len(categories[c]) for c in self.categories}
        self.parent_window = parent
        self.mono = mono
        self.hover_index = 0
        self.logo = None
        self._logo_px = 0
        self.setMouseTracking(True)
        self.phase = 0.0
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._tick)
        self._timer.start(40)

    def _tick(self):
        self.phase += 0.04
        self.update()

    # --- geometry ----------------------------------------------------------
    def _metrics(self):
        cx, cy = self.width() / 2, self.height() / 2
        outer = min(self.width(), self.height()) * 0.40
        inner = outer * 0.54
        return cx, cy, outer, inner

    def slice_at(self, pos):
        cx, cy, outer, inner = self._metrics()
        dx, dy = pos.x() - cx, pos.y() - cy
        dist = math.hypot(dx, dy)
        if dist < inner * 0.82 or dist > outer * 1.08:
            return -1
        angle = math.degrees(math.atan2(dy, dx)) + 90.0  # 0 at top
        angle %= 360
        n = len(self.categories)
        span = 360.0 / n
        idx = int((angle + span / 2) % 360 / span)
        return idx if 0 <= idx < n else -1

    def move_selection(self, step):
        n = len(self.categories)
        if n:
            self.hover_index = (self.hover_index + step) % n
            self.update()

    def current_category(self):
        if 0 <= self.hover_index < len(self.categories):
            return self.categories[self.hover_index]
        return None

    def mouseMoveEvent(self, event):
        idx = self.slice_at(event.position())
        if idx >= 0 and idx != self.hover_index:
            self.hover_index = idx
            self.update()

    def on_wheel(self, pos):
        cx, cy, outer, _ = self._metrics()
        return math.hypot(pos.x() - cx, pos.y() - cy) <= outer * 1.08

    def mousePressEvent(self, event):
        idx = self.slice_at(event.position())
        if self.parent_window is None:
            return
        if idx >= 0:
            self.hover_index = idx
            self.parent_window.open_category(self.categories[idx])
        elif not self.on_wheel(event.position()):
            self.parent_window.close()

    def _segment_path(self, cx, cy, outer, inner, a0, a1):
        path = QPainterPath()
        outer_rect = QRectF(cx - outer, cy - outer, outer * 2, outer * 2)
        inner_rect = QRectF(cx - inner, cy - inner, inner * 2, inner * 2)
        # Qt angles: 0 at 3 o'clock, CCW positive. Our a0/a1 measured from top, CW.
        qa0 = 90 - a0
        span = -(a1 - a0)
        path.arcMoveTo(outer_rect, qa0)
        path.arcTo(outer_rect, qa0, span)
        path.arcTo(inner_rect, qa0 + span, -span)
        path.closeSubpath()
        return path

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        cx, cy, outer, inner = self._metrics()
        n = max(len(self.categories), 1)
        span = 360.0 / n
        gap = min(2.6, span * 0.10)

        fam = self.mono
        label_pt = 10 if n <= 12 else (9 if n <= 16 else 8)
        label_font = QFont(fam, label_pt, QFont.Weight.Bold)
        glyph_font = QFont(fam, label_pt + 5)
        label_r = (inner + outer) / 2.0

        # soft shadow hugging the ring, so it reads on bright wallpapers too
        shadow = QRadialGradient(cx, cy, outer * 1.16)
        shadow.setColorAt(0.0, QColor(0, 0, 0, 0))
        shadow.setColorAt(inner / (outer * 1.16), QColor(0, 0, 0, 0))
        shadow.setColorAt(0.80, QColor(0, 0, 0, 120))
        shadow.setColorAt(1.0, QColor(0, 0, 0, 0))
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QBrush(shadow))
        p.drawEllipse(QPointF(cx, cy), outer * 1.16, outer * 1.16)

        for i, category in enumerate(self.categories):
            c0 = i * span - span / 2 + gap / 2
            c1 = i * span + span / 2 - gap / 2
            hovered = (i == self.hover_index)
            seg = self._segment_path(cx, cy, outer, inner, c0, c1)

            if hovered:
                grad = QRadialGradient(cx, cy, outer)
                grad.setColorAt(inner / outer, QColor(40, 18, 20))
                grad.setColorAt(1.0, QColor(90, 30, 34))
                p.setBrush(QBrush(grad))
                p.setPen(QPen(ACCENT, 1.6))
            else:
                base = QColor(SURFACE_HI)
                base.setAlpha(238)
                p.setBrush(QBrush(base))
                p.setPen(QPen(OUTLINE, 1.0))
            p.drawPath(seg)

            mid = math.radians(i * span - 90)
            lx = cx + label_r * math.cos(mid)
            ly = cy + label_r * math.sin(mid)

            # glyph above, label below — centred on the spoke's mid-radius point
            p.setFont(glyph_font)
            p.setPen(ACCENT if hovered else STEEL)
            p.drawText(QRectF(lx - 40, ly - 26, 80, 22),
                       Qt.AlignmentFlag.AlignCenter,
                       CATEGORY_GLYPH.get(category, DEFAULT_GLYPH))

            p.setFont(label_font)
            label = category.upper()
            if len(label) > 15:
                label = label[:14] + "…"
            p.setPen(TEXT if hovered else SUBTEXT)
            p.drawText(QRectF(lx - 70, ly - 4, 140, 20),
                       Qt.AlignmentFlag.AlignCenter, label)

            # count chip for the hovered spoke
            if hovered:
                p.setFont(QFont(fam, label_pt - 2))
                p.setPen(ACCENT)
                p.drawText(QRectF(lx - 70, ly + 14, 140, 16),
                           Qt.AlignmentFlag.AlignCenter,
                           f"[ {self.counts[category]:02d} ]")

        self._draw_hub(p, cx, cy, inner, fam)
        p.end()

    def _draw_hub(self, p, cx, cy, inner, fam):
        hub = inner * 0.80
        # reticle: dashed ring + crosshair ticks (the wallpaper's targeting circle)
        p.setBrush(Qt.BrushStyle.NoBrush)
        ring = QPen(ACCENT_DIM, 1.0)
        ring.setStyle(Qt.PenStyle.DashLine)
        p.setPen(ring)
        p.drawEllipse(QPointF(cx, cy), hub * 1.16, hub * 1.16)
        p.setPen(QPen(ACCENT, 1.4))
        for a in (0, 90, 180, 270):
            r = math.radians(a + self.phase * 18)
            x0 = cx + hub * 1.06 * math.cos(r)
            y0 = cy + hub * 1.06 * math.sin(r)
            x1 = cx + hub * 1.26 * math.cos(r)
            y1 = cy + hub * 1.26 * math.sin(r)
            p.drawLine(QPointF(x0, y0), QPointF(x1, y1))

        # hub plate
        plate = QRadialGradient(cx, cy - hub * 0.2, hub)
        plate.setColorAt(0, SURFACE_HI)
        plate.setColorAt(1, BG)
        p.setBrush(QBrush(plate))
        p.setPen(QPen(ACCENT, 1.6))
        p.drawEllipse(QPointF(cx, cy), hub, hub)

        # logo mark
        px = int(hub * 1.25)
        if self.logo is None or self._logo_px != px:
            self.logo = load_logo(px)
            self._logo_px = px
        if self.logo is not None:
            p.drawPixmap(int(cx - self.logo.width() / 2),
                         int(cy - self.logo.height() / 2 - hub * 0.12),
                         self.logo)
        # label
        p.setFont(QFont(fam, 10, QFont.Weight.Bold))
        p.setPen(TEXT)
        p.drawText(QRectF(cx - hub, cy + hub * 0.20, hub * 2, 18),
                   Qt.AlignmentFlag.AlignCenter, "ARSENAL")
        p.setFont(QFont(fam, 7))
        p.setPen(SUBTEXT)
        p.drawText(QRectF(cx - hub, cy + hub * 0.52, hub * 2, 14),
                   Qt.AlignmentFlag.AlignCenter,
                   f"{len(self.categories):02d} VECTORS")


class WheelWindow(QWidget):
    """Fullscreen radial wheel launcher overlay."""

    def __init__(self):
        super().__init__()
        self.mono = mono_family()
        self.catalog = build_tool_catalog()
        self.current_category = None
        self.setWindowTitle("ArchangelOS Fallen - CyberSuite Radial Wheel")
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint |
                            Qt.WindowType.WindowStaysOnTopHint |
                            Qt.WindowType.Tool)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        screen = QGuiApplication.primaryScreen().availableGeometry()
        self.setGeometry(screen)

        self.setStyleSheet(f"""
            QWidget {{ color: {TEXT.name()}; font-family: "{self.mono}"; }}
            QFrame#panel {{
                background-color: rgb(10,10,10);
                border: 1px solid {OUTLINE.name()};
                border-radius: 16px;
            }}
            QLabel#title {{ font-size: 15px; font-weight: bold; color: {ACCENT.name()};
                            letter-spacing: 1px; }}
            QLineEdit {{
                background-color: {SURFACE.name()};
                border: 1px solid {OUTLINE.name()};
                border-radius: 9px;
                padding: 9px 12px;
                font-size: 13px;
                color: {TEXT.name()};
                selection-background-color: {ACCENT.name()};
            }}
            QLineEdit:focus {{ border-color: {ACCENT.name()}; }}
            QListWidget {{
                background-color: transparent; border: none;
                font-size: 13px; outline: none;
            }}
            QListWidget::item {{ padding: 7px 10px; border-radius: 7px; color: {STEEL.name()}; }}
            QListWidget::item:selected {{ background-color: rgba(194,74,82,46);
                                          color: {TEXT.name()}; }}
            QListWidget::item:hover {{ background-color: {SURFACE_HI.name()}; }}
        """)

        self.wheel_view = WheelView(self.catalog, self.mono, parent=self)

        self.panel = QFrame(self)
        self.panel.setObjectName("panel")
        self.panel.setVisible(False)
        pl = QVBoxLayout(self.panel)
        pl.setContentsMargins(18, 16, 18, 16)
        pl.setSpacing(10)
        self.panel_title = QLabel("")
        self.panel_title.setObjectName("title")
        self.search = QLineEdit()
        self.search.setPlaceholderText("› search tools")
        self.search.textChanged.connect(self.filter_tools)
        self.search.returnPressed.connect(self.on_enter)
        self.tool_list = QListWidget()
        self.tool_list.itemActivated.connect(self.on_tool_selected)
        self.tool_list.itemDoubleClicked.connect(self.on_tool_selected)
        self.hint = QLabel("▸ open   ↑↓ move   esc back")
        self.hint.setStyleSheet(f"color:{SUBTEXT.name()}; font-size:10px;")
        pl.addWidget(self.panel_title)
        pl.addWidget(self.search)
        pl.addWidget(self.tool_list, 1)
        pl.addWidget(self.hint)

        QShortcut(QKeySequence("Esc"), self, activated=self.on_escape)
        QShortcut(QKeySequence("Return"), self, activated=self.on_enter)
        QShortcut(QKeySequence("Enter"), self, activated=self.on_enter)
        QShortcut(QKeySequence("Left"), self, activated=lambda: self._nav(-1))
        QShortcut(QKeySequence("Right"), self, activated=lambda: self._nav(1))
        QShortcut(QKeySequence("Up"), self, activated=lambda: self._nav_list(-1))
        QShortcut(QKeySequence("Down"), self, activated=lambda: self._nav_list(1))

        self.wheel_view.raise_()

    def resizeEvent(self, event):
        w, h = self.width(), self.height()
        self.wheel_view.setGeometry(0, 0, w, h)
        pw = min(560, int(w * 0.42))
        ph = min(660, int(h * 0.74))
        self.panel.setGeometry(int((w - pw) / 2), int((h - ph) / 2), pw, ph)

    # --- interaction -------------------------------------------------------
    def _nav(self, step):
        if not self.panel.isVisible():
            self.wheel_view.move_selection(step)

    def _nav_list(self, step):
        if self.panel.isVisible():
            row = self.tool_list.currentRow()
            self.tool_list.setCurrentRow(max(0, min(self.tool_list.count() - 1, row + step)))

    def keyPressEvent(self, event):
        # Type on the wheel → jump into the highlighted category and search.
        if not self.panel.isVisible():
            t = event.text()
            if t and t.isprintable() and (t.isalnum() or t == "/"):
                cat = self.wheel_view.current_category()
                if cat:
                    self.open_category(cat)
                    if t != "/":
                        self.search.setText(t)
                return
        super().keyPressEvent(event)

    def open_category(self, category):
        self.current_category = category
        glyph = CATEGORY_GLYPH.get(category, DEFAULT_GLYPH)
        self.panel_title.setText(
            f"{glyph}  {category.upper()}   — {len(self.catalog.get(category, []))} tools")
        self.search.clear()
        self.filter_tools("")
        # the panel replaces the wheel instead of sitting on top of it
        self.wheel_view.setVisible(False)
        self.panel.setVisible(True)
        self.panel.raise_()
        self.search.setFocus()
        if self.tool_list.count():
            self.tool_list.setCurrentRow(0)
        self.update()

    def show_wheel(self):
        self.panel.setVisible(False)
        self.wheel_view.setVisible(True)
        self.wheel_view.raise_()
        self.update()

    def filter_tools(self, text):
        self.tool_list.clear()
        query = (text or "").lower()
        for name, exec_cmd, icon in self.catalog.get(self.current_category, []):
            if query and query not in name.lower():
                continue
            item = QListWidgetItem(f"▸  {name}")
            item.setData(Qt.ItemDataRole.UserRole, exec_cmd)
            self.tool_list.addItem(item)
        if self.tool_list.count():
            self.tool_list.setCurrentRow(0)

    def on_tool_selected(self, item):
        exec_cmd = item.data(Qt.ItemDataRole.UserRole)
        if exec_cmd:
            launch_tool(exec_cmd)
            self.close()

    def on_enter(self):
        if self.panel.isVisible():
            item = self.tool_list.currentItem()
            if item is not None:
                self.on_tool_selected(item)
        else:
            cat = self.wheel_view.current_category()
            if cat:
                self.open_category(cat)

    def on_escape(self):
        if self.panel.isVisible():
            self.show_wheel()
        else:
            self.close()

    def mousePressEvent(self, event):
        if self.panel.isVisible() and not self.panel.geometry().contains(event.position().toPoint()):
            self.show_wheel()


def main():
    app = QApplication(sys.argv)
    # Wayland app_id, matched by the Hyprland rule in archangelos.lua
    QGuiApplication.setDesktopFileName("archangelos-wheel")
    window = WheelWindow()
    window.show()
    window.show_wheel()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
