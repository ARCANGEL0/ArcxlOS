#!/usr/bin/env python3
"""
ArchangelOS Fallen Edition - Radial Wheel Category Launcher
A radial wheel menu exposing the full CyberSuite tools organized by
categories (Network, Wireless, Forensics, Blue Team, Web Attacks, etc.),
similar to the Kali categories menu.

Themed to match the ArchangelOS desktop shell: matte near-black, crimson
accent, hairline edges — with a red-team / cyber-samurai read (reticle hub,
monospace labels, arsenal glyphs). Only the wheel is drawn: no backdrop, the
desktop stays visible around it. Click off the wheel (or Esc) to close.

Default keybind: SUPER + SHIFT + TAB (Hyprland; SUPER + TAB is the app launcher)
"""

import sys
import os
import re
import math
import subprocess

from PyQt6.QtCore import Qt, QRectF, QPointF, QTimer, QSize
from PyQt6.QtGui import (
    QPixmap, QImage, QFont, QFontDatabase, QColor, QPainter, QPen, QBrush,
    QGuiApplication, QKeySequence, QShortcut, QPainterPath, QRadialGradient,
    QLinearGradient, QFontMetrics
)
from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QLineEdit, QListWidget, QListWidgetItem, QFrame
)

try:
    from PyQt6.QtSvg import QSvgRenderer
except Exception:  # pragma: no cover
    QSvgRenderer = None

# --- Palette (matches the desktop shell: src/PrefsService overrides) ----------
BG          = QColor(8, 8, 8)            # #080808 matte near-black
SURFACE     = QColor(16, 16, 16)         # #101010
SURFACE_HI  = QColor(26, 26, 25)         # #1a1a19
OUTLINE     = QColor(46, 45, 43)         # #2e2d2b hairline
ACCENT      = QColor(194, 74, 82)        # #C24A52 crimson
ACCENT_DIM  = QColor(194, 74, 82, 70)
TEXT        = QColor(236, 234, 228)      # #ECEAE4
SUBTEXT     = QColor(138, 136, 132)      # #8a8884
STEEL       = QColor(185, 182, 174)      # #B9B6AE
BLADE       = QColor(120, 128, 140)      # cold steel for the katana stroke

LOGO_SVG = "/usr/share/archangelos/logo-mark.svg"
LOGO_PNG = "/usr/share/archangelos/logo.png"

# Nerd Font glyphs per category, for a touch of arsenal flavour on each spoke.
