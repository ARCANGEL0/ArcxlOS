        content_layout.addWidget(bottom_bar)
        main_h_layout.addWidget(content_area, 1)

    def open_about_dialog(self):
        dlg = AboutDialog(self)
        dlg.exec()

    def update_step_indicator(self, index):
        headers = [
            ("Fallen Edition", ""),
            ("Country", "Select your country"),
            ("Keyboard", "Select your keyboard layout"),
            ("Timezone", "Select your timezone"),
            ("Disks & Partitions", "Select where to install ArchangelOS"),
            ("Account Configuration", "Create your user account"),
            ("Summary", "Review your settings before the installation begins"),
            ("Installing ArchangelOS", "Please wait while ArchangelOS is installed"),
            ("Installation Complete", "ArchangelOS has been installed on your computer")
        ]

        if index < len(headers):
            title, desc = headers[index]
            self.page_header_title.setText(title)
            self.page_header_desc.setText(desc)

        active = min(index, 7)
        for i, lbl in enumerate(self.step_labels):
            if i == active:
                lbl.setObjectName("SidebarStepItemActive")
                lbl.setText(f"{i + 1}.  {self.step_names[i]}")
            else:
                lbl.setObjectName("SidebarStepItem")
                prefix = "\u2713" if i < active else str(i + 1) + "."
                lbl.setText(f"{prefix}  {self.step_names[i]}")
            lbl.setStyle(lbl.style())

        self.btn_next.setEnabled(True)
        if index == 7:
            self.btn_back.setEnabled(False)
            self.btn_next.setEnabled(False)
            self.btn_next.setText("Installing...")
        elif index == 8:
            self.btn_back.setEnabled(False)
            self.btn_next.setText("Done")
        else:
            self.btn_back.setEnabled(index > 0)
            self.btn_next.setText("Next >")

