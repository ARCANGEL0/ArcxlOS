    def populate_summary(self):
        modes = {1: "Erase disk (guided)", 2: "Install alongside (dual boot)", 3: "Manual partitioning"}
        disk = self.disk_combo.currentData() or ""
        disk_label = disk
        for d in self.available_disks:
            if d["dev"] == disk:
                disk_label = f"{d['dev']}  ·  {d['model']} ({d['size']})"
                break

        kb_item = self.keymap_list.currentItem()
        values = {
            "country": self.selected_country(),
            "keyboard": kb_item.text() if kb_item is not None else "",
            "timezone": self.selected_timezone(),
            "disk": disk_label,
            "mode": modes.get(self.part_button_group.checkedId(), ""),
            "boot": f"GRUB ({self.boot_mode})",
            "user": self.input_username.text().strip(),
            "hostname": self.input_hostname.text().strip(),
        }

        for key, lbl in self.summary_rows.items():
            lbl.setText(values.get(key, ""))

    def create_page_installing(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(20, 20, 20, 20)

        self.slideshow_frame = QFrame()
        self.slideshow_frame.setObjectName("SlideFrame")
        self.slideshow_frame.setStyleSheet(f"QFrame#SlideFrame {{ background-color: {COLOR_SURFACE}; border: 1px solid {COLOR_BORDER}; border-radius: 10px; }}")
        slide_layout = QVBoxLayout(self.slideshow_frame)
        slide_layout.setContentsMargins(0, 0, 0, 0)

        self.slide_img_lbl = QLabel()
        self.slide_img_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.slide_img_lbl.setMinimumHeight(320)
        slide_layout.addWidget(self.slide_img_lbl, 1)

        self.slide_title_lbl = QLabel(EDITION_TITLE)
        self.slide_title_lbl.setFont(QFont(FONT_FAMILY, 16, QFont.Weight.Bold))
        self.slide_title_lbl.setStyleSheet(f"color: {COLOR_PRIMARY}; background-color: rgba(13, 17, 23, 0.85); padding: 8px 16px;")

        self.slide_desc_lbl = QLabel("Installing system files offline...")
        self.slide_desc_lbl.setStyleSheet("color: #ffffff; background-color: rgba(13, 17, 23, 0.85); padding: 4px 16px 10px 16px; font-size: 13px;")

        slide_layout.addWidget(self.slide_title_lbl)
        slide_layout.addWidget(self.slide_desc_lbl)

        layout.addWidget(self.slideshow_frame, 1)

        self.progress_bar = QProgressBar()
        self.progress_bar.setValue(0)
        self.progress_bar.setFixedHeight(24)
        layout.addWidget(self.progress_bar)

        self.status_lbl = QLabel("Preparing installation...")
        self.status_lbl.setFont(QFont(FONT_FAMILY, 11, QFont.Weight.Bold))
        self.status_lbl.setStyleSheet(f"color: {COLOR_PRIMARY};")
        layout.addWidget(self.status_lbl)

        self.slideshow_timer = QTimer(self)
        self.slideshow_timer.timeout.connect(self.rotate_slideshow)

        return page

    def start_installation(self):
        selected_disk = self.disk_combo.currentData() or "/dev/sda"
        part_option = self.part_button_group.checkedId()
        username = self.input_username.text().strip() or "liveuser"
        password = self.input_pass.text() or "live"
        hostname = self.input_hostname.text().strip() or "archangelos"
        timezone = self.selected_timezone()
        keymap = self.selected_keymap()
        root_password = password if self.check_same_root.isChecked() else self.input_root_pass.text()

        config = {
            "disk": selected_disk,
            "boot_mode": self.boot_mode,
            "part_option": part_option,
            "username": username,
            "password": password,
            "root_password": root_password,
            "hostname": hostname,
            "timezone": timezone,
            "keymap": keymap
        }

        self.rotate_slideshow()
        self.slideshow_timer.start(5000)

        self.worker = InstallWorkerThread(config)
        self.worker.progressChanged.connect(self.on_install_progress)
        self.worker.installationFinished.connect(self.on_install_finished)
        self.worker.start()

    def rotate_slideshow(self):
        if not self.wallpapers:
            return

        wp_path = self.wallpapers[self.slideshow_index % len(self.wallpapers)]

        pix = QPixmap(wp_path)
        if not pix.isNull():
            scaled = pix.scaled(self.slideshow_frame.size(), Qt.AspectRatioMode.KeepAspectRatioByExpanding, Qt.TransformationMode.SmoothTransformation)
            self.slide_img_lbl.setPixmap(scaled)

        self.slideshow_index += 1

    def on_install_progress(self, percent, msg):
        self.progress_bar.setValue(percent)
        self.status_lbl.setText(f"Status: {msg}")

    def on_install_finished(self, success, result_msg):
        self.slideshow_timer.stop()
        if success:
            self.goto_page(8)
        else:
            QMessageBox.critical(self, "Installation Error", f"Installation failed:\n{result_msg}")

    def create_page_finish(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(40, 30, 40, 30)
        layout.addStretch()

        check = QLabel("✓")
        check.setAlignment(Qt.AlignmentFlag.AlignCenter)
        check.setFixedSize(96, 96)
        check.setStyleSheet(f"color: {COLOR_PRIMARY}; font-size: 46px; border: 2px solid {COLOR_PRIMARY}; border-radius: 48px;")
        layout.addWidget(check, alignment=Qt.AlignmentFlag.AlignHCenter)

        layout.addSpacing(26)

        title = QLabel("ArchangelOS has been installed successfully")
        title.setFont(QFont("Shippori Mincho", 20, QFont.Weight.Bold))
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        title.setStyleSheet(f"color: {COLOR_TEXT};")
        layout.addWidget(title)

        layout.addSpacing(10)

        sub = QLabel("You can restart now to boot into your new system, or keep using the live session.")
        sub.setWordWrap(True)
        sub.setFixedWidth(560)
        sub.setMinimumHeight(48)
        sub.setAlignment(Qt.AlignmentFlag.AlignCenter)
        sub.setStyleSheet(f"color: {COLOR_MUTED}; font-size: 14px;")
        layout.addWidget(sub, alignment=Qt.AlignmentFlag.AlignHCenter)

        layout.addSpacing(26)

        self.check_reboot = QCheckBox("Reboot system now automatically")
        self.check_reboot.setChecked(True)
        self.check_reboot.setFont(QFont(FONT_FAMILY, 12, QFont.Weight.Bold))
        layout.addWidget(self.check_reboot, alignment=Qt.AlignmentFlag.AlignHCenter)

        layout.addStretch()
        return page

    def go_next(self):
        cur_idx = self.stacked_widget.currentIndex()

        if cur_idx == 5:
            username = self.input_username.text().strip()
            p1 = self.input_pass.text()
            p2 = self.input_pass_confirm.text()

            if not username:
                QMessageBox.warning(self, "Username Required", "Please enter a username for the account.")
                return
            if not p1:
                QMessageBox.warning(self, "Password Required", "Please enter a password for the account.")
                return
            if p1 != p2:
                QMessageBox.warning(self, "Password Mismatch", "Passwords do not match. Please enter matching passwords.")
                return
            if not self.check_same_root.isChecked() and not self.input_root_pass.text():
                QMessageBox.warning(self, "Root Password Required", "Please enter a password for the root account.")
                return

            self.populate_summary()
            self.goto_page(6)
        elif cur_idx == 6:
            reply = QMessageBox.question(
                self, "Confirm Installation",
                "Are you ready to begin installation?\nThe selected disk partitions will be modified and data on them erased.",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
            )
            if reply == QMessageBox.StandardButton.Yes:
                self.goto_page(7)
                self.start_installation()
        elif cur_idx == 8:
            if self.check_reboot.isChecked():
                subprocess.run(["reboot"])
            self.close()
        else:
            self.goto_page(cur_idx + 1)

    def goto_page(self, index):
        self.stacked_widget.setCurrentIndex(index)
        self.update_step_indicator(index)

    def go_back(self):
        cur_idx = self.stacked_widget.currentIndex()
        if cur_idx > 0:
            new_idx = cur_idx - 1
            self.stacked_widget.setCurrentIndex(new_idx)
            self.update_step_indicator(new_idx)


def main():
    if os.geteuid() != 0:
        print("[!] Error: ArchangelOS Installer must be run as root (sudo archangelos-gui-installer).")
        sys.exit(1)

    app = QApplication(sys.argv)
    window = ArchangelOSInstallerWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
