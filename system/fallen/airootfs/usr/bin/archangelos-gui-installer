            "fs": self.fs_combo.currentText(),
            "mount": self.mount_combo.currentText(),
            "format": self.format_check.isChecked()
        }


class InstallWorkerThread(QThread):
    progressChanged = pyqtSignal(int, str)
    installationFinished = pyqtSignal(bool, str)

    def __init__(self, config):
        super().__init__()
        self.config = config

    def log(self, percent, msg):
        self.progressChanged.emit(percent, msg)
        time.sleep(0.3)

    def run_cmd(self, cmd):
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if res.returncode != 0:
            raise Exception(f"Command failed ({res.returncode}): {cmd}\nOutput: {res.stderr or res.stdout}")
        return res.stdout

    def run(self):
        try:
            disk = self.config["disk"]
            boot_mode = self.config["boot_mode"]
            part_option = self.config["part_option"]
            user_name = self.config["username"]
            password = self.config["password"]
            hostname = self.config["hostname"]
            timezone = self.config["timezone"]
            keymap = self.config.get("keymap", "us")
            root_password = self.config.get("root_password") or password

            self.log(2, "Initializing offline system installer engine...")

            self.run_cmd("umount -R /mnt 2>/dev/null || true")

            root_part = ""
            boot_part = ""

            if part_option == 1:
                self.log(10, f"Wiping partition table on {disk}...")
                self.run_cmd(f"dd if=/dev/zero of='{disk}' bs=512 count=100 conv=notrunc 2>/dev/null || true")
                self.run_cmd(f"wipefs -a '{disk}' 2>/dev/null || true")

                if boot_mode == "UEFI":
                    self.log(15, "Creating GPT partition table layout (UEFI)...")
                    self.run_cmd(f"parted -s '{disk}' mklabel gpt")
                    self.run_cmd(f"parted -s '{disk}' mkpart primary fat32 1MiB 513MiB")
                    self.run_cmd(f"parted -s '{disk}' set 1 esp on")
                    self.run_cmd(f"parted -s '{disk}' mkpart primary ext4 513MiB 100%")
                    self.run_cmd(f"partprobe '{disk}' 2>/dev/null || true")
                    self.run_cmd("udevadm settle")

                    p_prefix = f"{disk}p" if disk[-1].isdigit() else disk
                    boot_part = f"{p_prefix}1"
                    root_part = f"{p_prefix}2"

                    self.log(20, f"Formatting EFI System Partition ({boot_part})...")
                    self.run_cmd(f"mkfs.fat -F 32 '{boot_part}'")
                else:
                    self.log(15, "Creating MBR partition table layout (BIOS)...")
                    self.run_cmd(f"parted -s '{disk}' mklabel msdos")
                    self.run_cmd(f"parted -s '{disk}' mkpart primary ext4 1MiB 100%")
                    self.run_cmd(f"parted -s '{disk}' set 1 boot on")
                    self.run_cmd(f"partprobe '{disk}' 2>/dev/null || true")
                    self.run_cmd("udevadm settle")

                    p_prefix = f"{disk}p" if disk[-1].isdigit() else disk
                    root_part = f"{p_prefix}1"

                self.log(25, f"Formatting Root Partition ({root_part})...")
                self.run_cmd(f"mkfs.ext4 -F '{root_part}'")

            elif part_option == 2:
                self.log(10, f"Scanning unallocated space on {disk}...")
                sf_out = self.run_cmd(f"sfdisk -F '{disk}' 2>/dev/null || true")

                largest_start = 0
                largest_sectors = 0
                for line in sf_out.splitlines():
                    tokens = line.split()
                    if len(tokens) >= 3 and tokens[0].isdigit():
                        start, end, sectors = int(tokens[0]), int(tokens[1]), int(tokens[2])
                        if sectors > largest_sectors:
                            largest_start = start
                            largest_sectors = sectors

                if largest_sectors == 0:
                    raise Exception("No unallocated free space found on disk for dual boot.")

                largest_end = largest_start + largest_sectors - 1
                self.log(15, "Creating partition in free space...")
                parts_before = run_command_output(f"lsblk -lno NAME '{disk}' | grep -E '[0-9]+$'").split()
                self.run_cmd(f"parted -s '{disk}' mkpart primary ext4 {largest_start}s {largest_end}s")
                self.run_cmd(f"partprobe '{disk}' 2>/dev/null || true")
                self.run_cmd("udevadm settle")
                time.sleep(1)
                parts_after = run_command_output(f"lsblk -lno NAME '{disk}' | grep -E '[0-9]+$'").split()

                new_part_name = None
                for pa in parts_after:
                    if pa not in parts_before:
                        new_part_name = pa
                        break

                if not new_part_name and parts_after:
                    new_part_name = parts_after[-1]

                root_part = f"/dev/{new_part_name}"
                self.log(25, f"Formatting dual-boot root partition ({root_part})...")
                self.run_cmd(f"mkfs.ext4 -F '{root_part}'")

                if boot_mode == "UEFI":
                    efi_parts = run_command_output(f"lsblk -lno NAME,FSTYPE '{disk}' | grep -i 'vfat' | awk '{{print \"/dev/\"$1}}'").split()
                    if efi_parts:
                        boot_part = efi_parts[0]

            else:
                root_part = self.config.get("manual_root", "")
                boot_part = self.config.get("manual_boot", "")
                if self.config.get("format_root", False) and root_part:
                    self.log(20, f"Formatting selected root partition ({root_part})...")
                    self.run_cmd(f"mkfs.ext4 -F '{root_part}'")

            self.log(30, f"Mounting root partition {root_part} to /mnt...")
            self.run_cmd(f"mount '{root_part}' /mnt")

            if boot_mode == "UEFI" and boot_part:
                self.log(35, f"Mounting EFI partition {boot_part} to /mnt/boot/efi...")
                self.run_cmd("mkdir -p /mnt/boot/efi")
                self.run_cmd(f"mount '{boot_part}' /mnt/boot/efi")

            self.log(40, "Deploying ArchangelOS system files from live image (100% Offline)...")
            rsync_cmd = (
                "rsync -aAXv --exclude='/dev/*' --exclude='/proc/*' --exclude='/sys/*' "
                "--exclude='/tmp/*' --exclude='/run/*' --exclude='/mnt/*' --exclude='/media/*' "
                "--exclude='/lost+found' --exclude='/boot/efi/*' --exclude='/boot/grub/*' "
                "--exclude='/etc/fstab' --exclude='/etc/resolv.conf' / /mnt/"
            )
            self.run_cmd(rsync_cmd)

            if not os.path.exists("/mnt/boot/vmlinuz-linux"):
                self.log(60, "Copying kernel and initramfs files to target boot partition...")
                self.run_cmd("cp -af /boot/vmlinuz-linux /mnt/boot/ 2>/dev/null || true")
                self.run_cmd("cp -af /boot/initramfs*.img /mnt/boot/ 2>/dev/null || true")

            self.log(65, "Generating /etc/fstab UUID mapping...")
            self.run_cmd("genfstab -U /mnt > /mnt/etc/fstab")

            self.log(70, "Configuring system locale, hostname & timezone...")
            self.run_cmd("rm -f /mnt/etc/machine-id /mnt/var/lib/dbus/machine-id")
            self.run_cmd("arch-chroot /mnt systemd-machine-id-setup")
            self.run_cmd(f"arch-chroot /mnt ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime")
            with open("/mnt/etc/vconsole.conf", "w") as f:
                f.write(f"KEYMAP={keymap}\n")
            self.run_cmd("arch-chroot /mnt hwclock --systohc 2>/dev/null || true")
            self.run_cmd("sed -i 's/#\\(en_US\\.UTF-8\\)/\\1/' /mnt/etc/locale.gen 2>/dev/null || true")
            self.run_cmd("arch-chroot /mnt locale-gen 2>/dev/null || true")

            with open("/mnt/etc/hostname", "w") as f:
                f.write(f"{hostname}\n")

            with open("/mnt/etc/hosts", "w") as f:
                f.write(f"127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t{hostname}.localdomain\t{hostname}\n")

            self.run_cmd("arch-chroot /mnt systemctl enable NetworkManager sddm 2>/dev/null || true")

            self.run_cmd("mkdir -p /mnt/etc/sddm.conf.d")
            with open("/mnt/etc/sddm.conf.d/10-archangelos.conf", "w") as _sddmf:
                _sddmf.write("[Theme]\nCurrent=archangelos\n\n[General]\nGreeterEnvironment=QT_QUICK_CONTROLS_STYLE=Basic\n")

            self.log(80, f"Creating user account '{user_name}'...")
            self.run_cmd("arch-chroot /mnt userdel -r liveuser 2>/dev/null || true")
            self.run_cmd(f"arch-chroot /mnt userdel -r '{user_name}' 2>/dev/null || true")
            self.run_cmd(f"arch-chroot /mnt useradd -m -g users -G wheel,power,audio,video,storage -s /bin/zsh '{user_name}'")
            self.run_cmd(f"echo '{user_name}:{password}' | arch-chroot /mnt chpasswd")
            self.run_cmd(f"echo 'root:{root_password}' | arch-chroot /mnt chpasswd")

            with open("/mnt/etc/sudoers.d/wheel", "w") as f:
                f.write("%wheel ALL=(ALL:ALL) ALL\n")
            os.chmod("/mnt/etc/sudoers.d/wheel", 0o440)

            self.log(85, "Regenerating initramfs images...")
            self.run_cmd("arch-chroot /mnt mkinitcpio -P 2>/dev/null || true")

            self.log(90, "Installing GRUB bootloader...")
            grub_default = """
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="ArchangelOS"
GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet"
GRUB_CMDLINE_LINUX=""
GRUB_PRELOAD_MODULES="part_gpt part_msdos ext2 fat search search_fs_uuid"
GRUB_DISABLE_OS_PROBER=false
GRUB_TIMEOUT_STYLE=menu
GRUB_GFXMODE=auto
GRUB_BACKGROUND="/usr/share/backgrounds/splash.png"
"""
            with open("/mnt/etc/default/grub", "w") as f:
                f.write(grub_default)

            if boot_mode == "UEFI":
                self.run_cmd("arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=ArchangelOS --recheck")
                self.run_cmd("arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable")
            else:
                self.run_cmd(f"arch-chroot /mnt grub-install --target=i386-pc '{disk}'")

            self.run_cmd("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg")

            self.log(98, "Finalizing installation & unmounting filesystems...")
            self.run_cmd("arch-chroot /mnt systemctl disable choose-mirror.service pacman-init.service vboxservice.service 2>/dev/null || true")
            self.run_cmd("umount -R /mnt 2>/dev/null || true")

            self.log(100, "Installation completed successfully!")
            self.installationFinished.emit(True, "Installation complete.")

        except Exception as e:
            self.installationFinished.emit(False, str(e))


