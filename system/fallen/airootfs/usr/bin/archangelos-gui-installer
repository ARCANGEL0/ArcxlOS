        if os.path.exists(LOGO_PATH):
            logo_lbl.setPixmap(QPixmap(LOGO_PATH).scaledToWidth(196, Qt.TransformationMode.SmoothTransformation))
        else:
            logo_lbl.setText("ArchangelOS")
            logo_lbl.setFont(QFont(FONT_FAMILY, 18, QFont.Weight.Bold))

