    def create_page_country(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(30, 20, 30, 20)

        self.country_search = QLineEdit()
        self.country_search.setPlaceholderText("Type to search your country...")
        self.country_search.textChanged.connect(self.filter_country_list)
        layout.addWidget(self.country_search)

        self.country_list = QListWidget()
        self.country_list.setObjectName("PickList")
        for name, zone in COUNTRIES:
            item = QListWidgetItem(name)
            item.setData(Qt.ItemDataRole.UserRole, zone)
            self.country_list.addItem(item)

        default_row = 0
        detected = self.detect_timezone()
        for i, (name, zone) in enumerate(COUNTRIES):
            if zone == detected:
                default_row = i
                break

        self.country_list.setCurrentRow(default_row)
        layout.addWidget(self.country_list, 1)
        return page

    def create_page_keyboard(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(30, 20, 30, 20)

        self.keymap_search = QLineEdit()
        self.keymap_search.setPlaceholderText("Type to search your keyboard layout...")
        self.keymap_search.textChanged.connect(self.filter_keymap_list)
        layout.addWidget(self.keymap_search)

        self.keymap_list = QListWidget()
        self.keymap_list.setObjectName("PickList")
        for label, code in KEYBOARD_LAYOUTS:
            item = QListWidgetItem(label)
            item.setData(Qt.ItemDataRole.UserRole, code)
            self.keymap_list.addItem(item)

        self.keymap_list.setCurrentRow(0)
        layout.addWidget(self.keymap_list, 1)
        return page

    def create_page_timezone(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(30, 20, 30, 20)

        self.clock_lbl = QLabel()
        self.clock_lbl.setFont(QFont(FONT_FAMILY, 12, QFont.Weight.Bold))
        self.clock_lbl.setStyleSheet(f"color: {COLOR_PRIMARY};")

        self.timezone_list = QListWidget()
        self.timezone_list.setObjectName("PickList")
        default_zone = self.detect_timezone()
        ordered = sorted(CITIES_DB, key=lambda c: (c["zone"] != default_zone, c["zone"]))
        for c in ordered:
            item = QListWidgetItem(f"{c['zone']}    ·    {c['city']}")
            item.setData(Qt.ItemDataRole.UserRole, c["zone"])
            self.timezone_list.addItem(item)

        self.timezone_list.currentRowChanged.connect(self.on_timezone_changed)
        layout.addWidget(self.timezone_list, 1)

        layout.addSpacing(10)
        layout.addWidget(self.clock_lbl)

        self.clock_timer = QTimer(self)
        self.clock_timer.timeout.connect(self.update_live_clock)
        self.clock_timer.start(1000)

        self.timezone_list.setCurrentRow(0)
        return page

    def detect_timezone(self):
        try:
            real = os.path.realpath("/etc/localtime")
            marker = "/usr/share/zoneinfo/"
            if marker in real:
                return real.split(marker, 1)[1]
        except Exception:
            pass
        try:
            with open("/etc/timezone") as fh:
                return fh.read().strip()
        except Exception:
            return ""

    def select_timezone(self, zone):
        for i in range(self.timezone_list.count()):
            if self.timezone_list.item(i).data(Qt.ItemDataRole.UserRole) == zone:
                self.timezone_list.setCurrentRow(i)
                return

    def on_country_changed(self, row):
        item = self.country_list.item(row)
        if item is not None:
            self.select_timezone(item.data(Qt.ItemDataRole.UserRole))

    def on_timezone_changed(self, row):
        self.update_live_clock()

    def filter_country_list(self, text):
        text = text.strip().lower()
        for i in range(self.country_list.count()):
            item = self.country_list.item(i)
            item.setHidden(bool(text) and text not in item.text().lower())

    def filter_keymap_list(self, text):
        text = text.strip().lower()
        for i in range(self.keymap_list.count()):
            item = self.keymap_list.item(i)
            item.setHidden(bool(text) and text not in item.text().lower())

    def selected_country(self):
        item = self.country_list.currentItem()
        return item.text() if item is not None else ""

    def selected_keymap(self):
        item = self.keymap_list.currentItem()
        return item.data(Qt.ItemDataRole.UserRole) if item is not None else "us"

    def selected_timezone(self):
        item = self.timezone_list.currentItem()
        return item.data(Qt.ItemDataRole.UserRole) if item is not None else "UTC"

    def update_live_clock(self):
        try:
            os.environ["TZ"] = self.selected_timezone()
            time.tzset()
            self.clock_lbl.setText(f"Local time: {time.strftime('%Y-%m-%d %H:%M:%S %Z')}")
        except Exception:
            self.clock_lbl.setText("Local time: syncing...")

    def create_page_partition(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(30, 20, 30, 20)

        disk_box = QHBoxLayout()
        disk_lbl = QLabel("Target Hard Disk:")
        disk_lbl.setFont(QFont(FONT_FAMILY, 13, QFont.Weight.Bold))
        self.disk_combo = QComboBox()

        for d in self.available_disks:
            self.disk_combo.addItem(f"{d['dev']} - {d['model']} ({d['size']})", d["dev"])

        self.disk_combo.currentIndexChanged.connect(self.on_disk_selection_changed)

        disk_box.addWidget(disk_lbl)
        disk_box.addWidget(self.disk_combo, 1)

        btn_gparted = QPushButton("🛠 Launch GParted")
        btn_gparted.clicked.connect(self.launch_gparted)
        disk_box.addWidget(btn_gparted)

        layout.addLayout(disk_box)

        self.part_button_group = QButtonGroup(self)

        self.radio_erase = QRadioButton("Erase Entire Disk — Wipe disk & create fresh partition layout")
        self.radio_dual = QRadioButton("Install on free space remaining — Use largest free unallocated space")
        self.radio_manual = QRadioButton("Manual Partitioning — Custom select existing partitions or format manually")

        self.radio_erase.setChecked(True)

        self.part_button_group.addButton(self.radio_erase, 1)
        self.part_button_group.addButton(self.radio_dual, 2)
        self.part_button_group.addButton(self.radio_manual, 3)

        layout.addWidget(self.radio_erase)
        layout.addWidget(self.radio_dual)
        layout.addWidget(self.radio_manual)

        custom_bar = QHBoxLayout()
        btn_create_custom = QPushButton("➕ Create Custom Partition")
        btn_create_custom.clicked.connect(self.open_custom_partition_dialog)
        custom_bar.addWidget(btn_create_custom)
        custom_bar.addStretch()
        layout.addLayout(custom_bar)

        self.part_table = QTableWidget()
        self.part_table.setColumnCount(4)
        self.part_table.setHorizontalHeaderLabels(["Partition", "Size", "Filesystem", "Action / Mount"])
        self.part_table.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.Stretch)

        layout.addWidget(self.part_table, 1)
        self.on_disk_selection_changed()

        return page

    def on_disk_selection_changed(self):
        disk_dev = self.disk_combo.currentData()
        if not disk_dev:
            return

        parts = get_disk_partitions(disk_dev)
        self.part_table.setRowCount(len(parts))

        for row, p in enumerate(parts):
            self.part_table.setItem(row, 0, QTableWidgetItem(p["dev"]))
            self.part_table.setItem(row, 1, QTableWidgetItem(p["size"]))
            self.part_table.setItem(row, 2, QTableWidgetItem(p["fs"]))
            self.part_table.setItem(row, 3, QTableWidgetItem("Use as Root (/)" if row == 0 else "Select Mount"))

    def launch_gparted(self):
        try:
            subprocess.Popen(["gparted"])
        except Exception:
            QMessageBox.warning(self, "GParted", "Could not launch GParted. Make sure gparted is installed.")

    def open_custom_partition_dialog(self):
        disk_dev = self.disk_combo.currentData() or "/dev/sda"
        dlg = CustomPartitionDialog(disk_dev, self)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            details = dlg.get_details()
            QMessageBox.information(
                self, "Partition Configured",
                f"Configured custom partition ({details['size_mb']} MB {details['fs']}) on {disk_dev}.\n"
                f"Mount point: {details['mount']}"
            )
            self.on_disk_selection_changed()

    def create_page_credentials(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(30, 20, 30, 20)

        card = QFrame()
        card.setObjectName("CredCard")
        card.setStyleSheet(f"QFrame#CredCard {{ background-color: {COLOR_SURFACE}; border: 1px solid {COLOR_BORDER}; border-radius: 8px; padding: 22px; }}")
        grid = QGridLayout(card)
        grid.setHorizontalSpacing(18)
        grid.setVerticalSpacing(4)

        self.input_fullname = QLineEdit()
        self.input_username = QLineEdit()
        self.input_pass = QLineEdit()
        self.input_pass.setEchoMode(QLineEdit.EchoMode.Password)
        self.input_pass_confirm = QLineEdit()
        self.input_pass_confirm.setEchoMode(QLineEdit.EchoMode.Password)
        self.input_hostname = QLineEdit()
        self.input_hostname.setText("archangelos")
        self.input_root_pass = QLineEdit()
        self.input_root_pass.setEchoMode(QLineEdit.EchoMode.Password)
        self.input_root_pass.setEnabled(False)

        fields = [
            ("FULL NAME", self.input_fullname, 0, 0, 1),
            ("USERNAME", self.input_username, 0, 1, 1),
            ("PASSWORD", self.input_pass, 1, 0, 1),
            ("CONFIRM PASSWORD", self.input_pass_confirm, 1, 1, 1),
            ("HOSTNAME", self.input_hostname, 2, 0, 2),
            ("ROOT PASSWORD", self.input_root_pass, 3, 0, 2),
        ]

        for label, widget, row, col, span in fields:
            widget.setAlignment(Qt.AlignmentFlag.AlignCenter)
            widget.setMinimumHeight(38)
            lbl = QLabel(label)
            lbl.setStyleSheet(f"color: {COLOR_MUTED}; font-size: 10px; letter-spacing: 2px;")
            lbl.setAlignment(Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter)
            grid.addWidget(lbl, row * 2, col, 1, span)
            grid.addWidget(widget, row * 2 + 1, col, 1, span)
            grid.setRowMinimumHeight(row * 2 + 1, 46)

        grid.setColumnStretch(0, 1)
        grid.setColumnStretch(1, 1)

        layout.addWidget(card)
        layout.addSpacing(16)

        self.check_same_root = QCheckBox("Use the same password for the root account")
        self.check_same_root.setChecked(True)
        self.check_same_root.toggled.connect(lambda on: self.input_root_pass.setEnabled(not on))
        layout.addWidget(self.check_same_root)

        layout.addStretch()
        return page

