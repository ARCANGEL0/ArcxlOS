        brand_sub.setStyleSheet(f"color: {COLOR_MUTED}; font-size: 10px; letter-spacing: 2px;")

        brand_sub.setAlignment(Qt.AlignmentFlag.AlignHCenter)
        logo_box.addWidget(logo_lbl, alignment=Qt.AlignmentFlag.AlignHCenter)
        logo_box.addWidget(brand_sub, alignment=Qt.AlignmentFlag.AlignHCenter)
        sidebar_layout.addLayout(logo_box)
        sidebar_layout.addSpacing(24)

        self.step_labels = []
