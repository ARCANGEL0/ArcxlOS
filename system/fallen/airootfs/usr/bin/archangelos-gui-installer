def run_command_output(cmd):
    """Run shell command and return stdout string."""
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=30)
        return res.stdout.strip()
    except Exception:
        return ""


def get_boot_mode():
    if os.path.exists("/sys/firmware/efi"):
        return "UEFI"
    return "BIOS (Legacy)"


def get_available_disks():
    """Scan available disks using lsblk."""
    disks = []
    output = run_command_output("lsblk -dno NAME,SIZE,MODEL,TYPE | grep -E 'disk'")
    for line in output.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            name = parts[0]
            size = parts[1]
            model = " ".join(parts[2:]) if len(parts) > 2 else "Drive"
            dev_path = f"/dev/{name}"
            disks.append({
                "dev": dev_path,
                "name": name,
                "size": size,
                "model": model
            })
    return disks


def get_disk_partitions(disk_dev):
    """Get list of partitions on selected disk."""
    parts = []
    output = run_command_output(f"lsblk -lno NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS '{disk_dev}' | grep -E '[0-9]+'")
    for line in output.splitlines():
        tokens = line.split()
        if tokens:
            p_name = tokens[0]
            p_size = tokens[1] if len(tokens) > 1 else "Unknown"
            p_fs = tokens[2] if len(tokens) > 2 else "raw"
            p_path = f"/dev/{p_name}"
            parts.append({
                "dev": p_path,
                "name": p_name,
                "size": p_size,
                "fs": p_fs
            })
    return parts


class WorldMapWidget(QWidget):
    timezoneSelected = pyqtSignal(str, str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(320)
        self.selected_city = CITIES_DB[0]
        self.setMouseTracking(True)
        self.hovered_city = None
        self.custom_target_point = None

    def set_selected_city_by_zone(self, zone_name):
        for c in CITIES_DB:
            if c["zone"] == zone_name:
                self.selected_city = c
                self.custom_target_point = None
                self.update()
                break

    def mousePressEvent(self, event):
        w = self.width()
        h = self.height()
        click_x = event.position().x()
        click_y = event.position().y()

        click_lon = (click_x / w) * 360.0 - 180.0
        click_lat = 90.0 - (click_y / h) * 180.0

        closest_city = None
        min_dist = 999999

        for c in CITIES_DB:
            dlon = c["lon"] - click_lon
            dlat = c["lat"] - click_lat
            dist = math.hypot(dlon, dlat)
            if dist < min_dist:
                min_dist = dist
                closest_city = c

        if closest_city:
            self.selected_city = closest_city
            self.custom_target_point = (click_lon, click_lat)
            self.timezoneSelected.emit(closest_city["city"], closest_city["zone"])
            self.update()

    def mouseMoveEvent(self, event):
        w = self.width()
        h = self.height()
        mx = event.position().x()
        my = event.position().y()

        closest = None
        min_d = 9999

        for c in CITIES_DB:
            cx = (c["lon"] + 180) * (w / 360.0)
            cy = (90 - c["lat"]) * (h / 180.0)
            d = math.hypot(mx - cx, my - cy)
            if d < min_d:
                min_d = d
                closest = c

        if closest and min_d < 40:
            if self.hovered_city != closest:
                self.hovered_city = closest
                self.setCursor(Qt.CursorShape.PointingHandCursor)
                self.update()
        else:
            if self.hovered_city is not None:
                self.hovered_city = None
                self.unsetCursor()
                self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        w = self.width()
        h = self.height()

        grad = QLinearGradient(0, 0, 0, h)
        grad.setColorAt(0, QColor("#060a12"))
        grad.setColorAt(0.5, QColor("#0a101d"))
        grad.setColorAt(1, QColor("#070d18"))
        painter.fillRect(0, 0, w, h, grad)

        grid_pen = QPen(QColor("#161614"), 1, Qt.PenStyle.DotLine)
        painter.setPen(grid_pen)

        for lon in range(-180, 181, 30):
            x = (lon + 180) * (w / 360.0)
            painter.drawLine(int(x), 0, int(x), h)

        for lat in range(-90, 91, 30):
            y = (90 - lat) * (h / 180.0)
            painter.drawLine(0, int(y), w, int(y))

        eq_y = (90 - 0) * (h / 180.0)
        pm_x = (0 + 180) * (w / 360.0)
        painter.setPen(QPen(QColor("#1A1A18"), 1, Qt.PenStyle.SolidLine))
        painter.drawLine(0, int(eq_y), w, int(eq_y))
        painter.drawLine(int(pm_x), 0, int(pm_x), h)

        cancer_y = (90 - 23.5) * (h / 180.0)
        capricorn_y = (90 - (-23.5)) * (h / 180.0)
        painter.setPen(QPen(QColor("#161614"), 1, Qt.PenStyle.DashLine))
        painter.drawLine(0, int(cancer_y), w, int(cancer_y))
        painter.drawLine(0, int(capricorn_y), w, int(capricorn_y))

        painter.setPen(QPen(QColor("#1A1A18"), 1))
        painter.setBrush(QBrush(QColor("#161614")))

        continents = [
            [(-168, 65), (-165, 70), (-140, 70), (-130, 55), (-125, 50), (-124, 40), (-117, 32), (-105, 20), (-90, 16), (-90, 20), (-97, 26), (-95, 30), (-88, 30), (-82, 25), (-80, 30), (-75, 35), (-70, 42), (-65, 45), (-64, 47), (-60, 60), (-75, 62), (-80, 65), (-95, 70), (-120, 72), (-168, 65)],
            [(-105, 20), (-92, 14), (-88, 13), (-83, 9), (-77, 8), (-80, 15), (-90, 17), (-105, 20)],
            [(-77, 8), (-73, 11), (-60, 10), (-50, 0), (-35, -5), (-35, -12), (-40, -22), (-50, -30), (-65, -54), (-75, -50), (-72, -35), (-75, -15), (-80, -2), (-77, 8)],
            [(-9, 36), (-9, 43), (-2, 43), (-5, 48), (2, 51), (8, 54), (10, 58), (20, 55), (30, 60), (30, 45), (25, 40), (22, 38), (15, 40), (12, 44), (9, 44), (3, 43), (-3, 37), (-9, 36)],
            [(-10, 51), (-10, 55), (-6, 58), (-3, 58), (1, 52), (-5, 50), (-10, 51)],
            [(-10, 52), (-10, 55), (-6, 55), (-6, 52), (-10, 52)],
            [(5, 58), (10, 63), (18, 70), (28, 70), (30, 65), (22, 60), (12, 56), (5, 58)],
            [(-17, 15), (-17, 21), (-6, 36), (11, 37), (25, 32), (34, 27), (43, 12), (51, 11), (40, -3), (35, -25), (20, -35), (15, -30), (12, -15), (8, 4), (-8, 4), (-15, 11), (-17, 15)],
            [(35, 30), (45, 40), (50, 40), (60, 55), (70, 70), (100, 75), (140, 72), (170, 66), (180, 65), (160, 55), (140, 40), (120, 30), (110, 20), (105, 10), (100, 4), (98, 10), (92, 20), (88, 22), (68, 24), (60, 25), (55, 25), (50, 15), (43, 12), (35, 30)],
            [(68, 24), (73, 20), (76, 15), (77, 8), (80, 13), (85, 20), (88, 22), (68, 24)],
            [(80, 10), (82, 10), (81, 6), (80, 6), (80, 10)],
            [(130, 32), (133, 35), (140, 36), (142, 44), (145, 44), (140, 36), (130, 32)],
            [(114, -22), (114, -34), (138, -35), (153, -28), (152, -15), (142, -11), (136, -15), (129, -15), (114, -22)],
            [(144, -40), (148, -40), (148, -44), (144, -44), (144, -40)],
            [(172, -34), (178, -38), (174, -42), (172, -34)],
            [(166, -46), (174, -41), (170, -46), (166, -46)],
            [(-55, 60), (-40, 60), (-20, 70), (-18, 80), (-40, 83), (-60, 78), (-55, 60)],
            [(44, -12), (50, -15), (47, -25), (43, -25), (44, -12)],
            [(95, 5), (105, -5), (115, -8), (125, -8), (140, -3), (150, -10), (140, -2), (125, 2), (105, 5), (95, 5)],
            [(120, 18), (126, 12), (125, 6), (120, 10), (120, 18)]
        ]

        for poly in continents:
            pts = []
            for lon, lat in poly:
                wx = (lon + 180) * (w / 360.0)
                wy = (90 - lat) * (h / 180.0)
                pts.append(QPointF(wx, wy))
            painter.drawPolygon(pts)

        for c in CITIES_DB:
            cx = (c["lon"] + 180) * (w / 360.0)
            cy = (90 - c["lat"]) * (h / 180.0)

            is_selected = (c == self.selected_city)
            is_hovered = (c == self.hovered_city)

            if is_selected:
                rad = QRadialGradient(cx, cy, 26)
                rad.setColorAt(0, QColor(0, 243, 255, 240))
                rad.setColorAt(0.5, QColor(0, 243, 255, 90))
                rad.setColorAt(1, QColor(0, 243, 255, 0))
                painter.setBrush(QBrush(rad))
                painter.setPen(Qt.PenStyle.NoPen)
                painter.drawEllipse(QPointF(cx, cy), 26, 26)

                painter.setPen(QPen(QColor("#C24A52"), 1, Qt.PenStyle.SolidLine))
                painter.drawLine(int(cx - 16), int(cy), int(cx + 16), int(cy))
                painter.drawLine(int(cx), int(cy - 16), int(cx), int(cy + 16))

                painter.setBrush(QBrush(QColor("#ffffff")))
                painter.setPen(QPen(QColor("#C24A52"), 2))
                painter.drawEllipse(QPointF(cx, cy), 5, 5)

                painter.setFont(QFont(FONT_FAMILY, 9, QFont.Weight.Bold))
                tag_text = f"📍 {c['city']} [{c['zone']}]"
                metrics = painter.fontMetrics()
                tw = metrics.horizontalAdvance(tag_text) + 16
                th = 22
                rect_x = int(cx) + 12
                rect_y = int(cy) - 24
                if rect_x + tw > w - 10:
                    rect_x = int(cx) - tw - 12
                if rect_y < 10:
                    rect_y = int(cy) + 12

                painter.setBrush(QBrush(QColor("#09101c")))
                painter.setPen(QPen(QColor("#C24A52"), 1))
                painter.drawRoundedRect(rect_x, rect_y, tw, th, 4, 4)

                painter.setPen(QPen(QColor("#ffffff")))
                painter.drawText(rect_x + 8, rect_y + 15, tag_text)

            elif is_hovered:
                painter.setBrush(QBrush(QColor("#D4565E")))
                painter.setPen(QPen(QColor("#ffffff"), 1))
                painter.drawEllipse(QPointF(cx, cy), 6, 6)

                painter.setFont(QFont(FONT_FAMILY, 8))
                painter.setPen(QPen(QColor("#C24A52")))
                painter.drawText(int(cx) + 8, int(cy) + 4, c["city"].split("(")[0].strip())

            else:
                painter.setBrush(QBrush(QColor("#C24A52")))
                painter.setPen(QPen(QColor("#C24A52"), 1))
                painter.drawEllipse(QPointF(cx, cy), 3.5, 3.5)

        if self.custom_target_point:
            clon, clat = self.custom_target_point
            t_x = (clon + 180) * (w / 360.0)
            t_y = (90 - clat) * (h / 180.0)

            painter.setPen(QPen(QColor("#C9A15A"), 1.5, Qt.PenStyle.DashLine))
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.drawEllipse(QPointF(t_x, t_y), 12, 12)
            painter.drawLine(int(t_x - 16), int(t_y), int(t_x + 16), int(t_y))
            painter.drawLine(int(t_x), int(t_y - 16), int(t_x), int(t_y + 16))

        painter.setBrush(QBrush(QColor(10, 16, 28, 220)))
        painter.setPen(QPen(QColor("#1A1A18"), 1))
        painter.drawRect(0, h - 26, w, 26)

        painter.setFont(QFont(FONT_FAMILY, 8, QFont.Weight.Bold))
        painter.setPen(QPen(QColor("#C24A52")))
        hud_info = f"SELECTED: {self.selected_city['city']} ({self.selected_city['zone']}) | LAT: {self.selected_city['lat']}° | LON: {self.selected_city['lon']}° | MIRROR: https://geo.mirror.pkgbuild.com"
        painter.drawText(10, h - 8, hud_info)


class AboutDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("About ArchangelOS")
        self.setFixedSize(480, 400)
        self.setStyleSheet(f"""
            QDialog {{
                background-color: {COLOR_SURFACE};
                border: 1px solid {COLOR_PRIMARY};
            }}
        """)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(16)

        header_box = QHBoxLayout()
        logo_lbl = QLabel()
        if os.path.exists(LOGO_PATH):
            logo_lbl.setPixmap(
                QPixmap(LOGO_PATH).scaled(56, 56, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
            )
        header_box.addWidget(logo_lbl)

        title_box = QVBoxLayout()
        t = QLabel("ArchangelOS")
        t.setFont(QFont(FONT_FAMILY, 20, QFont.Weight.Bold))
        t.setStyleSheet(f"color: {COLOR_PRIMARY};")
        sub = QLabel("Arch-based Cybersecurity Linux Distribution")
        sub.setStyleSheet(f"color: {COLOR_MUTED}; font-size: 11px;")
        title_box.addWidget(t)
        title_box.addWidget(sub)
        header_box.addLayout(title_box)
        header_box.addStretch()
        layout.addLayout(header_box)

        divider = QFrame()
        divider.setFixedHeight(1)
        divider.setStyleSheet(f"background-color: {COLOR_PRIMARY};")
        layout.addWidget(divider)

        body = QLabel()
        body.setTextFormat(Qt.TextFormat.RichText)
        body.setText(DEVELOPER_ABOUT_HTML)
        body.setWordWrap(True)
        body.setOpenExternalLinks(True)
        body.setStyleSheet(f"background-color: {COLOR_BG}; border: 1px solid {COLOR_BORDER}; border-radius: 8px; padding: 16px;")
        layout.addWidget(body, 1)

        close_btn = QPushButton("Close")
        close_btn.setObjectName("PrimaryBtn")
        close_btn.clicked.connect(self.accept)
        layout.addWidget(close_btn)


def apply_glow(widget, color=COLOR_PRIMARY, radius=18, offset=0, alpha=160):
    """Attach a soft neon drop-shadow glow to any widget."""
    effect = QGraphicsDropShadowEffect(widget)
    effect.setBlurRadius(radius)
    effect.setOffset(offset, offset)
    q = QColor(color)
    q.setAlpha(alpha)
    effect.setColor(q)
    widget.setGraphicsEffect(effect)
    return effect


