    def load_wallpaper_paths(self):
        """
        Build the slideshow image list. Explicit filenames (in display order)
        are checked first so the slideshow always includes every named
        wallpaper regardless of glob/extension quirks (e.g. spaces in
        'wall 1080.png', mixed .jpg/.jpeg case). Anything else found in
        WALLPAPERS_DIR via glob is appended afterward, deduplicated.
        """
        named_files = [
            "background.png",
            "wall-4k.png",
            "wall-2k.png",
            "wall 1080.png",
            "splash.png",
            "hoodie.png",
            "hacktheplanet.png",
            "YOR.jpg",
            "blackarch.png",
            "Blue_cyber_theme_wallpaper_ARCHANGELOS_202607261041.jpeg",
            "Cyber_wallpaper_ARCHANGELOS_OS_blue_202607261052.jpeg",
            "Cyber_wallpaper_ARCHANGELOS_OS_theme_202607261055.jpeg",
            "Green_hacker_wallpaper_ARCHANGELOS_OS_202607261052.jpeg",
            "Woman_with_ARCHANGELOS_text_2K_202607261040.jpeg",
        ]

        paths = []
        seen = set()

        for fname in named_files:
            fpath = os.path.join(WALLPAPERS_DIR, fname)
            if os.path.exists(fpath) and fpath not in seen:
                paths.append(fpath)
                seen.add(fpath)

        exts = ('*.png', '*.jpg', '*.jpeg', '*.webp', '*.PNG', '*.JPG', '*.JPEG', '*.WEBP')
        extra = []
        for ext in exts:
            extra.extend(glob.glob(os.path.join(WALLPAPERS_DIR, ext)))
        extra.sort()

        for fpath in extra:
            if fpath not in seen:
                paths.append(fpath)
                seen.add(fpath)

        return paths

    def init_ui(self):
        main_widget = QWidget()
        self.setCentralWidget(main_widget)
        main_h_layout = QHBoxLayout(main_widget)
        main_h_layout.setContentsMargins(0, 0, 0, 0)
        main_h_layout.setSpacing(0)

        sidebar = QFrame()
        sidebar.setObjectName("Sidebar")
        sidebar.setFixedWidth(240)
        sidebar_layout = QVBoxLayout(sidebar)
        sidebar_layout.setContentsMargins(16, 20, 16, 20)

        logo_box = QVBoxLayout()
        logo_box.setSpacing(4)
