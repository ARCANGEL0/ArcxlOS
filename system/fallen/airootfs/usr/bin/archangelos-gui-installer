        boot_lbl.setStyleSheet(f"color: {COLOR_PRIMARY}; font-weight: bold; font-size: 12px; background-color: #161614; padding: 4px 12px; border-radius: 12px; border: 1px solid #1A1A18;")
        header_layout.addWidget(boot_lbl)

