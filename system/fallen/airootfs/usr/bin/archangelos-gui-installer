        self.stacked_widget.addWidget(self.page_credentials)
        self.stacked_widget.addWidget(self.page_summary)
        self.stacked_widget.addWidget(self.page_installing)
        self.stacked_widget.addWidget(self.page_finish)

        self.country_list.currentRowChanged.connect(self.on_country_changed)
