  for p in $AUR_PKGS; do
    pacman -S --noconfirm --needed "$p" >/dev/null 2>&1 \
      || su - "$BUILD_USER" -c "yay -S --noconfirm --needed --answerclean None --answerdiff None $p" >/dev/null 2>&1 \
      && ok "aur $p" || warn "aur $p"
  done
  rm -rf "/home/$BUILD_USER/.cache/yay/"* 2>/dev/null || true
fi

