#!/usr/bin/env bash
# ArchangelOS Fallen - RedOps toolkit installer (GENERATED from verified research).
# Runs at build time from customize_airootfs.sh, inside the chroot.
# Every install is best-effort and non-fatal: a tool that fails is logged and
# skipped so the ISO build always completes. See /var/log/archangelos-redops.log.
set -u
LOG=/var/log/archangelos-redops.log
OPT=/opt/redops
mkdir -p "$OPT"; : > "$LOG"
warn() { printf '[redops][miss] %s\n' "$*" >>"$LOG"; }
ok()   { printf '[redops][ok]   %s\n' "$*" >>"$LOG"; }

BUILD_USER=liveuser
id -u "$BUILD_USER" >/dev/null 2>&1 || BUILD_USER=root

for p in git base-devel python python-pipx python-pip go rust npm nodejs jq curl wget wine; do
  pacman -S --noconfirm --needed "$p" >/dev/null 2>&1 || true
done
export GOBIN=/usr/local/bin GOPATH=$OPT/go PIPX_HOME=$OPT/pipx PIPX_BIN_DIR=/usr/local/bin
mkdir -p "$GOPATH" "$PIPX_HOME"

