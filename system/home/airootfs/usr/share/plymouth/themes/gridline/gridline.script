dkf[948] = 0.326773;
dkf[949] = 0.326773;
dkf[950] = 0.335505;
dkf[951] = 0.344237;
dkf[952] = 0.344237;
dkf[953] = 0.35297;
dkf[954] = 0.361702;
dkf[955] = 0.361702;
dkf[956] = 0.370434;
dkf[957] = 0.379167;
dkf[958] = 0.379167;

bg.image = Image("bg.png").Scale(W, H);
bg.sprite = Sprite(bg.image);
bg.sprite.SetPosition(0, 0, -100);

crt.image = Image("crt.png").Scale(W, H);
crt.sprite = Sprite(crt.image);
crt.sprite.SetPosition(0, 0, 480);

for (i = 0; i < 40; i++) {
  stars[i].sprite = Sprite(Image("star.png").Scale(Math.Int(6 * sy), Math.Int(6 * sy)));
  stars[i].sprite.SetX(stx[i] * W);
  stars[i].sprite.SetY(sty[i] * hor * 0.92);
  stars[i].sprite.SetZ(-9);
  stars[i].sprite.SetOpacity(0.8);
}

glow.image = Image("glow_sun.png").Scale(Math.Int(sun_r * 3.4), Math.Int(sun_r * 3.4));
glow.sprite = Sprite(glow.image);
glow.sprite.SetX(W / 2 - glow.image.GetWidth() / 2);
glow.sprite.SetY(sun_cy - glow.image.GetHeight() / 2);
glow.sprite.SetZ(-8);
glow.sprite.SetOpacity(0.8);

dawn.image = Image("dawn.png").Scale(W, Math.Int(H * 0.12));
dawn.sprite = Sprite(dawn.image);
dawn.sprite.SetPosition(0, hor - Math.Int(H * 0.10), -10);
dawn.sprite.SetOpacity(0.42);

fan.image = Image("gridfan.png").Scale(W, Math.Int(H - hor));
fan.sprite = Sprite(fan.image);
fan.sprite.SetPosition(W / 2 - fan.image.GetWidth() / 2, hor, -9);

for (i = 0; i < 11; i++) {
  hlines[i].sprite = Sprite(Image("gridline_h.png").Scale(W, Math.Int(4 * sy)));
  hlines[i].sprite.SetZ(-8);
  hlines[i].sprite.SetOpacity(0.16);
  hlines[i].frac = i / 11.0;
}

sun.image = Image("sun.png").Scale(Math.Int(sun_r * 2), Math.Int(sun_r * 2));
sun.sprite = Sprite(sun.image);
sun.sprite.SetX(W / 2 - sun.image.GetWidth() / 2);
sun.sprite.SetY(sun_cy - sun.image.GetHeight() / 2);
sun.sprite.SetZ(-7);

for (i = 0; i < 12; i++)
  scan.frames[i] = Image("sunscan_" + i + ".png").Scale(Math.Int(sun_r * 2), Math.Int(sun_r * 2));
scan.sprite = Sprite(scan.frames[0]);
scan.sprite.SetX(W / 2 - scan.frames[0].GetWidth() / 2);
scan.sprite.SetY(sun_cy - scan.frames[0].GetHeight() / 2);
scan.sprite.SetZ(-6);

bar.w = 0;
bar.sprite = Sprite(Image("bar.png").Scale(1, barth));
bar.sprite.SetPosition(Math.Int((W - barlw) / 2), Math.Int(H * 0.90), 500);
bar.sprite.SetOpacity(0);

fun refresh_callback ()
  {
    if (status != "normal")
      return;
    t++;
    idx = Math.Int(t / 35) % 12;
    scan.sprite.SetImage(scan.frames[idx]);
    for (i = 0; i < 40; i++)
      stars[i].sprite.SetOpacity((0.25 + 0.55 * Math.Abs(Math.Sin(t * 0.008 + stp[i]))) * 0.8);
    glow.sprite.SetOpacity(0.7 + 0.3 * Math.Sin(t * 0.0088));
    for (i = 0; i < 11; i++) {
      z = hlines[i].frac + t * 0.0011667;
      z = z - Math.Int(z);
      hlines[i].sprite.SetY(hor + z * z * zp[Math.Int(z * 40)] * (H - hor));
      hlines[i].sprite.SetOpacity(0.16 * Math.Min(1, z * 7));
    }
    dawn.sprite.SetOpacity((0.10 + 0.14 * progress) / 0.24);
  }

fun progress_callback (duration, progress)
  {
    global.progress = progress;
    pw = Math.Int(W * 0.30 * progress);
    if (pw > 0 && pw != bar.w)
      {
        bar.w = pw;
        bar.image = Image("bar.png").Scale(pw, barth);
        bar.sprite.SetImage(bar.image);
        bar.sprite.SetY(Math.Int(H * 0.90));
        bar.sprite.SetOpacity(0.9);
      }
  }

fun quit_callback ()
  {
    scan.sprite.SetImage(scan.frames[0]);
  }

fun dialog_setup ()
  {
    global.dialog.box.image = Image("entrybox.png");
    global.dialog.box.sprite = Sprite(global.dialog.box.image);
    global.dialog.box.x = W / 2 - global.dialog.box.image.GetWidth() / 2;
    global.dialog.box.y = H * 0.86;
    global.dialog.box.sprite.SetPosition(global.dialog.box.x, global.dialog.box.y, 10000);
    global.dialog.bullet_image = Image("bullet.png");
    global.dialog.bullets = 0;
  }

fun dialog_opacity (opacity)
  {
    global.dialog.box.sprite.SetOpacity(opacity);
    for (index = 0; global.dialog.bullet[index]; index++)
      global.dialog.bullet[index].sprite.SetOpacity(opacity);
    if (opacity == 0)
      global.dialog.bullets = 0;
  }

fun display_normal_callback ()
  {
    global.status = "normal";
    if (global.dialog)
      dialog_opacity(0);
  }

fun display_password_callback (prompt, bullets)
  {
    global.status = "password";
    if (!global.dialog)
      dialog_setup();
    else
      dialog_opacity(1);
    for (index = 0; global.dialog.bullet[index] || index < bullets; index++)
      {
        if (!global.dialog.bullet[index])
          {
            global.dialog.bullet[index].sprite = Sprite(global.dialog.bullet_image);
            global.dialog.bullet[index].sprite.SetPosition(global.dialog.box.x + 12 + index * (global.dialog.bullet_image.GetWidth() + 4), global.dialog.box.y + global.dialog.box.image.GetHeight() / 2 - global.dialog.bullet_image.GetHeight() / 2, 10001);
          }
        if (index < bullets)
          global.dialog.bullet[index].sprite.SetOpacity(1);
        else
          global.dialog.bullet[index].sprite.SetOpacity(0);
      }
  }

message.sprite = Sprite();
message.sprite.SetPosition(10, 10, 10000);

fun display_message_callback (text)
  {
    message.sprite.SetImage(Image.Text(text, 0.93, 0.92, 0.89));
    message.sprite.SetOpacity(1);
  }

fun hide_message_callback ()
  {
    message.sprite.SetOpacity(0);
  }

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetQuitFunction(quit_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetRefreshRate(60);

