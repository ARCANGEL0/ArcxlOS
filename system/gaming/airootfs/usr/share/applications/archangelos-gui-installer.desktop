[Desktop Entry]
Type=Application
Version=1.0
Name=Install ArchangelOS (GUI)
Comment=Standalone 100% Offline Graphical Installer for ArchangelOS Linux
Exec=sh -c 'exec sudo env QT_QPA_PLATFORM=wayland WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" /usr/bin/archangelos-gui-installer'
Icon=/usr/share/sddm/themes/archangelos/assets/logo.png
Terminal=false
Categories=System;
StartupNotify=true
