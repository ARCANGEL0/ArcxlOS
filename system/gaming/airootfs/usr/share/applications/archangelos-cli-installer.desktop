[Desktop Entry]
Type=Application
Version=1.0
Name=Install ArchangelOS (CLI Terminal)
Comment=Command Line Automated Terminal System Installer for ArchangelOS Linux
Exec=sudo /usr/bin/archangelos-installer --cli
Icon=/usr/share/sddm/themes/archangelos/assets/logo.png
Terminal=true
Categories=System;
StartupNotify=true
