# Normalize line endings: let Git decide text vs binary, LF in the repo.
* text=auto eol=lf

# Scripts and configs are always text with LF (they run in Linux images).
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.qml       text eol=lf
*.conf      text eol=lf
*.desktop   text eol=lf
*.service   text eol=lf
*.rules     text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.frag      text eol=lf
*.vert      text eol=lf
profiledef.sh   text eol=lf
packages.x86_64 text eol=lf
VERSION     text eol=lf
LICENSE     text eol=lf
NOTICE      text eol=lf

# Executables shipped without an extension (installer, launcher, wrappers).
airootfs/usr/bin/*      text eol=lf
airootfs/usr/local/bin/* text eol=lf

# Binary assets — never touch line endings, and skip diffing.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.mp4    binary
*.mkv    binary
*.webm   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.zst    binary
*.gz     binary
*.xz     binary
*.zip    binary
*.iso    binary
*.img    binary

# Keep large media / release artifacts out of language stats.
assets/**      linguist-vendored
release/**     linguist-generated
docs/**        linguist-documentation
